# --- Database ---
DATABASE_URL=postgresql://dcontact:dcontact@localhost:5433/dcontact?schema=public

# --- Kafka (event backbone — dev ใช้ Redpanda) ---
KAFKA_BROKERS=localhost:9092

# --- Redis (state store เท่านั้น ไม่ใช่ event bus — ดู ADR-003) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
KEYCLOAK_ISSUER=http://localhost:8081/realms/dcontact
KEYCLOAK_JWKS_URI=http://localhost:8081/realms/dcontact/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=dcontact-api
VITE_KC_ISSUER=http://localhost:8081/realms/dcontact
VITE_KC_CLIENT_ID=agent-desktop
VITE_API_BASE_URL=http://localhost:3000
WORKSPACE_ORIGIN=http://localhost:5173
# tenant ไม่ผูก node; provider กระจาย lease ไปตามรายการนี้แบบ round-robin
# local development ใช้ SIP over WebSocket ที่ FreeSWITCH เปิดให้บน :5066
SIP_BROWSER_NODES_JSON='[{"telephonyNodeId":"fs-local","wssUrl":"ws://localhost:5066"}]'
FREESWITCH_DIRECTORY_PASSWORD=dcontact-xml-curl-dev-only
SIP_ICE_SERVERS_JSON='[]'

# ใช้เฉพาะ local provisioning/readiness; production ต้องรับจาก secret manager
KEYCLOAK_ADMIN_URL=http://localhost:8081
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=admin
# AC2 (#595): service account ของ self-service บัญชี — ค่า dev ตรงกับ scripts/keycloak-account-service-setup.mjs
KEYCLOAK_ACCOUNT_SERVICE_SECRET=dcontact-account-service-dev-secret
# AC4 (#597): key เข้ารหัส TOTP secret ที่ยังไม่ยืนยัน (base64 ของ 32 bytes) — ค่า dev เท่านั้น
ACCOUNT_SECRET_KEY=ZGNvbnRhY3QtZGV2LWFjY291bnQtc2VjcmV0LWtleSE=

# --- FreeSWITCH ESL ---
FREESWITCH_ESL_HOST=localhost
FREESWITCH_ESL_PORT=8022
FS_ESL_PASSWORD=ClueCon

# --- Object storage (S3 API, ADR-029) ---
# แอปทุกตัวอ่าน S3_* ชุดนี้; MINIO_* และ RECORDINGS_BUCKET/GOVERNANCE_EXPORTS_BUCKET/UAT_EVIDENCE_BUCKET
# ยังอ่านได้ช่วงเปลี่ยนผ่าน (log เตือน deprecated) — production ต้องตั้ง endpoint/credential เอง ไม่มีค่า default
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=dcontact
S3_SECRET_KEY=dcontact-secret
S3_FORCE_PATH_STYLE=true
S3_BUCKET_RECORDINGS=recordings
S3_BUCKET_GOVERNANCE_EXPORTS=governance-exports
S3_BUCKET_UAT_EVIDENCE=uat-evidence
FREESWITCH_RECORDINGS_DIR=/var/lib/freeswitch/recordings
FREESWITCH_RECORDINGS_HOST_DIR=infra/docker/data/freeswitch-recordings

# --- QM worker (ใช้ endpoint TLS จริง; ห้ามส่ง media/transcript ผ่าน HTTP) ---
# credential และ bucket ใช้ S3_* ด้านบน (process ของ QM ต้องตั้งเองเสมอ); QM_MEDIA_ENDPOINT override endpoint เฉพาะ QM
QM_MEDIA_ENDPOINT=https://object-storage.example.internal
QM_TRANSCRIPTION_PROVIDER_ID=deployment-asr
QM_TRANSCRIPTION_ENDPOINT=https://asr.example.internal/transcribe
QM_TRANSCRIPTION_API_KEY=replace-from-secret-manager
# ถ้าไม่ตั้ง QM_SCORING_ENDPOINT จะถอดเสียงได้ แต่ไม่สร้าง auto-QM draft
QM_SCORING_PROVIDER_ID=deployment-scorer
QM_SCORING_ENDPOINT=https://scoring.example.internal/score
QM_SCORING_MODEL_ID=replace-with-versioned-model
QM_SCORING_PROMPT_VERSION=replace-with-versioned-prompt
QM_SCORING_API_KEY=replace-from-secret-manager

# S2.5 (#369): singleton binding ของ LINE webhook — ค่าจริงมาจาก deployment config/keychain
# channel secret และ payload key ห้าม commit ค่าจริงลง repo
LINE_WEBHOOK_TENANT_ID=00000000-0000-4000-8000-000000000000
LINE_WEBHOOK_CHANNEL_ACCOUNT_ID=2007056595
LINE_WEBHOOK_DESTINATION=U0000000000000000000000000000000
# secret/payload key อยู่ใน macOS Keychain เท่านั้น (#362 §9): disabled = สุ่มในหน่วยความจำ route ตอบ 401 ทุก request
LINE_WEBHOOK_SECRET_SOURCE=disabled
LINE_WEBHOOK_PAYLOAD_KEY_REF=d-contact.line.webhook-payload/v1

# --- AC3 (#596): email บัญชีของ D-Contact (dev ส่งเข้า mailpit) ---
# ชื่อผู้ส่งเป็น "D-Contact" เสมอ — SMTP_FROM ใส่แค่ที่อยู่ก็ได้; ไม่ตั้ง SMTP_HOST = ไม่เปิดตัวส่ง
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@dcontact.local
SMTP_HELO=dcontact.local
# ลิงก์ในอีเมลชี้หน้า "บัญชีของฉัน" ของ Console (https เท่านั้น ยกเว้น localhost)
CONSOLE_PUBLIC_URL=http://localhost:5173
