# --- Database ---
DATABASE_URL=postgresql://dcontact:dcontact@localhost:5433/dcontact?schema=public

# --- Kafka (event backbone — dev ใช้ Redpanda) ---
KAFKA_BROKERS=localhost:9092

# --- Redis (state store เท่านั้น ไม่ใช่ event bus — ดู ADR-003) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
KEYCLOAK_ISSUER=http://localhost:8081/realms/dcontact
KEYCLOAK_JWKS_URI=http://localhost:8081/realms/dcontact/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=dcontact-api
VITE_KC_ISSUER=http://localhost:8081/realms/dcontact
VITE_KC_CLIENT_ID=agent-desktop
VITE_API_BASE_URL=http://localhost:3000
WORKSPACE_ORIGIN=http://localhost:5173
# tenant ไม่ผูก node; provider กระจาย lease ไปตามรายการนี้แบบ round-robin
# local development ใช้ SIP over WebSocket ที่ FreeSWITCH เปิดให้บน :5066
SIP_BROWSER_NODES_JSON='[{"telephonyNodeId":"fs-local","wssUrl":"ws://localhost:5066"}]'
SIP_ICE_SERVERS_JSON='[]'

# ใช้เฉพาะ local provisioning/readiness; production ต้องรับจาก secret manager
KEYCLOAK_ADMIN_URL=http://localhost:8081
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=admin

# --- FreeSWITCH ESL ---
FS_ESL_HOST=localhost
FS_ESL_PORT=8021
FS_ESL_PASSWORD=ClueCon

# --- Object storage (MinIO in dev) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=dcontact
S3_SECRET_KEY=dcontact-secret
S3_BUCKET_RECORDINGS=recordings
FREESWITCH_RECORDINGS_DIR=/var/lib/freeswitch/recordings
FREESWITCH_RECORDINGS_HOST_DIR=infra/docker/data/freeswitch-recordings

# --- QM worker (ใช้ endpoint TLS จริง; ห้ามส่ง media/transcript ผ่าน HTTP) ---
QM_MEDIA_ENDPOINT=https://minio.example.internal
MINIO_ACCESS_KEY=replace-from-secret-manager
MINIO_SECRET_KEY=replace-from-secret-manager
RECORDINGS_BUCKET=recordings
QM_TRANSCRIPTION_PROVIDER_ID=deployment-asr
QM_TRANSCRIPTION_ENDPOINT=https://asr.example.internal/transcribe
QM_TRANSCRIPTION_API_KEY=replace-from-secret-manager
# ถ้าไม่ตั้ง QM_SCORING_ENDPOINT จะถอดเสียงได้ แต่ไม่สร้าง auto-QM draft
QM_SCORING_PROVIDER_ID=deployment-scorer
QM_SCORING_ENDPOINT=https://scoring.example.internal/score
QM_SCORING_MODEL_ID=replace-with-versioned-model
QM_SCORING_PROMPT_VERSION=replace-with-versioned-prompt
QM_SCORING_API_KEY=replace-from-secret-manager
