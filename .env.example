# --- Database ---
DATABASE_URL=postgresql://dcontact:dcontact@localhost:5433/dcontact?schema=public

# --- Kafka (event backbone; dev uses Redpanda) ---
KAFKA_BROKERS=localhost:9092

# --- Redis (state store only, not an event bus; see ADR-003) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
KEYCLOAK_ISSUER=http://localhost:8081/realms/dcontact
KEYCLOAK_JWKS_URI=http://localhost:8081/realms/dcontact/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=dcontact-api
# Cus360 Workspace (#916): confidential client for introspection, present in the aud of agent-desktop tokens
# Dev values match infra/keycloak/realm-dcontact.dev.json (local dev only). Leave both empty to turn off the customer panel in Workspace
KEYCLOAK_C360_CLIENT_ID=dcontact-c360-introspection-dev
KEYCLOAK_C360_CLIENT_SECRET=dcontact-c360-introspection-dev-secret
# External customer API (#954): on = service principals can create/read/search customers (default off)
# create uses the confidential client above to introspect the service token; see docs/external-customer-api.md
C360_SERVICE_API=off
VITE_KC_ISSUER=http://localhost:8081/realms/dcontact
VITE_KC_CLIENT_ID=agent-desktop
VITE_API_BASE_URL=http://localhost:3000
# opt-in: external-simulator tries Workspace controls without SIP/audio
# VITE_SOFTPHONE_CONTROL=external-simulator
# opt-in: the D-Phone Chrome extension owns the audio
# D_PHONE_WORKSPACE_ORIGIN=http://localhost:5173
# VITE_SOFTPHONE_CONTROL=chrome-extension
# VITE_D_PHONE_EXTENSION_ID=<ID from chrome://extensions>
WORKSPACE_ORIGIN=http://localhost:5173
# Tenants are not pinned to a node; the provider spreads leases across this list round-robin
# Local development uses SIP over WebSocket, which FreeSWITCH serves on :5066
SIP_BROWSER_NODES_JSON='[{"telephonyNodeId":"fs-local","wssUrl":"ws://localhost:5066"}]'
FREESWITCH_DIRECTORY_PASSWORD=dcontact-xml-curl-dev-only
SIP_ICE_SERVERS_JSON='[]'

# Local provisioning/readiness only; production must get this from a secret manager
KEYCLOAK_ADMIN_URL=http://localhost:8081
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=admin
# AC2 (#595): service account for account self-service; dev values match scripts/keycloak-account-service-setup.mjs
KEYCLOAK_ACCOUNT_SERVICE_SECRET=dcontact-account-service-dev-secret
# AC4 (#597): key that encrypts unconfirmed TOTP secrets (base64 of 32 bytes); dev value only
ACCOUNT_SECRET_KEY=ZGNvbnRhY3QtZGV2LWFjY291bnQtc2VjcmV0LWtleSE=

# --- FreeSWITCH ESL ---
FREESWITCH_ESL_HOST=localhost
FREESWITCH_ESL_PORT=8022
FS_ESL_PASSWORD=ClueCon

# --- Object storage (S3 API, ADR-029) ---
# Every app reads this S3_* set; MINIO_* and RECORDINGS_BUCKET/GOVERNANCE_EXPORTS_BUCKET/UAT_EVIDENCE_BUCKET
# are still read during the transition (with a deprecation warning). Production must set the endpoint/credentials; there are no defaults
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=dcontact
S3_SECRET_KEY=dcontact-secret
S3_FORCE_PATH_STYLE=true
S3_BUCKET_RECORDINGS=recordings
S3_BUCKET_GOVERNANCE_EXPORTS=governance-exports
S3_BUCKET_UAT_EVIDENCE=uat-evidence
# #967: on = Supervisors play team recordings through the API with a permission check per chunk, and the old presign route is closed
RECORDING_SUPERVISOR_PLAYBACK=off
# #971: on = Admins build evaluation forms, Supervisors evaluate their team's calls, and Agents see their own scores
QM_HUMAN_EVALUATION=off
# #1044: on = web chat (widget, Agent chats in Workspace, settings in Console); a tenant still enables its own widget
WEBCHAT=off
FREESWITCH_RECORDINGS_DIR=/var/lib/freeswitch/recordings
FREESWITCH_RECORDINGS_HOST_DIR=infra/docker/data/freeswitch-recordings

# --- QM worker (use real TLS endpoints; never send media/transcripts over HTTP) ---
# Credentials and bucket come from S3_* above (the QM process must always set them); QM_MEDIA_ENDPOINT overrides the endpoint for QM only
QM_MEDIA_ENDPOINT=https://object-storage.example.internal
QM_TRANSCRIPTION_PROVIDER_ID=deployment-asr
QM_TRANSCRIPTION_ENDPOINT=https://asr.example.internal/transcribe
QM_TRANSCRIPTION_API_KEY=replace-from-secret-manager
# Provider wait per request (ms), default 300000; providers speak docs/qm-asr-provider-protocol.md
QM_TRANSCRIPTION_TIMEOUT_MS=300000
# Without QM_SCORING_ENDPOINT, transcription works but no auto-QM draft is created
QM_SCORING_PROVIDER_ID=deployment-scorer
QM_SCORING_ENDPOINT=https://scoring.example.internal/score
QM_SCORING_MODEL_ID=replace-with-versioned-model
QM_SCORING_PROMPT_VERSION=replace-with-versioned-prompt
QM_SCORING_API_KEY=replace-from-secret-manager
# Scorer wait per request (ms), default 120000
QM_SCORING_TIMEOUT_MS=120000

# S2.5 (#369): singleton binding for the LINE webhook; real values come from deployment config/keychain
# Never commit the real channel secret or payload key to the repo
LINE_WEBHOOK_TENANT_ID=00000000-0000-4000-8000-000000000000
LINE_WEBHOOK_CHANNEL_ACCOUNT_ID=2007056595
LINE_WEBHOOK_DESTINATION=U0000000000000000000000000000000
# The secret/payload key live only in the macOS Keychain (#362 §9): disabled = random in memory, the route answers 401 to every request
LINE_WEBHOOK_SECRET_SOURCE=disabled
LINE_WEBHOOK_PAYLOAD_KEY_REF=d-contact.line.webhook-payload/v1

# --- AC3 (#596): D-Contact account email (dev sends to mailpit) ---
# The sender name is always "D-Contact", so SMTP_FROM can be just the address; no SMTP_HOST = sending is off
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@dcontact.local
SMTP_HELO=dcontact.local
# Email links point to the Console "My account" page (https only, except localhost)
CONSOLE_PUBLIC_URL=http://localhost:5173
