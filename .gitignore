dist-preview/
dist-launcher/

# CI evidence of the Core Settings foundation (attach an immutable artifact instead of committing)
artifacts/core-settings/

# Unpacked D-Phone extension build
dist-dphone-extension/

# files generated by mockup/deck work and local trial/playwright results (not source)
/output/
mockups/output/
