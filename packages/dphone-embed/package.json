{
  "name": "@d-contact/dphone-embed",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./launcher": {
      "types": "./dist/launcher.d.ts",
      "default": "./dist/launcher.js"
    },
    "./schema/v1.json": "./schema/v1.json",
    "./releases/*": "./releases/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "releases"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test src/*.test.ts && node --test scripts/*.test.mjs",
    "build:launcher": "vite build --config vite.launcher.config.ts",
    "launcher:release": "pnpm build:launcher && node scripts/launcher-releases.mjs release",
    "launcher:alias": "node scripts/launcher-releases.mjs alias",
    "launcher:check": "node scripts/launcher-releases.mjs check"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ajv": "8.20.0",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4",
    "vite": "6.4.3"
  }
}
