{
  "name": "@d-contact/contact-points",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime-manifest": {
      "types": "./dist/runtime-manifest.d.ts",
      "default": "./dist/runtime-manifest.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "email-addresses": "5.0.0",
    "libphonenumber-js": "1.13.15",
    "tr46": "5.1.1",
    "unicode-case-folding": "1.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4"
  }
}
