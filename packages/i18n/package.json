{
  "name": "@d-contact/i18n",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "bin": {
    "dc-i18n-check": "scripts/check-catalogs.mjs",
    "dc-i18n-literals": "scripts/check-literals.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*.test.ts && node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "i18next": "26.4.2",
    "react-i18next": "17.0.15",
    "typescript": "^5.5.4"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "19.2.18",
    "react": "19.2.8",
    "tsx": "^4.23.1"
  }
}
