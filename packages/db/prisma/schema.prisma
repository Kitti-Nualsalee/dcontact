generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin", "darwin-arm64"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Tenancy & Users ───────────────────────────

model Tenant {
  id                        String                  @id @default(uuid()) @db.Uuid
  name                      String
  slug                      String                  @unique
  sipDomain                 String                  @unique @map("sip_domain")
  defaultOfferTimeoutSec    Int                     @default(20) @map("default_offer_timeout_sec")
  defaultOfferTimeoutAction QueueOfferTimeoutAction @default(COOLDOWN_REQUEUE) @map("default_offer_timeout_action")
  defaultOfferCooldownSec   Int                     @default(60) @map("default_offer_cooldown_sec")
  defaultMaxWaitSec         Int?                    @map("default_max_wait_sec")
  defaultMaxWaitAction      QueueMaxWaitAction      @default(VOICEMAIL) @map("default_max_wait_action")
  createdAt                 DateTime                @default(now()) @map("created_at")

  users                        User[]
  teams                        Team[]
  queues                       Queue[]
  voiceDestinations            VoiceDestination[]
  queueAuditEvents             QueueAuditEvent[]
  skills                       Skill[]
  contacts                     Contact[]
  interactions                 Interaction[]
  conversations                Conversation[]
  qmTranscriptionJobs          QmTranscriptionJob[]
  qmAuditEvents                QmAuditEvent[]
  qmTranscripts                QmTranscript[]
  qmEvaluations                QmEvaluation[]
  qmConsoleContexts            QmConsoleContext[]
  commandReceipts              CommandReceipt[]
  cgRestrictions               CgRestriction[]
  cgConsents                   CgConsent[]
  cgDecisionLogs               CgDecisionLog[]
  cgReservations               CgReservation[]
  cgReservationCommandReceipts CgReservationCommandReceipt[]
  cgAttempts                   CgAttempt[]
  cgTouches                    CgTouch[]
  cgPreferences                CgPreference[]
  cgPolicies                   CgPolicy[]
  cgHolidayCalendarEntries     CgHolidayCalendarEntry[]
  cgCallbackRequests           CgCallbackRequest[]
  cgContactStateHeads          CgContactStateHead[]
  cgEventOutbox                CgEventOutbox[]
  cgCommandReceipts            CgCommandReceipt[]
  cgAuditLogs                  CgAuditLog[]
  cgConsumerAcknowledgements   CgConsumerAcknowledgement[]
  cgConsumerInbox              CgConsumerInbox[]
  cgScopePauses                CgScopePause[]
  cg4AuthorizationSubjects     Cg4AuthorizationSubject[]
  cg4CapabilityGrants          Cg4CapabilityGrant[]
  jrEventInbox                 JrEventInbox[]
  jrKafkaConsumerInbox         JrKafkaConsumerInbox[]
  jrGovernanceConsumerInbox    JrGovernanceConsumerInbox[]
  jrIamScopeInvalidationInbox  JrIamScopeInvalidationInbox[]
  jrGovernanceAcknowledgements JrGovernanceAcknowledgementOutbox[]
  jrGovernanceEffects          JrGovernanceEffectOutbox[]
  jrActionLifecycleInbox       JrActionLifecycleInbox[]
  jrEnrollments                JrEnrollment[]
  jrActions                    JrAction[]
  jrJourneyDefinitions         JrJourneyDefinition[]
  dlOutboxEntries              DlOutboxEntry[]
  jrScheduleOccurrences        JrScheduleOccurrence[]
  jrStepRuns                   JrStepRun[]
  jrOutcomeReceipts            JrOutcomeReceipt[]
  jrOutcomeHeads               JrOutcomeHead[]
  jrOwnerActions               JrOwnerAction[]
  jrOwnerCommandOutbox         JrOwnerCommandOutbox[]
  jrOwnerResultInbox           JrOwnerResultInbox[]
  jrRecoveryAudit              JrRecoveryAudit[]
  csCaseTypePolicies           CsCaseTypePolicy[]
  csRoutingPolicies            CsRoutingPolicy[]
  csCases                      CsCase[]
  csCaseLinks                  CsCaseLink[]
  csCaseActivities             CsCaseActivity[]
  csCommandInbox               CsCommandInbox[]
  obCampaigns                  ObCampaign[]
  obCampaignAdmissionPolicies  ObCampaignAdmissionPolicy[]
  obCampaignTargets            ObCampaignTarget[]
  obDialerCommandInbox         ObDialerCommandInbox[]
  obCallbacks                  ObCallback[]
  obAttempts                   ObAttempt[]
  obGovernanceConsumerInbox    ObGovernanceConsumerInbox[]
  obGovernanceAcknowledgements ObGovernanceAcknowledgementOutbox[]
  obGovernanceEffects          ObGovernanceEffectOutbox[]
  c360SegmentDefinitions       C360SegmentDefinition[]
  c360SegmentDefinitionHeads   C360SegmentDefinitionHead[]
  c360FactSnapshots            C360FactSnapshot[]
  c360SegmentEvaluations       C360SegmentEvaluation[]
  c360SegmentMembershipHeads   C360SegmentMembershipHead[]
  c360SegmentMembershipChanges C360SegmentMembershipChange[]
  c360SegmentMembershipOutbox  C360SegmentMembershipOutbox[]
  c360SegmentEvidence          C360SegmentEvidence[]
  c360EvidenceAccessAudit      C360EvidenceAccessAudit[]
  c360MembershipReceipts       C360MembershipCommandReceipt[]
  c360MembershipQuarantine     C360MembershipQuarantine[]
  c360IdentityHeads            C360IdentityHead[]
  c360IdentityLineage          C360IdentityLineage[]
  jrSegmentReceipts            JrSegmentReceipt[]
  jrSegmentHeads               JrSegmentHead[]
  jrSegmentEnrollmentIntents   JrSegmentEnrollmentIntent[]
  jrSegmentRefilterCursors     JrSegmentRefilterCursor[]
  jrSegmentOutbox              JrSegmentOutbox[]
  jrSegmentRollout             JrSegmentRolloutState?
  jrSegmentShadowMismatches    JrSegmentShadowMismatch[]

  @@map("tenants")
}

enum UserRole {
  AGENT
  SUPERVISOR
  ADMIN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  keycloakId   String?  @unique @map("keycloak_id") @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  role         UserRole @default(AGENT)
  // SIP extension สำหรับ softphone (agent เท่านั้น)
  extension    String?
  sipPassword  String?  @map("sip_password")
  teamId       String?  @map("team_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  team         Team?           @relation(fields: [teamId], references: [id])
  skills       AgentSkill[]
  stateLogs    AgentStateLog[]
  interactions Interaction[]

  @@unique([tenantId, email])
  @@unique([tenantId, extension])
  @@index([tenantId])
  @@map("users")
}

model Team {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  name     String
  isActive Boolean @default(true) @map("is_active")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  members User[]
  queues  Queue[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@map("teams")
}

// ─────────────────────────── Routing: Queues & Skills ───────────────────────────

enum ChannelType {
  VOICE
  WEBCHAT
  LINE
  FACEBOOK
  WHATSAPP
  EMAIL
}

enum QueueOfferTimeoutAction {
  IMMEDIATE_REQUEUE
  COOLDOWN_REQUEUE
  ABANDON
}

enum QueueMaxWaitAction {
  WAIT
  CALLBACK
  VOICEMAIL
}

enum QueueRoutingStrategy {
  LONGEST_AVAILABLE_IDLE
  LONGEST_SINCE_LAST_INTERACTION
  ROUND_ROBIN
}

enum QueueTranscriptionMode {
  OFF
  AUTOMATIC
  MANUAL
}

model Queue {
  id                            String                   @id @default(uuid()) @db.Uuid
  tenantId                      String                   @map("tenant_id") @db.Uuid
  name                          String
  // universal queue: รองรับหลาย channel ใน queue เดียว
  channels                      ChannelType[]
  slaThresholdSec               Int                      @default(20) @map("sla_threshold_sec")
  maxWaitSec                    Int?                     @map("max_wait_sec")
  offerTimeoutSec               Int?                     @map("offer_timeout_sec")
  offerTimeoutAction            QueueOfferTimeoutAction? @map("offer_timeout_action")
  offerCooldownSec              Int?                     @map("offer_cooldown_sec")
  maxWaitAction                 QueueMaxWaitAction?      @map("max_wait_action")
  routingStrategy               QueueRoutingStrategy     @default(LONGEST_AVAILABLE_IDLE) @map("routing_strategy")
  priority                      Int                      @default(0)
  teamId                        String?                  @map("team_id") @db.Uuid
  isActive                      Boolean                  @default(true) @map("is_active")
  recordingEnabled              Boolean                  @default(false) @map("recording_enabled")
  recordingAnnouncement         String?                  @map("recording_announcement")
  recordingAnnouncementLanguage String?                  @map("recording_announcement_language")
  recordingPauseResumeEnabled   Boolean                  @default(false) @map("recording_pause_resume_enabled")
  recordingAgentSelfAccess      Boolean                  @default(false) @map("recording_agent_self_access")
  recordingDownloadAllowed      Boolean                  @default(false) @map("recording_download_allowed")
  recordingRetentionDays        Int?                     @map("recording_retention_days")
  recordingChannelLayout        RecordingChannelLayout   @default(STEREO) @map("recording_channel_layout")
  transcriptionMode             QueueTranscriptionMode   @default(OFF) @map("transcription_mode")
  transcriptionLanguage         String                   @default("th-TH") @map("transcription_language")
  transcriptionMaxAttempts      Int                      @default(3) @map("transcription_max_attempts")
  autoQmEnabled                 Boolean                  @default(false) @map("auto_qm_enabled")
  createdAt                     DateTime                 @default(now()) @map("created_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  team              Team?              @relation(fields: [teamId], references: [id])
  skills            QueueSkill[]
  interactions      Interaction[]
  voiceDestinations VoiceDestination[]
  auditEvents       QueueAuditEvent[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, teamId])
  @@map("queues")
}

enum VoiceDestinationEntryMode {
  DIRECT_QUEUE
  IVR
}

model VoiceDestination {
  id          String                    @id @default(uuid()) @db.Uuid
  tenantId    String                    @map("tenant_id") @db.Uuid
  destination String
  entryMode   VoiceDestinationEntryMode @default(DIRECT_QUEUE) @map("entry_mode")
  queueId     String                    @map("queue_id") @db.Uuid
  ivrConfig   Json?                     @map("ivr_config")
  isActive    Boolean                   @default(true) @map("is_active")
  createdAt   DateTime                  @default(now()) @map("created_at")
  updatedAt   DateTime                  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  queue  Queue  @relation(fields: [tenantId, queueId], references: [tenantId, id])

  @@unique([tenantId, destination])
  @@index([tenantId, queueId])
  @@map("voice_destinations")
}

enum QueueAuditAction {
  QUEUE_CREATED
  QUEUE_UPDATED
  QUEUE_ENABLED
  QUEUE_DISABLED
  DIRECT_DESTINATION_SET
}

model QueueAuditEvent {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  queueId     String           @map("queue_id") @db.Uuid
  actorUserId String           @map("actor_user_id") @db.Uuid
  action      QueueAuditAction
  details     Json
  createdAt   DateTime         @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  queue  Queue  @relation(fields: [tenantId, queueId], references: [tenantId, id])

  @@index([tenantId, createdAt])
  @@index([tenantId, queueId, createdAt])
  @@map("queue_audit_events")
}

model Skill {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name     String

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  agents AgentSkill[]
  queues QueueSkill[]

  @@unique([tenantId, name])
  @@map("skills")
}

model AgentSkill {
  userId  String @map("user_id") @db.Uuid
  skillId String @map("skill_id") @db.Uuid
  level   Int    @default(1) // 1-5

  user  User  @relation(fields: [userId], references: [id])
  skill Skill @relation(fields: [skillId], references: [id])

  @@id([userId, skillId])
  @@map("agent_skills")
}

model QueueSkill {
  queueId  String @map("queue_id") @db.Uuid
  skillId  String @map("skill_id") @db.Uuid
  minLevel Int    @default(1) @map("min_level")

  queue Queue @relation(fields: [queueId], references: [id])
  skill Skill @relation(fields: [skillId], references: [id])

  @@id([queueId, skillId])
  @@map("queue_skills")
}

// ─────────────────────────── Agent State ───────────────────────────

enum AgentStateType {
  OFFLINE
  AVAILABLE
  RESERVED
  BUSY
  ACW
  BREAK
}

// append-only log ของทุกการเปลี่ยน state — ใช้ทำ reporting (occupancy, adherence)
model AgentStateLog {
  id          BigInt         @id @default(autoincrement())
  tenantId    String         @map("tenant_id") @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  state       AgentStateType
  reason      String?
  actorUserId String?        @map("actor_user_id") @db.Uuid
  startedAt   DateTime       @default(now()) @map("started_at")
  endedAt     DateTime?      @map("ended_at")

  user User @relation(fields: [userId], references: [id])

  @@index([tenantId, userId, startedAt])
  @@map("agent_state_logs")
}

// ─────────────────────────── Contacts (customer identity) ───────────────────────────

enum IdentityType {
  PHONE
  LINE
  FACEBOOK
  WHATSAPP
  EMAIL
  WEB
}

model Contact {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant                 Tenant                        @relation(fields: [tenantId], references: [id])
  identities             ContactIdentity[]
  interactions           Interaction[]
  conversations          Conversation[]
  csCases                CsCase[]
  cgRestrictions         CgRestriction[]
  cgConsents             CgConsent[]
  cgDecisionLogs         CgDecisionLog[]
  cgReservations         CgReservation[]
  cgAttempts             CgAttempt[]
  cgTouches              CgTouch[]
  cgPreferences          CgPreference[]
  cgCallbacks            CgCallbackRequest[]
  cgStateHead            CgContactStateHead?
  jrEnrollments          JrEnrollment[]
  jrActions              JrAction[]
  obAttempts             ObAttempt[]
  obCampaignTargets      ObCampaignTarget[]
  obCallbacks            ObCallback[]
  c360FactSnapshots      C360FactSnapshot[]
  c360MembershipHeads    C360SegmentMembershipHead[]
  c360MembershipChanges  C360SegmentMembershipChange[]
  c360SegmentEvidence    C360SegmentEvidence[]
  c360IdentitySubjects   C360IdentityHead[]            @relation("C360IdentitySubject")
  c360IdentityCanonicals C360IdentityHead[]            @relation("C360IdentityCanonical")
  c360LineageSources     C360IdentityLineage[]         @relation("C360LineageSource")
  c360LineageTargets     C360IdentityLineage[]         @relation("C360LineageTarget")
  jrSegmentReceipts      JrSegmentReceipt[]
  jrSegmentHeads         JrSegmentHead[]
  jrSegmentIntents       JrSegmentEnrollmentIntent[]
  jrSegmentRefilters     JrSegmentRefilterCursor[]
  jrSegmentShadow        JrSegmentShadowMismatch[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("contacts")
}

// รวม identity หลาย channel เป็น contact เดียว (เบอร์โทร + LINE ID + email = คนเดียวกัน)
model ContactIdentity {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  contactId String       @map("contact_id") @db.Uuid
  type      IdentityType
  value     String // เบอร์โทร / LINE user id / email ฯลฯ

  contact        Contact             @relation(fields: [contactId], references: [id])
  cgRestrictions CgRestriction[]
  cgConsents     CgConsent[]
  cgDecisionLogs CgDecisionLog[]
  cgReservations CgReservation[]
  cgAttempts     CgAttempt[]
  cgTouches      CgTouch[]
  cgPreferences  CgPreference[]
  cgCallbacks    CgCallbackRequest[]
  jrActions      JrAction[]
  obAttempts     ObAttempt[]

  @@unique([tenantId, id])
  @@unique([tenantId, type, value])
  @@map("contact_identities")
}

// ─────────────────────────── Customer 360 segment evaluator ───────────────────────────

enum C360SegmentDefinitionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum C360SegmentEvaluationOutcome {
  MATCH
  NO_MATCH
  ERROR
}

enum C360SegmentMembershipState {
  IN
  OUT
  INVALIDATED
}

enum C360SegmentMembershipChangeKind {
  ENTERED
  LEFT
  CORRECTED
  REFILTER_REQUIRED
  IDENTITY_INVALIDATED
}

enum C360SegmentMembershipOutboxState {
  PENDING
  PUBLISHED
  FAILED
  /// J3.3 remediation: payload เสียถาวร (validate/hash/envelope ไม่ผ่าน) retry ไปก็ไม่ช่วย
  /// — terminal state ที่ต้องให้คนเข้ามาดู ไม่ใช่วนอยู่ในคิวเงียบ ๆ
  QUARANTINED
}

enum C360MembershipCommandStatus {
  TRANSITIONED
  NO_CHANGE
  DUPLICATE_NO_OP
  QUARANTINED
}

enum C360IdentityState {
  ACTIVE
  MERGED
  AMBIGUOUS
}

enum C360IdentityOperation {
  MERGE
  SPLIT
  UNMERGE
}

/// J3.2: immutable version ของ segment definition; เป็นนิยาม DC_EXPR ไม่ใช่ member list
model C360SegmentDefinition {
  id               String                      @id @default(uuid()) @db.Uuid
  tenantId         String                      @map("tenant_id") @db.Uuid
  segmentId        String                      @map("segment_id")
  version          Int
  status           C360SegmentDefinitionStatus @default(DRAFT)
  definition       Json
  contentDigest    String                      @map("content_digest") @db.Char(64)
  evaluatorVersion String                      @map("evaluator_version")
  correlationId    String                      @map("correlation_id")
  effectiveFrom    DateTime?                   @map("effective_from")
  effectiveTo      DateTime?                   @map("effective_to")
  publishedAt      DateTime?                   @map("published_at")
  createdAt        DateTime                    @default(now()) @map("created_at")

  tenant            Tenant                        @relation(fields: [tenantId], references: [id])
  heads             C360SegmentDefinitionHead[]
  evaluations       C360SegmentEvaluation[]
  membershipHeads   C360SegmentMembershipHead[]
  membershipChanges C360SegmentMembershipChange[]

  @@unique([tenantId, id])
  @@unique([tenantId, segmentId, version])
  @@index([tenantId, segmentId, status, version(sort: Desc)])
  @@map("c360_segment_definitions")
}

/// CAS head แยกต่อ logical segment stream; headVersion เป็น authority ของ concurrent publish
model C360SegmentDefinitionHead {
  tenantId       String   @map("tenant_id") @db.Uuid
  segmentId      String   @map("segment_id")
  headVersion    Int      @default(0) @map("head_version")
  currentVersion Int?     @map("current_version")
  currentDigest  String?  @map("current_digest") @db.Char(64)
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant            Tenant                 @relation(fields: [tenantId], references: [id])
  currentDefinition C360SegmentDefinition? @relation(fields: [tenantId, segmentId, currentVersion], references: [tenantId, segmentId, version])

  @@id([tenantId, segmentId])
  @@map("c360_segment_definition_heads")
}

/// Owner-local typed attribute/computed snapshot; external CRM ต้อง sync ก่อนสร้างแถวนี้
model C360FactSnapshot {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  contactId       String   @map("contact_id") @db.Uuid
  snapshotVersion Int      @map("snapshot_version")
  attributes      Json
  computed        Json
  sourceCutoffAt  DateTime @map("source_cutoff_at")
  contentDigest   String   @map("content_digest") @db.Char(64)
  correlationId   String   @map("correlation_id")
  capturedAt      DateTime @default(now()) @map("captured_at")

  tenant            Tenant                        @relation(fields: [tenantId], references: [id])
  contact           Contact                       @relation(fields: [tenantId, contactId], references: [tenantId, id])
  evaluations       C360SegmentEvaluation[]
  membershipHeads   C360SegmentMembershipHead[]
  membershipChanges C360SegmentMembershipChange[]

  @@unique([tenantId, id])
  @@unique([tenantId, contactId, snapshotVersion])
  @@index([tenantId, contactId, capturedAt(sort: Desc)])
  @@map("c360_fact_snapshots")
}

/// Durable evaluation checkpoint; ไม่มี raw attribute/PII มีเพียง binding, outcome และ digest
model C360SegmentEvaluation {
  id                       String                       @id @default(uuid()) @db.Uuid
  tenantId                 String                       @map("tenant_id") @db.Uuid
  contactId                String                       @map("contact_id") @db.Uuid
  segmentId                String                       @map("segment_id")
  segmentDefinitionVersion Int                          @map("segment_definition_version")
  snapshotVersion          Int                          @map("snapshot_version")
  outcome                  C360SegmentEvaluationOutcome
  matched                  Boolean?
  errorCode                String?                      @map("error_code")
  inputDigest              String                       @map("input_digest") @db.Char(64)
  evaluationDigest         String                       @map("evaluation_digest") @db.Char(64)
  evaluatorVersion         String                       @map("evaluator_version")
  evaluatedAt              DateTime                     @default(now()) @map("evaluated_at")

  tenant            Tenant                        @relation(fields: [tenantId], references: [id])
  definition        C360SegmentDefinition         @relation(fields: [tenantId, segmentId, segmentDefinitionVersion], references: [tenantId, segmentId, version])
  snapshot          C360FactSnapshot              @relation(fields: [tenantId, contactId, snapshotVersion], references: [tenantId, contactId, snapshotVersion])
  membershipHeads   C360SegmentMembershipHead[]
  membershipChanges C360SegmentMembershipChange[]
  evidence          C360SegmentEvidence?

  @@unique([tenantId, id])
  @@unique([tenantId, contactId, segmentId, segmentDefinitionVersion, snapshotVersion], map: "c360_segment_evaluations_exact_input_key")
  @@index([tenantId, segmentId, segmentDefinitionVersion, evaluatedAt])
  @@map("c360_segment_evaluations")
}

/// Materialized canonical membership ต่อ tenant/contact/segment; แก้ได้ผ่าน CAS owner transaction เท่านั้น
model C360SegmentMembershipHead {
  tenantId                 String                     @map("tenant_id") @db.Uuid
  contactId                String                     @map("contact_id") @db.Uuid
  segmentId                String                     @map("segment_id")
  state                    C360SegmentMembershipState
  membershipRevision       Int                        @default(0) @map("membership_revision")
  entryId                  String?                    @map("entry_id")
  segmentDefinitionVersion Int                        @map("segment_definition_version")
  snapshotVersion          Int                        @map("snapshot_version")
  evaluationId             String                     @map("evaluation_id") @db.Uuid
  evaluatedAt              DateTime                   @map("evaluated_at")
  stateDigest              String                     @map("state_digest") @db.Char(64)
  evidenceRef              String                     @map("evidence_ref")
  lineageRevision          Int                        @default(0) @map("lineage_revision")
  updatedAt                DateTime                   @updatedAt @map("updated_at")

  tenant     Tenant                @relation(fields: [tenantId], references: [id])
  contact    Contact               @relation(fields: [tenantId, contactId], references: [tenantId, id])
  definition C360SegmentDefinition @relation(fields: [tenantId, segmentId, segmentDefinitionVersion], references: [tenantId, segmentId, version])
  snapshot   C360FactSnapshot      @relation(fields: [tenantId, contactId, snapshotVersion], references: [tenantId, contactId, snapshotVersion])
  evaluation C360SegmentEvaluation @relation(fields: [tenantId, evaluationId], references: [tenantId, id])

  @@id([tenantId, contactId, segmentId])
  @@index([tenantId, segmentId, state, membershipRevision])
  @@index([tenantId, entryId])
  @@map("c360_segment_membership_heads")
}

/// Immutable canonical membership change; ทุก revision ที่ emit ต้องมี outbox row เดียวกัน
model C360SegmentMembershipChange {
  id                       String                          @id @default(uuid()) @db.Uuid
  tenantId                 String                          @map("tenant_id") @db.Uuid
  contactId                String                          @map("contact_id") @db.Uuid
  segmentId                String                          @map("segment_id")
  membershipRevision       Int                             @map("membership_revision")
  changeKind               C360SegmentMembershipChangeKind @map("change_kind")
  entryId                  String?                         @map("entry_id")
  segmentDefinitionVersion Int                             @map("segment_definition_version")
  snapshotVersion          Int                             @map("snapshot_version")
  evaluationId             String                          @map("evaluation_id") @db.Uuid
  evaluatedAt              DateTime                        @map("evaluated_at")
  stateDigest              String                          @map("state_digest") @db.Char(64)
  evidenceRef              String                          @map("evidence_ref")
  supersedesRevision       Int?                            @map("supersedes_revision")
  lineageRevision          Int                             @default(0) @map("lineage_revision")
  correlationId            String                          @map("correlation_id")
  causationId              String?                         @map("causation_id")
  createdAt                DateTime                        @default(now()) @map("created_at")

  tenant     Tenant                         @relation(fields: [tenantId], references: [id])
  contact    Contact                        @relation(fields: [tenantId, contactId], references: [tenantId, id])
  definition C360SegmentDefinition          @relation(fields: [tenantId, segmentId, segmentDefinitionVersion], references: [tenantId, segmentId, version])
  snapshot   C360FactSnapshot               @relation(fields: [tenantId, contactId, snapshotVersion], references: [tenantId, contactId, snapshotVersion])
  evaluation C360SegmentEvaluation          @relation(fields: [tenantId, evaluationId], references: [tenantId, id])
  outbox     C360SegmentMembershipOutbox?
  receipts   C360MembershipCommandReceipt[]

  @@unique([tenantId, id])
  @@unique([tenantId, contactId, segmentId, membershipRevision], map: "c360_membership_changes_stream_revision_key")
  @@index([tenantId, entryId, membershipRevision])
  @@map("c360_segment_membership_changes")
}

/// Transactional outbox สำหรับ customer.segment.changed; payload เป็น closed PII-safe J3 contract
model C360SegmentMembershipOutbox {
  id                 String                           @id @default(uuid()) @db.Uuid
  tenantId           String                           @map("tenant_id") @db.Uuid
  changeId           String                           @map("change_id") @db.Uuid
  eventId            String                           @map("event_id")
  contactId          String                           @map("contact_id") @db.Uuid
  segmentId          String                           @map("segment_id")
  membershipRevision Int                              @map("membership_revision")
  payload            Json
  payloadHash        String                           @map("payload_hash") @db.Char(64)
  correlationId      String                           @map("correlation_id")
  causationId        String?                          @map("causation_id")
  state              C360SegmentMembershipOutboxState @default(PENDING)
  attempts           Int                              @default(0)
  availableAt        DateTime                         @default(now()) @map("available_at")
  publishedAt        DateTime?                        @map("published_at")
  lastError          String?                          @map("last_error")
  quarantinedAt      DateTime?                        @map("quarantined_at")
  brokerRef          String?                          @map("broker_ref")
  createdAt          DateTime                         @default(now()) @map("created_at")

  tenant Tenant                      @relation(fields: [tenantId], references: [id])
  change C360SegmentMembershipChange @relation(fields: [tenantId, changeId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, changeId])
  @@unique([tenantId, eventId])
  @@index([tenantId, state, availableAt, createdAt])
  @@index([tenantId, contactId, segmentId, membershipRevision])
  @@map("c360_segment_membership_outbox")
}

/// Opaque handle ไปยัง owner-local evaluation facts; ไม่มี raw attribute ใน record นี้
model C360SegmentEvidence {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  evidenceRef    String   @map("evidence_ref")
  evaluationId   String   @map("evaluation_id") @db.Uuid
  contactId      String   @map("contact_id") @db.Uuid
  evidenceDigest String   @map("evidence_digest") @db.Char(64)
  createdAt      DateTime @default(now()) @map("created_at")

  tenant      Tenant                    @relation(fields: [tenantId], references: [id])
  contact     Contact                   @relation(fields: [tenantId, contactId], references: [tenantId, id])
  evaluation  C360SegmentEvaluation     @relation(fields: [tenantId, evaluationId], references: [tenantId, id])
  accessAudit C360EvidenceAccessAudit[]

  @@unique([tenantId, id])
  @@unique([tenantId, evidenceRef])
  @@unique([tenantId, evaluationId])
  @@map("c360_segment_evidence")
}

/// Append-only audit เมื่อ owner-side tooling resolve evidence; Journey ไม่มี API อ่าน raw facts
model C360EvidenceAccessAudit {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  evidenceRef   String   @map("evidence_ref")
  actorClass    String   @map("actor_class")
  actorRef      String   @map("actor_ref")
  reasonCode    String   @map("reason_code")
  correlationId String   @map("correlation_id")
  accessedAt    DateTime @default(now()) @map("accessed_at")

  tenant   Tenant              @relation(fields: [tenantId], references: [id])
  evidence C360SegmentEvidence @relation(fields: [tenantId, evidenceRef], references: [tenantId, evidenceRef])

  @@unique([tenantId, id])
  @@index([tenantId, evidenceRef, accessedAt])
  @@map("c360_evidence_access_audit")
}

/// Idempotent owner command receipt; เก็บเฉพาะ sanitized outcome binding
model C360MembershipCommandReceipt {
  id                 String                      @id @default(uuid()) @db.Uuid
  tenantId           String                      @map("tenant_id") @db.Uuid
  commandId          String                      @map("command_id")
  requestHash        String                      @map("request_hash") @db.Char(64)
  status             C360MembershipCommandStatus
  contactId          String                      @map("contact_id") @db.Uuid
  segmentId          String                      @map("segment_id")
  membershipRevision Int                         @map("membership_revision")
  changeId           String?                     @map("change_id") @db.Uuid
  entryId            String?                     @map("entry_id")
  responseDigest     String                      @map("response_digest") @db.Char(64)
  createdAt          DateTime                    @default(now()) @map("created_at")

  tenant Tenant                       @relation(fields: [tenantId], references: [id])
  change C360SegmentMembershipChange? @relation(fields: [tenantId, changeId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, commandId])
  @@index([tenantId, contactId, segmentId, membershipRevision])
  @@map("c360_membership_command_receipts")
}

/// Append-only conflict evidence; ไม่มี raw fact หรือ replacement payload
model C360MembershipQuarantine {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  commandId         String   @map("command_id")
  contactId         String   @map("contact_id") @db.Uuid
  segmentId         String   @map("segment_id")
  attemptedRevision Int      @map("attempted_revision")
  attemptedHash     String   @map("attempted_hash") @db.Char(64)
  canonicalHash     String?  @map("canonical_hash") @db.Char(64)
  errorCode         String   @map("error_code")
  correlationId     String   @map("correlation_id")
  createdAt         DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, id])
  @@unique([tenantId, commandId, attemptedHash])
  @@index([tenantId, contactId, segmentId, attemptedRevision])
  @@map("c360_membership_quarantine")
}

/// Current canonical identity map แยกจาก Contact CRUD; lineageRevision เดินด้วย CAS
model C360IdentityHead {
  tenantId           String            @map("tenant_id") @db.Uuid
  contactId          String            @map("contact_id") @db.Uuid
  state              C360IdentityState @default(ACTIVE)
  canonicalContactId String            @map("canonical_contact_id") @db.Uuid
  lineageRevision    Int               @default(0) @map("lineage_revision")
  stateDigest        String            @map("state_digest") @db.Char(64)
  updatedAt          DateTime          @updatedAt @map("updated_at")

  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  subject   Contact @relation("C360IdentitySubject", fields: [tenantId, contactId], references: [tenantId, id])
  canonical Contact @relation("C360IdentityCanonical", fields: [tenantId, canonicalContactId], references: [tenantId, id])

  @@id([tenantId, contactId])
  @@index([tenantId, canonicalContactId, state])
  @@map("c360_identity_heads")
}

/// Immutable merge/split/unmerge lineage; raw identity valuesไม่อยู่ใน ledger
model C360IdentityLineage {
  id              String                @id @default(uuid()) @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  commandId       String                @map("command_id")
  operation       C360IdentityOperation
  sourceContactId String                @map("source_contact_id") @db.Uuid
  targetContactId String                @map("target_contact_id") @db.Uuid
  lineageRevision Int                   @map("lineage_revision")
  requestHash     String                @map("request_hash") @db.Char(64)
  stateDigest     String                @map("state_digest") @db.Char(64)
  correlationId   String                @map("correlation_id")
  occurredAt      DateTime              @map("occurred_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  source Contact @relation("C360LineageSource", fields: [tenantId, sourceContactId], references: [tenantId, id])
  target Contact @relation("C360LineageTarget", fields: [tenantId, targetContactId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, commandId])
  @@index([tenantId, sourceContactId, lineageRevision])
  @@index([tenantId, targetContactId, occurredAt])
  @@map("c360_identity_lineage")
}

