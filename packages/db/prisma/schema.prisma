// ─────────────────────────── CG4.7 authorization store ───────────────────────────
// CG4.3 ประกาศ `Cg4AuthorizationPort` ไว้ให้ IAM เป็นเจ้าของ แต่ repo นี้ยังไม่มี IAM
// service จริง สองตารางนี้คือ canonical store ที่ port อ่านในระหว่างนั้น — แยกจาก
// `users.role` โดยตั้งใจ เพราะ #173 ห้ามใช้ role string แทน domain capability.
// เมื่อ IAM service พร้อม ให้เปลี่ยน adapter ที่อ่านตารางนี้ ไม่ต้องแก้ repository ใด ๆ
model Cg4AuthorizationSubject {
  id                        String                    @id @default(uuid()) @db.Uuid
  tenantId                  String                    @map("tenant_id") @db.Uuid
  /// stable human subject id; ตรงกับ workspace user id ที่ gateway verify มาแล้ว
  subjectId                 String                    @map("subject_id")
  authenticationStrength    Cg4AuthenticationStrength @default(STANDARD) @map("authentication_strength")
  directComplianceAuthority Boolean                   @default(false) @map("direct_compliance_authority")
  emergencyAuthority        Boolean                   @default(false) @map("emergency_authority")
  /// group/shared/service principal เป็น delegate หรือ checker ไม่ได้ (#173 §3)
  isServicePrincipal        Boolean                   @default(false) @map("is_service_principal")
  authorizationEpoch        Int                       @default(1) @map("authorization_epoch")
  scopeVersion              Int                       @default(1) @map("scope_version")
  updatedAt                 DateTime                  @updatedAt @map("updated_at")
  createdAt                 DateTime                  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, id])
  @@unique([tenantId, subjectId])
  @@map("cg_authorization_subject")
}

model Cg4CapabilityGrant {
