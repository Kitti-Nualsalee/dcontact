/// owner-local inbox of the CG3 consumer: the completion record is in the same transaction as the
/// Journey side effect and the acknowledgement outbox, before the Kafka offset is committed.
model JrGovernanceConsumerInbox {
  id               String                    @id @default(uuid()) @db.Uuid
  consumer         String
  tenantId         String                    @map("tenant_id") @db.Uuid
  eventId          String                    @map("event_id")
  aggregateType    CgAggregateType           @map("aggregate_type")
