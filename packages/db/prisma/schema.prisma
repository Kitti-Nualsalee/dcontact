// ─────────────────────────── CG4.7 authorization store ───────────────────────────
// CG4.3 declares `Cg4AuthorizationPort` for IAM to own, but this repo has no real IAM
// service yet; these two tables are the canonical store the port reads in the meantime — separate from
// `users.role` on purpose, because #173 forbids using a role string in place of a domain capability.
// When the IAM service is ready, change the adapter that reads these tables; no repository needs to change
model Cg4AuthorizationSubject {
  id                        String                    @id @default(uuid()) @db.Uuid
  tenantId                  String                    @map("tenant_id") @db.Uuid
  /// stable human subject id; matches the workspace user id the gateway has verified
  subjectId                 String                    @map("subject_id")
  authenticationStrength    Cg4AuthenticationStrength @default(STANDARD) @map("authentication_strength")
  directComplianceAuthority Boolean                   @default(false) @map("direct_compliance_authority")
  emergencyAuthority        Boolean                   @default(false) @map("emergency_authority")
  /// a group/shared/service principal cannot be a delegate or checker (#173 §3)
  isServicePrincipal        Boolean                   @default(false) @map("is_service_principal")
  authorizationEpoch        Int                       @default(1) @map("authorization_epoch")
  scopeVersion              Int                       @default(1) @map("scope_version")
  updatedAt                 DateTime                  @updatedAt @map("updated_at")
  createdAt                 DateTime                  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, id])
  @@unique([tenantId, subjectId])
  @@map("cg_authorization_subject")
}

model Cg4CapabilityGrant {
  id           String    @id @default(uuid()) @db.Uuid
