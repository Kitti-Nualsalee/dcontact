model AccountAuditEvent {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  /// kept even if the user is deleted, so there is no foreign key to users
  userId        String   @map("user_id") @db.Uuid
  /// password.changed | email.change.requested | email.change.confirmed | email.change.cancelled |
  /// profile.updated | mfa.enrolled | mfa.removed
  action        String
  metadata      Json?
  correlationId String   @map("correlation_id")
  occurredAt    DateTime @map("occurred_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, userId, occurredAt], map: "account_audit_events_user_idx")
  @@map("account_audit_events")
}

/// AC3 (#596): outbox of account emails that D-Contact sends itself — recipients and variables are cleared when finished (SENT/DEAD)
model AccountEmailOutbox {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  /// no foreign key — a notice to the old email can still be sent even if the user was deleted
  userId         String?   @map("user_id") @db.Uuid
  /// verify-new-email | email-changed-notice | password-changed-notice
  template       String
  /// th | en
  locale         String
  recipient      String?
  variables      Json?
  dedupeKey      String    @map("dedupe_key")
  /// PENDING | SENDING | SENT | DEAD
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now()) @map("available_at")
  leaseExpiresAt DateTime? @map("lease_expires_at")
  lastErrorCode  String?   @map("last_error_code")
  sentAt         DateTime? @map("sent_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, dedupeKey], map: "account_email_outbox_dedupe_key")
  @@index([tenantId, status, availableAt], map: "account_email_outbox_due_idx")
  @@map("account_email_outbox")
}

