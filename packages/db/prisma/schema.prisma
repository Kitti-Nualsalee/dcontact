// ──────────────────────── J2.5: Dialer ADMIT_CAMPAIGN_TARGET owner ────────────────────────
// Dialer เป็น canonical writer เต็มรูปแบบของ ob_campaign_* — Journey สร้าง/start/pause/edit
// Campaign ไม่ได้และไม่ originate/send ที่นี่ (ดู #133 ขอบเขต J2.5); admission เฉพาะ
// existing campaign เท่านั้น

enum ObCampaignStatus {
  ACTIVE
  SCHEDULED
  PAUSED
  STOPPED
  COMPLETED
}

/// ADMITTED = originate ได้ตามปกติเมื่อ campaign active; DEFERRED = admission สำเร็จแต่
/// campaign ยัง scheduled/paused — ทั้งคู่รายงานผลเป็น J2OwnerResultStatus 'ADMITTED'
/// เพราะ Journey สนใจแค่ว่า admit สำเร็จหรือไม่ ไม่ใช่ pacing/schedule ภายใน
enum ObCampaignTargetState {
  ADMITTED
  DEFERRED
  /// J2.9: originate barrier claimed a governance reservation, TEST_ADAPTER pending
  ORIGINATING
  /// J2.9: TEST_ADAPTER accepted — simulated call in progress
  ACTIVE
  /// J2.9: simulated call settled (terminal, no further origination for this target)
  CONSUMED
  /// J2.9 follow-up: originate lease หมดขณะค้างใน ORIGINATING (เช่น process ตายกลางคัน)
  /// — ต้องให้ CG3 primitive/คนตัดสิน ห้าม originate ซ้ำและห้าม release reservation เอง
  RECONCILING
  /// J2.8: CANCEL_CAMPAIGN_TARGET ก่อนถึง originate barrier (terminal)
  CANCELLED
  /// J2.8: SUPERSEDE_CAMPAIGN_TARGET ก่อนถึง originate barrier (terminal)
  SUPERSEDED
}

/// fixture ของ campaign ที่ "มีอยู่แล้ว" — ไม่มี Campaign CRUD/UI ใน J2.5 (out of scope)
model ObCampaign {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  key       String
  status    ObCampaignStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@map("ob_campaigns")
}

/// versioned policy ต่อ campaign — ตัดสิน duplicate contact ข้าม campaign เท่านั้น;
/// duplicate ภายใน campaign เดียวกันบังคับด้วย unique constraint ของ ob_campaign_targets เสมอ
model ObCampaignAdmissionPolicy {
  id                          String   @id @default(uuid()) @db.Uuid
  tenantId                    String   @map("tenant_id") @db.Uuid
  campaignId                  String   @map("campaign_id") @db.Uuid
  version                     Int      @default(1)
  allowCrossCampaignDuplicate Boolean  @default(false) @map("allow_cross_campaign_duplicate")
  createdAt                   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, campaignId])
  @@map("ob_campaign_admission_policies")
}

/// canonical target record หนึ่งแถวต่อ (campaign, contact) — recordId/version ที่ J2
/// ownerAggregate อ้างถึง; ไม่มี Governance reservation, Attempt หรือ provider I/O ที่นี่
model ObCampaignTarget {
  id                     String                @id @default(uuid()) @db.Uuid
  tenantId               String                @map("tenant_id") @db.Uuid
  campaignId             String                @map("campaign_id") @db.Uuid
  contactId              String                @map("contact_id") @db.Uuid
  version                Int                   @default(1)
  state                  ObCampaignTargetState @default(ADMITTED)
  sourceOwnerTeamId      String                @map("source_owner_team_id") @db.Uuid
  targetOwnerTeamId      String                @map("target_owner_team_id") @db.Uuid
  admissionPolicyVersion Int                   @map("admission_policy_version")
  /// J2.9 follow-up: ตั้งตอนเข้า ORIGINATING และล้างตอนออก — sweeper ใช้ตัวนี้แยก
  /// "กำลัง originate อยู่จริง" ออกจาก "ค้างเพราะ process ตาย"
  originateLeaseExpiresAt DateTime?            @map("originate_lease_expires_at")
  cancelledAt               DateTime?          @map("cancelled_at")
  cancelReasonCode          String?            @map("cancel_reason_code")
  supersededAt              DateTime?          @map("superseded_at")
  supersedingOutcomeType    String?            @map("superseding_outcome_type")
  supersedingOutcomeId      String?            @map("superseding_outcome_id") @db.Uuid
  supersedingOutcomeVersion Int?               @map("superseding_outcome_version")
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  contact Contact @relation(fields: [tenantId, contactId], references: [tenantId, id])

  @@unique([tenantId, campaignId, contactId])
  @@index([tenantId, contactId])
  @@index([tenantId, state, originateLeaseExpiresAt], map: "ob_campaign_targets_originate_lease_idx")
  @@map("ob_campaign_targets")
}

/// durable command+result เดียวกันต่อ actionKey — pull model เหมือน cs_command_inbox
/// ของ J2.4; commandType เก็บไว้เผื่อ SCHEDULE_CALLBACK, CANCEL_x และ SUPERSEDE_x ของ
/// ticket ถัดไป แม้ J2.5 จะ populate เฉพาะ ADMIT_CAMPAIGN_TARGET เท่านั้น
model ObDialerCommandInbox {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  commandId        String   @map("command_id")
  actionKey        String   @map("action_key")
  commandType      String   @map("command_type")
  requestHash      String   @map("request_hash") @db.Char(64)
  status           String
  code             String
  category         String
  reasonCode       String   @map("reason_code")
  failureClass     String   @map("failure_class")
  retryDisposition String   @map("retry_disposition")
  recordId         String?  @map("record_id") @db.Uuid
  recordVersion    Int?     @map("record_version")
  correlationId    String   @map("correlation_id")
  observedAt       DateTime @map("observed_at")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  /// J2.8: cancel/supersede ใช้ actionKey เดิมของ positive effect แต่ commandId ใหม่ (J2.1
  /// contract) — receipt หนึ่งใบต่อ command จึง unique ที่ commandId ไม่ใช่ actionKey
  @@unique([tenantId, commandId], map: "ob_dialer_command_inbox_tenant_command_key")
  @@index([tenantId, actionKey, commandType], map: "ob_dialer_command_inbox_tenant_action_idx")
  @@map("ob_dialer_command_inbox")
}

// ─────────────────── J2.6: Dialer SCHEDULE_CALLBACK/CANCEL/SUPERSEDE owner ───────────────────
// reuse ob_dialer_command_inbox เดิมของ J2.5 (commandType เก็บไว้เผื่อไว้แล้ว) — ที่นี่เพิ่ม
// เฉพาะ canonical ob_callbacks; ไม่มี actual originate/telephony command ใน J2.6 (out of scope)

/// SCHEDULED เท่านั้นที่ reversible; ORIGINATING/ACTIVE/CONSUMED เป็น fixture-only state
/// ที่จำลอง progress จากกลไก originate จริงซึ่งยังไม่ถูกสร้างใน J2.6 — ใช้ทดสอบขอบเขต
/// irreversible (ตอบ TOO_LATE) เท่านั้น
enum ObCallbackState {
  SCHEDULED
  ORIGINATING
  ACTIVE
  CONSUMED
  CANCELLED
  SUPERSEDED
  /// J2.9 follow-up: ความหมายเดียวกับ ObCampaignTargetState.RECONCILING
  RECONCILING
}

/// canonical Callback record หนึ่งแถวต่อ SCHEDULE_CALLBACK ที่สำเร็จ — ไม่มี Governance
/// reservation หรือ telephony command ที่นี่; originate จริงเป็น ticket ถัดไป
model ObCallback {
  id                        String          @id @default(uuid()) @db.Uuid
  tenantId                  String          @map("tenant_id") @db.Uuid
  contactId                 String          @map("contact_id") @db.Uuid
  queueId                   String          @map("queue_id") @db.Uuid
  agentId                   String?         @map("agent_id") @db.Uuid
  requestedFor              DateTime        @map("requested_for")
  expiresAt                 DateTime        @map("expires_at")
  state                     ObCallbackState @default(SCHEDULED)
  version                   Int             @default(1)
  sourceOwnerTeamId         String          @map("source_owner_team_id") @db.Uuid
  targetOwnerTeamId         String          @map("target_owner_team_id") @db.Uuid
  cancelledAt               DateTime?       @map("cancelled_at")
  cancelReasonCode          String?         @map("cancel_reason_code")
  supersededAt              DateTime?       @map("superseded_at")
  supersedingOutcomeType    String?         @map("superseding_outcome_type")
  supersedingOutcomeId      String?         @map("superseding_outcome_id") @db.Uuid
  supersedingOutcomeVersion Int?            @map("superseding_outcome_version")
  /// J2.9 follow-up: ความหมายเดียวกับ ObCampaignTarget.originateLeaseExpiresAt
  originateLeaseExpiresAt   DateTime?       @map("originate_lease_expires_at")
  createdAt                 DateTime        @default(now()) @map("created_at")
  updatedAt                 DateTime        @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  contact Contact @relation(fields: [tenantId, contactId], references: [tenantId, id])

  @@index([tenantId, contactId, state])
  @@index([tenantId, state, originateLeaseExpiresAt], map: "ob_callbacks_originate_lease_idx")
  @@map("ob_callbacks")
}

// ─────────────────────── J2.3: outcome/action durable foundation ───────────────────────
// Journey เป็นเจ้าของ receipt/action/command/result เหล่านี้เท่านั้น — ไม่ใช่ canonical
// Case/Campaign/Callback state ของ owner ตาม #121; ที่นี่ยังไม่มี trigger matching, owner
// implementation หรือ relay transport จริง (J2.3 คือ schema/primitive เท่านั้น)

/// ผลดำเนินการของ receipt แต่ละใบ — ตรงกับ diagram ที่ยืนยันใน #123
/// (RETRYABLE_FAILURE เป็น transient ระหว่าง retry เท่านั้น ไม่ persist เป็น state แยก
/// แถวที่ retry ได้จะถูกส่งกลับไป READY พร้อม backoff บน `availableAt`)
enum JrOutcomeReceiptState {
  RECEIVED
  WAITING_FOR_GAP
  READY
  PROCESSING
  APPLIED
  IGNORED_SUPERSEDED
  REVIEW
  QUARANTINED
}

enum JrOwnerActionKind {
  ENSURE_CASE
  ADMIT_CAMPAIGN_TARGET
  SCHEDULE_CALLBACK
}

/// ตรงกับ business action lifecycle ที่ยืนยันใน #123 ทุก state
enum JrOwnerActionState {
  PENDING
  DISPATCHED
  ACKNOWLEDGED
  REJECTED
  ACK_UNKNOWN
  CANCEL_REQUESTED
  CANCELLED
  /// J2.8: ผลจริงของ SUPERSEDE_CALLBACK/SUPERSEDE_CAMPAIGN_TARGET
  SUPERSEDED
  TOO_LATE
  RECONCILING
}

enum JrOwnerCommandState {
  PENDING
  /// J2.8: เคลมไว้ระหว่างเรียก owner port — กัน worker คนละตัว claim ซ้ำ
  PROCESSING
  SENT
  FAILED
  /// J2.8: action ถูกยกเลิกก่อน command ออกจาก Journey — ห้าม dispatch ตลอดไป
  CANCELLED
}

/// ผลที่ owner ตอบกลับมาได้ — แยกจาก JrOwnerActionState เพราะ PENDING/DISPATCHED/
/// CANCEL_REQUESTED ไม่ใช่ "ผล" ที่ owner ส่งกลับ
enum JrOwnerResultKind {
  ACKNOWLEDGED
  REJECTED
  ACK_UNKNOWN
  CANCELLED
  SUPERSEDED
  TOO_LATE
  RECONCILING
}

enum JrOwnerResultOutcome {
  APPLIED
  DUPLICATE
  CONFLICT
}

enum JrRecoveryOperation {
  REPLAY
  RECONCILE
  CANCEL
  SKIP_QUARANTINE
  /// J3.5 (#216): สั่งประเมิน membership ใหม่ผ่าน re-filter cursor ไม่ใช่แก้ receipt/head ตรง
  REVALIDATE
}

enum JrRecoveryTargetKind {
  RECEIPT
  ACTION
  /// J3.5 (#216): เพิ่มแบบ additive — ค่าเดิมสองตัวยังหมายถึง J2 receipt/action เหมือนเดิม
  SEGMENT_RECEIPT
  SEGMENT_REFILTER
}

/// J2.3 — durable receipt ของ canonical interaction outcome revision หนึ่งใบ transport
/// identity `(source, eventId)` แยกจาก logical stream identity
/// `(outcomeType, outcomeId, outcomeVersion)` ตามที่ยืนยันใน #123; ไม่มี raw contact
/// data — เก็บเฉพาะ internal ID, hash และ metadata
model JrOutcomeReceipt {
  id               String                @id @default(uuid()) @db.Uuid
  tenantId         String                @map("tenant_id") @db.Uuid
  source           String
  eventId          String                @map("event_id")
  outcomeType      String                @map("outcome_type")
  outcomeId        String                @map("outcome_id") @db.Uuid
  outcomeVersion   Int                   @map("outcome_version")
  payloadHash      String                @map("payload_hash") @db.Char(64)
  /// J2.7: `InteractionOutcomePayloadV1` ที่ผ่าน `assertInteractionOutcomeEnvelope` แล้ว —
  /// internal ID/code เท่านั้น ไม่มี raw PII; จำเป็นสำหรับ trigger matching และสร้าง owner
  /// command ในเฟส apply ที่แยกจาก ingest (`JourneyOutcomeReceiptRepository.ingest` ที่ตัวเอง
  /// ยังเป็นแค่ hash-based dedup/ordering ledger ตาม J2.3)
  payload          Json
  state            JrOutcomeReceiptState @default(RECEIVED)
  attempts         Int                   @default(0)
  leaseOwner       String?               @map("lease_owner")
  leaseExpiresAt   DateTime?             @map("lease_expires_at")
  availableAt      DateTime              @default(now()) @map("available_at")
  reviewReasonCode String?               @map("review_reason_code")
  lastError        String?               @map("last_error")
  correlationId    String                @map("correlation_id")
  causationId      String?               @map("causation_id")
  receivedAt       DateTime              @default(now()) @map("received_at")
  appliedAt        DateTime?             @map("applied_at")

  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  enrollments JrEnrollment[]

  @@unique([tenantId, source, eventId])
  @@unique([tenantId, outcomeType, outcomeId, outcomeVersion])
  @@index([tenantId, state, availableAt])
  @@map("jr_outcome_receipts")
}

/// head ของ logical outcome stream หนึ่งเส้น — เทียบเท่า `CgContactStateHead` ของ CG3
/// แต่ scope เป็น `(outcomeType, outcomeId)` ของ J2 เอง ไม่ใช่ contact aggregate
model JrOutcomeHead {
  tenantId             String   @map("tenant_id") @db.Uuid
  outcomeType          String   @map("outcome_type")
  outcomeId            String   @map("outcome_id") @db.Uuid
  lastAppliedVersion   Int      @default(0) @map("last_applied_version")
  lastAppliedReceiptId String?  @map("last_applied_receipt_id") @db.Uuid
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, outcomeType, outcomeId])
  @@map("jr_outcome_heads")
}

/// J2.3 — Journey-owned record ของ owner action intent หนึ่งชิ้น ผูกกับ stable
/// `actionKey = enrollmentId:journeyVersion:stepId` ตาม #123; เก็บเฉพาะ owner
/// aggregate reference/version เป็น audit snapshot ไม่ใช่ canonical owner state
model JrOwnerAction {
  id                    String             @id @default(uuid()) @db.Uuid
  tenantId              String             @map("tenant_id") @db.Uuid
  actionKey             String             @map("action_key")
  enrollmentId          String             @map("enrollment_id") @db.Uuid
  outcomeReceiptId      String?            @map("outcome_receipt_id") @db.Uuid
  kind                  JrOwnerActionKind
  requestHash           String             @map("request_hash") @db.Char(64)
  state                 JrOwnerActionState @default(PENDING)
  ownerAggregateRef     String?            @map("owner_aggregate_ref")
  ownerAggregateVersion Int?               @map("owner_aggregate_version")
  /// J2.8 follow-up: optimistic-concurrency token ของ action เอง — ขยับทุกครั้งที่ state
  /// เปลี่ยน เพื่อให้ admin recovery API บังคับ expectedVersion ได้ (attempts ใช้แทนไม่ได้
  /// เพราะนับเฉพาะ dispatch และไม่ขยับตอน cancel)
  version               Int                @default(1)
  attempts              Int                @default(0)
  dispatchedAt          DateTime?          @map("dispatched_at")
  acknowledgedAt        DateTime?          @map("acknowledged_at")
  cancelRequestedAt     DateTime?          @map("cancel_requested_at")
  lastError             String?            @map("last_error")
  correlationId         String             @map("correlation_id")
  createdAt             DateTime           @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, actionKey])
  @@index([tenantId, enrollmentId])
  @@index([tenantId, state])
  @@map("jr_owner_actions")
}

/// transactional outbox ของ command ที่จะ relay ไปยัง owner — J2.3 มีแค่ตาราง/primitive
/// การ relay transport จริงเป็น scope ของ ticket ถัดไป
model JrOwnerCommandOutbox {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  commandId     String              @map("command_id")
  actionId      String              @map("action_id") @db.Uuid
  actionKey     String              @map("action_key")
  kind          JrOwnerActionKind
  requestHash   String              @map("request_hash") @db.Char(64)
  /// J2.8: full J2OwnerCommandPayloadV1 envelope พร้อม relay — null สำหรับ command เก่า
  /// ก่อน J2.8 ที่ยัง reconstruct payload ไม่ได้จาก fragment เดิม
  payload       Json?
  correlationId String              @map("correlation_id")
  state         JrOwnerCommandState @default(PENDING)
  attempts      Int                 @default(0)
  availableAt   DateTime            @default(now()) @map("available_at")
  sentAt        DateTime?           @map("sent_at")
  lastError     String?             @map("last_error")
  createdAt     DateTime            @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, commandId])
  @@index([tenantId, state, availableAt])
  @@map("jr_owner_command_outbox")
}

/// inbox ของผลที่ owner ส่งกลับมาต่อ command หนึ่งใบ — idempotent apply ต่อ
/// `(tenantId, commandId)`; ผลที่มาซ้ำ/ขัดกันไม่ทำให้ action ขยับสถานะซ้ำ
model JrOwnerResultInbox {
  id                    String               @id @default(uuid()) @db.Uuid
  tenantId              String               @map("tenant_id") @db.Uuid
  commandId             String               @map("command_id")
  actionKey             String               @map("action_key")
  resultKind            JrOwnerResultKind    @map("result_kind")
  ownerAggregateRef     String?              @map("owner_aggregate_ref")
  ownerAggregateVersion Int?                 @map("owner_aggregate_version")
  resultHash            String               @map("result_hash") @db.Char(64)
  outcome               JrOwnerResultOutcome @default(APPLIED)
  correlationId         String               @map("correlation_id")
  receivedAt            DateTime             @default(now()) @map("received_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, commandId])
  @@index([tenantId, actionKey])
  @@map("jr_owner_result_inbox")
}

/// audit ของ manual recovery (replay/reconcile/cancel/skip-quarantine) แบบ append-only
/// เท่านั้น — ตาราง reuse identity เดิม ห้ามแก้ canonical row/offset/receipt โดยตรง
model JrRecoveryAudit {
  id          String               @id @default(uuid()) @db.Uuid
  tenantId    String               @map("tenant_id") @db.Uuid
  operation   JrRecoveryOperation
  targetKind  JrRecoveryTargetKind @map("target_kind")
  /// opaque reference เดิมที่ reuse ได้ (eventId/outcomeId หรือ actionKey) ไม่ใช่ raw PII
  targetRef   String               @map("target_ref")
  reasonCode  String               @map("reason_code")
  actorId     String               @map("actor_id") @db.Uuid
  evidenceRef String?              @map("evidence_ref")
  occurredAt  DateTime             @default(now()) @map("occurred_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, targetKind, targetRef, occurredAt])
  @@map("jr_recovery_audit")
}

// ───────────────────── J3.5: Journey segment receipt/head/intent/re-filter ─────────────────────
// J3 เป็นเจ้าของตารางชุดนี้เองทั้งหมด แยกขาดจาก jr_event_inbox ของ J1 และ jr_outcome_* ของ J2
// (stop condition #216 ห้าม repurpose ตารางเดิม) และไม่มี shared write ไปยัง c360_* ใด ๆ

enum JrSegmentReceiptState {
  RECEIVED
  WAITING_FOR_GAP
  READY
  PROCESSING
  APPLIED
  IGNORED_SUPERSEDED
  REVIEW
  QUARANTINED
}

/// วงจรของงาน re-filter หนึ่งใบ — HELD คือถูกกันไว้เพราะมี owner action ค้างอยู่
/// ส่วน DEFERRED คือ scope/context ยังไม่พร้อมและต้องเริ่มประเมินใหม่ ไม่ใช่รอแล้วผ่านเอง
enum JrSegmentRefilterState {
  PENDING
  REVALIDATING
  NO_OP
  CANCELLED
  DEFERRED
  HELD
  RECONCILING
}

enum JrSegmentOutboxState {
  PENDING
  PROCESSING
  SENT
  FAILED
}

/// durable receipt ของ membership change หนึ่ง revision
///
/// transport identity `(source, eventId)` แยกจาก logical identity
/// `(contactId, segmentId, membershipRevision)` — ส่งซ้ำจาก broker ชนที่ transport ส่วน
/// revision เดิมที่มาคนละ event ชนที่ logical ทั้งสองกรณีต้องไม่สร้างแถวที่สอง
///
/// ไม่เก็บ payload เป็น Json แต่แตกเป็น field ที่รู้จักทั้งหมด เพราะ acceptance ของ #216
/// บังคับว่า raw attribute/identity/PII ห้ามอยู่ใน J3 rows — การเก็บ blob ทำให้พิสูจน์ไม่ได้ว่า
/// วันหนึ่งจะไม่มีใครยัด attribute ดิบเข้ามา ส่วนค่าที่ต้องใช้จริงมีแค่ reference กับ digest
model JrSegmentReceipt {
  id                       String                @id @default(uuid()) @db.Uuid
  tenantId                 String                @map("tenant_id") @db.Uuid
  source                   String
  eventId                  String                @map("event_id")
  contactId                String                @map("contact_id") @db.Uuid
  segmentId                String                @map("segment_id")
  membershipRevision       Int                   @map("membership_revision")
  changeKind               String                @map("change_kind")
  /// entry ของการเข้า segment ครั้งนั้น — null เมื่อ change ไม่ได้สร้าง entry (LEFT/invalidation)
  entryId                  String?               @map("entry_id")
  supersedesRevision       Int?                  @map("supersedes_revision")
  segmentDefinitionVersion Int                   @map("segment_definition_version")
  payloadHash              String                @map("payload_hash") @db.Char(64)
  /// reference ไปยัง evidence ของ Customer 360 ไม่ใช่ตัว evidence เอง
  evidenceRef              String?               @map("evidence_ref")
  state                    JrSegmentReceiptState @default(RECEIVED)
  attempts                 Int                   @default(0)
  leaseOwner               String?               @map("lease_owner")
  leaseExpiresAt           DateTime?             @map("lease_expires_at")
  availableAt              DateTime              @default(now()) @map("available_at")
  reviewReasonCode         String?               @map("review_reason_code")
  lastError                String?               @map("last_error")
  correlationId            String                @map("correlation_id")
  causationId              String?               @map("causation_id")
  receivedAt               DateTime              @default(now()) @map("received_at")
  appliedAt                DateTime?             @map("applied_at")
  /// J3.8 (#219): optimistic-concurrency token — ขยับทุกครั้งที่ state เปลี่ยน
  ///
  /// แยกจาก `attempts` โดยตั้งใจ: attempts ขยับเฉพาะตอน retry ไม่ขยับตอน state เปลี่ยนด้วย
  /// เหตุอื่น ใช้เป็น token แล้ว operator จะเห็นค่าเดิมทั้งที่ของเปลี่ยนไปแล้ว ซึ่งคือ blind
  /// retry ที่ acceptance สั่งให้ปฏิเสธพอดี
  version                  Int                   @default(1)

  tenant    Tenant                      @relation(fields: [tenantId], references: [id])
  contact   Contact                     @relation(fields: [tenantId, contactId], references: [tenantId, id])
  intents   JrSegmentEnrollmentIntent[]
  refilters JrSegmentRefilterCursor[]
  outbox    JrSegmentOutbox[]

  @@unique([tenantId, id])
  @@unique([tenantId, source, eventId])
  @@unique([tenantId, contactId, segmentId, membershipRevision])
  @@index([tenantId, state, availableAt])
  @@index([tenantId, contactId, segmentId, membershipRevision])
  @@map("jr_segment_receipts")
}

/// head ของ membership stream หนึ่งเส้นในมุมของ J3
///
/// `lastAppliedRevision` ขยับขึ้นอย่างเดียว (บังคับด้วย CHECK + CAS) ส่วน terminal* คือ
/// first-terminal protection: เมื่อ entry หนึ่งจบไปแล้ว revision ที่มาทีหลังห้ามชุบชีวิตมันกลับ
model JrSegmentHead {
  tenantId             String   @map("tenant_id") @db.Uuid
  contactId            String   @map("contact_id") @db.Uuid
  segmentId            String   @map("segment_id")
  lastAppliedRevision  Int      @default(0) @map("last_applied_revision")
  lastAppliedReceiptId String?  @map("last_applied_receipt_id") @db.Uuid
  terminalEntryId      String?  @map("terminal_entry_id")
  terminalRevision     Int?     @map("terminal_revision")
  terminalReasonCode   String?  @map("terminal_reason_code")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  contact Contact @relation(fields: [tenantId, contactId], references: [tenantId, id])

  @@id([tenantId, contactId, segmentId])
  @@index([tenantId, segmentId])
  @@map("jr_segment_heads")
}

/// enrollment intent หนึ่งใบที่เกิดจากการเข้า segment
///
/// เก็บ "เหตุผล" ได้แค่ reference/version/digest เท่านั้นและเป็น immutable (บังคับด้วย trigger)
/// — ถ้าเก็บค่า attribute หรือ JSON นิยาม segment ไว้ เหตุผลจะกลายเป็นสำเนาที่เพี้ยนจาก
/// Customer 360 ทันทีที่นิยามถูกแก้ และ Journey จะกลายเป็นเจ้าของข้อมูลที่ตัวเองไม่ได้เป็นเจ้าของ
model JrSegmentEnrollmentIntent {
  id                       String   @id @default(uuid()) @db.Uuid
  tenantId                 String   @map("tenant_id") @db.Uuid
  journeyId                String   @map("journey_id")
  journeyVersion           Int      @map("journey_version")
  contactId                String   @map("contact_id") @db.Uuid
  segmentId                String   @map("segment_id")
  entryId                  String   @map("entry_id")
  receiptId                String   @map("receipt_id") @db.Uuid
  reasonMembershipRevision Int      @map("reason_membership_revision")
  reasonDefinitionVersion  Int      @map("reason_definition_version")
  reasonEvidenceRef        String?  @map("reason_evidence_ref")
  reasonDigest             String   @map("reason_digest") @db.Char(64)
  correlationId            String   @map("correlation_id")
  createdAt                DateTime @default(now()) @map("created_at")

  tenant  Tenant           @relation(fields: [tenantId], references: [id])
  contact Contact          @relation(fields: [tenantId, contactId], references: [tenantId, id])
  receipt JrSegmentReceipt @relation(fields: [tenantId, receiptId], references: [tenantId, id])

  enrollment JrEnrollment?

  @@unique([tenantId, id])
  @@unique([tenantId, journeyId, journeyVersion, contactId, segmentId, entryId])
  @@index([tenantId, receiptId])
  @@map("jr_segment_enrollment_intents")
}

/// งาน re-filter ที่เกิดจาก membership change ที่ไม่ได้พา enrollment ใหม่เข้ามา
model JrSegmentRefilterCursor {
  id                 String                 @id @default(uuid()) @db.Uuid
  tenantId           String                 @map("tenant_id") @db.Uuid
  contactId          String                 @map("contact_id") @db.Uuid
  segmentId          String                 @map("segment_id")
  membershipRevision Int                    @map("membership_revision")
  receiptId          String                 @map("receipt_id") @db.Uuid
  state              JrSegmentRefilterState @default(PENDING)
  attempts           Int                    @default(0)
  leaseOwner         String?                @map("lease_owner")
  leaseExpiresAt     DateTime?              @map("lease_expires_at")
  availableAt        DateTime               @default(now()) @map("available_at")
  reasonCode         String?                @map("reason_code")
  correlationId      String                 @map("correlation_id")
  /// populated only for restrictive IAM invalidation; prevents cancelling another team's work
  scopeTeamId        String?                @map("scope_team_id") @db.Uuid
  createdAt          DateTime               @default(now()) @map("created_at")
  settledAt          DateTime?              @map("settled_at")
  /// J3.8 (#219): optimistic-concurrency token เหมือน jr_segment_receipts.version
  version            Int                    @default(1)

  tenant  Tenant           @relation(fields: [tenantId], references: [id])
  contact Contact          @relation(fields: [tenantId, contactId], references: [tenantId, id])
  receipt JrSegmentReceipt @relation(fields: [tenantId, receiptId], references: [tenantId, id])

  /// membership re-filter ปกติใช้ scopeTeamId = null; IAM revoke แยกหนึ่งงานต่อทีมเพื่อ
  /// ห้าม revoke ทีมหนึ่งไป cancel Journey ของทีมอื่นใน entry เดียวกัน
  @@unique([tenantId, contactId, segmentId, membershipRevision, scopeTeamId])
  @@index([tenantId, state, availableAt])
  @@index([tenantId, scopeTeamId])
  @@map("jr_segment_refilter_cursors")
}

/// Durable dedup boundary for IAM scope invalidations consumed by Journey.
model JrIamScopeInvalidationInbox {
  consumer     String   @map("consumer")
  tenantId     String   @map("tenant_id") @db.Uuid
  eventId      String   @map("event_id")
  scopeVersion Int      @map("scope_version")
  completedAt  DateTime @default(now()) @map("completed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([consumer, tenantId, eventId])
  @@index([tenantId, scopeVersion])
  @@map("jr_iam_scope_invalidation_inbox")
}

/// local outbox ของ J3 — commit พร้อม receipt/head/intent ในทรานแซกชันเดียว
model JrSegmentOutbox {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @map("tenant_id") @db.Uuid
  receiptId     String               @map("receipt_id") @db.Uuid
  eventId       String               @map("event_id") @db.Uuid
  eventType     String               @map("event_type")
  orderingKey   String               @map("ordering_key")
  payloadHash   String               @map("payload_hash") @db.Char(64)
  payload       Json
  state         JrSegmentOutboxState @default(PENDING)
  attempts      Int                  @default(0)
  availableAt   DateTime             @default(now()) @map("available_at")
  lastError     String?              @map("last_error")
  correlationId String               @map("correlation_id")
  causationId   String?              @map("causation_id")
  createdAt     DateTime             @default(now()) @map("created_at")
  publishedAt   DateTime?            @map("published_at")

  tenant  Tenant           @relation(fields: [tenantId], references: [id])
  receipt JrSegmentReceipt @relation(fields: [tenantId, receiptId], references: [tenantId, id])

  @@unique([tenantId, eventId])
  @@index([tenantId, state, availableAt])
  @@map("jr_segment_outbox")
}

// ───────────────────── J3.10: Segment rollout stage และ shadow evaluation ─────────────────────

/// ลำดับการเปิดใช้ J3 ต่อ tenant — เดินหน้าอย่างเดียว ย้อนกลับข้าม switch point ไม่ได้
enum JrSegmentRolloutStage {
  DISABLED
  /// baseline membership เดิมอยู่ ยังไม่รับ event
  OWNER_BACKFILL
  /// รับ event แล้วเทียบ digest กับ Customer 360 แต่ยังไม่สร้าง effect ใด ๆ
  SHADOW_MEMBERSHIP
  /// เดิน receipt/re-filter จริงแต่ยังไม่สร้าง enrollment
  SHADOW_RECEIPT_REFILTER
  /// เปิดเต็มรูปแบบ — enrollment เกิดได้จริง
  SCOPED_INTERNAL_ENABLED
}

/// ไม่มีแถว = DISABLED. switchedAt ตั้งครั้งเดียวตอนเข้า SCOPED_INTERNAL_ENABLED และหลังจากนั้น
/// trigger jr_segment_rollout_guard ห้ามย้อนกลับไป stage ก่อนหน้า
model JrSegmentRolloutState {
  id             String                @id @default(uuid()) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  stage          JrSegmentRolloutStage @default(DISABLED)
  shadowStartedAt DateTime?            @map("shadow_started_at")
  switchedAt     DateTime?             @map("switched_at")
  /// rollback = หยุด effect ใหม่ ไม่ใช่ย้อน stage หรือลบของที่เกิดไปแล้ว
  mutationFrozen Boolean               @default(false) @map("mutation_frozen")
  version        Int                   @default(1)
  updatedByRef   String                @map("updated_by_ref")
  evidenceRef    String?               @map("evidence_ref")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId])
  @@map("jr_segment_rollout_state")
}

/// ผลการเทียบระหว่างสิ่งที่ J3 คำนวณกับ canonical ของ Customer 360 ระหว่าง shadow
///
/// เก็บได้แค่ digest กับ revision — ไม่มีค่า attribute ไม่มีเหตุผลแบบ free text เพราะ mismatch
/// report เป็นของที่คนจะเปิดดูตอน incident และไม่ควรกลายเป็นช่องรั่วของ PII
model JrSegmentShadowMismatch {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  contactId          String   @map("contact_id") @db.Uuid
  segmentId          String   @map("segment_id")
  membershipRevision Int      @map("membership_revision")
  mismatchKind       String   @map("mismatch_kind")
  expectedDigest     String?  @map("expected_digest") @db.Char(64)
  observedDigest     String?  @map("observed_digest") @db.Char(64)
  detectedAt         DateTime @default(now()) @map("detected_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  contact Contact @relation(fields: [tenantId, contactId], references: [tenantId, id])

  @@unique([tenantId, contactId, segmentId, membershipRevision, mismatchKind])
  @@index([tenantId, detectedAt])
  @@map("jr_segment_shadow_mismatches")
}

// ─────────────────────────────── J2.4: Cases ENSURE_CASE owner ───────────────────────────────
// Cases เป็น canonical writer เต็มรูปแบบของ cs_* ทั้งหมด — Journey ไม่มี direct database
// access และไม่เลือก caseId เอง (ตาม #121); ที่นี่เป็น minimal slice สำหรับ ENSURE_CASE
// เท่านั้น ไม่ใช่ full task/SLA product (ดู #132 ขอบเขต J2.4)

enum CsCaseStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum CsActivityKind {
  CREATED
  LINKED
  REOPENED
}

/// tenant-scoped fixture: caseTypePolicyRef (จาก J2 intent) แม็พไปยัง case type จริง
/// และ reopen policy — ไม่ใช่ metadata-driven ประเภทเต็มรูปแบบตาม C2 ของ product spec
model CsCaseTypePolicy {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  policyRef     String   @map("policy_ref")
  caseTypeKey   String   @map("case_type_key")
  reopenAllowed Boolean  @default(false) @map("reopen_allowed")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, policyRef])
  @@map("cs_case_type_policies")
}

/// tenant-scoped fixture: routingPolicyRef แม็พไปยัง queue — ไม่มี router assignment
/// runtime จริงใน J2.4 (out of scope)
model CsRoutingPolicy {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  policyRef String   @map("policy_ref")
  queueRef  String   @map("queue_ref")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, policyRef])
  @@map("cs_routing_policies")
}

/// minimal canonical Case — version เพิ่มทุก mutation เพื่อใช้เป็น ownerAggregate.version
/// ใน J2OwnerResultPayloadV1; ไม่มี type metadata/SLA/queue เต็มรูปแบบตาม C1-C3 product spec
model CsCase {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  contactId   String       @map("contact_id") @db.Uuid
  caseTypeKey String       @map("case_type_key")
  routingRef  String?      @map("routing_ref")
  status      CsCaseStatus @default(OPEN)
  version     Int          @default(1)
  reopenCount Int          @default(0) @map("reopen_count")
  resolvedAt  DateTime?    @map("resolved_at")
  closedAt    DateTime?    @map("closed_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  contact Contact @relation(fields: [tenantId, contactId], references: [tenantId, id])

  @@index([tenantId, contactId, caseTypeKey, status])
  @@map("cs_cases")
}

/// closed-case correction: ห้าม reopen เงียบ ๆ — เปิดเคสใหม่แล้วเชื่อม RELATED กับเคสเดิม
model CsCaseLink {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  caseId        String   @map("case_id") @db.Uuid
  relatedCaseId String   @map("related_case_id") @db.Uuid
  kind          String   @default("RELATED")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, caseId, relatedCaseId, kind])
  @@map("cs_case_links")
}

/// ไทม์ไลน์ของ ENSURE_CASE effect หนึ่งรายการ — opaque reference เท่านั้น ไม่มี raw
/// contact data, transcript หรือ free text
model CsCaseActivity {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  caseId         String         @map("case_id") @db.Uuid
  kind           CsActivityKind
  interactionId  String         @map("interaction_id")
  outcomeType    String         @map("outcome_type")
  outcomeId      String         @map("outcome_id") @db.Uuid
  outcomeVersion Int            @map("outcome_version")
  correlationId  String         @map("correlation_id")
  occurredAt     DateTime       @default(now()) @map("occurred_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, caseId, occurredAt])
  @@map("cs_case_activities")
}

/// durable command+result เดียวกันต่อ actionKey — J2OwnerPort เป็น pull model
/// (queryAction อ่านจากที่นี่) จึงไม่ต้องมี outbox/relay แยกสำหรับผล ENSURE_CASE
model CsCommandInbox {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  commandId        String   @map("command_id")
  actionKey        String   @map("action_key")
  requestHash      String   @map("request_hash") @db.Char(64)
  status           String
  code             String
  category         String
  reasonCode       String   @map("reason_code")
  failureClass     String   @map("failure_class")
  retryDisposition String   @map("retry_disposition")
  caseId           String?  @map("case_id") @db.Uuid
  caseVersion      Int?     @map("case_version")
  correlationId    String   @map("correlation_id")
  observedAt       DateTime @map("observed_at")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, actionKey])
  @@index([tenantId, commandId])
  @@map("cs_command_inbox")
}

enum JrJourneyDefinitionStatus {
  DRAFT
  PUBLISHED
}

/// C1.4: หนึ่งแถวต่อหนึ่ง version ของ Journey definition แบบ immutable — เนื้อหา
/// (trigger/graph/goal/exitRules/maxDurationDays) ไม่ถูกแก้หลังสร้าง; publish เป็นเพียง
/// state transition DRAFT -> PUBLISHED ที่ idempotent ต่อ (tenantId, journeyId, version)
model JrJourneyDefinition {
  id               String                    @id @default(uuid()) @db.Uuid
  tenantId         String                    @map("tenant_id") @db.Uuid
  journeyId        String                    @map("journey_id") @db.Uuid
  version          Int
  name             String
  ownerTeamId      String                    @map("owner_team_id") @db.Uuid
  /// consent/policy purpose (เช่น MARKETING, SERVICE) ที่ SEND ทุกโหนดในเวอร์ชันนี้ใช้เรียก
  /// authorizeAndReserve — C1.6 อ่านค่านี้แทนการให้แต่ละ SEND step ประกาศเอง
  purpose          String
  /// sender identity ที่ผูกกับ delivery binding — C1 เป็น TEST_ADAPTER เท่านั้น
  senderIdentityId String                    @map("sender_identity_id")
  status           JrJourneyDefinitionStatus @default(DRAFT)
  trigger          Json
  graph            Json
  goal             Json
  exitRules        Json                      @map("exit_rules")
  maxDurationDays  Int                       @map("max_duration_days")
  inputHash        String                    @map("input_hash")
  correlationId    String                    @map("correlation_id")
  publishedAt      DateTime?                 @map("published_at")
  createdAt        DateTime                  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, id])
  @@unique([tenantId, journeyId, version])
  @@index([tenantId, journeyId, status])
  @@map("jr_journey_definitions")
}

// ─────────────────────────── Delivery outbox (Channels/Dialer) ───────────────────────────

enum DlDeliveryState {
  QUEUED
  SUBMITTING
  SUBMITTED
  RECONCILING
  SETTLED
}

/// C1 เปิดเฉพาะ TEST_ADAPTER; provider จริงต้องผ่าน certification ก่อนเพิ่มค่าใหม่
enum DlDeliveryAdapter {
  TEST_ADAPTER
}

/// C1.3: durable outbox ของ Channels/Dialer — หนึ่งแถวต่อหนึ่ง delivery ที่ claim สำเร็จแล้ว
/// row ถูก persist ก่อนตอบ QUEUED เสมอ และ `(tenant_id, action_key)` เป็น idempotency identity
/// เดียวของ adapter: input เดิมเล่นซ้ำ delivery เดิม, input ต่างเป็น conflict
/// เก็บได้เฉพาะ opaque id/ref — ห้าม message body, phone, email หรือ external contact reference
model DlOutboxEntry {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  actionKey          String            @map("action_key")
  reservationId      String            @map("reservation_id") @db.Uuid
  deliveryId         String            @map("delivery_id")
  providerRequestKey String            @map("provider_request_key")
  adapter            DlDeliveryAdapter @default(TEST_ADAPTER)
  channel            ChannelType
  contactId          String            @map("contact_id") @db.Uuid
  identityId         String?           @map("identity_id") @db.Uuid
  purpose            String
  source             String
  senderIdentityId   String            @map("sender_identity_id")
  /// reference ที่ channel owner resolve เป็นเนื้อหา — ไม่ใช่เนื้อหาเอง
  contentRef         String            @map("content_ref")
  inputHash          String            @map("input_hash")
  state              DlDeliveryState   @default(QUEUED)
  /// lease ที่ claim คืนมา ใช้เป็น expected version ของ beginProviderSubmission
  leaseVersion       Int               @map("lease_version")
  leaseExpiresAt     DateTime          @map("lease_expires_at")
  submittedAt        DateTime?         @map("submitted_at")
  outcome            CgFactOutcome?
  outcomeRef         String?           @map("outcome_ref")
  settledAt          DateTime?         @map("settled_at")
  correlationId      String            @map("correlation_id")
  causationId        String?           @map("causation_id")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  reservation CgReservation @relation(fields: [tenantId, reservationId], references: [tenantId, id], map: "dl_outbox_entries_tenant_reservation_fkey")

  @@unique([tenantId, actionKey], map: "dl_outbox_entries_tenant_action_key")
  @@unique([tenantId, deliveryId], map: "dl_outbox_entries_tenant_delivery_key")
  @@unique([tenantId, providerRequestKey], map: "dl_outbox_entries_tenant_provider_request_key")
  @@unique([tenantId, outcomeRef], map: "dl_outbox_entries_tenant_outcome_ref_key")
  @@index([tenantId, state, leaseExpiresAt], map: "dl_outbox_entries_tenant_state_lease_expiry_idx")
  @@map("dl_outbox_entries")
}

// ─────────────────────────── Interactions (record กลางทุก channel) ───────────────────────────

enum Direction {
  INBOUND
  OUTBOUND
}

enum InteractionStateType {
  QUEUED
  ASSIGNED
  ACTIVE
  WRAPUP
  COMPLETED
  ABANDONED
}

enum IvrInputStage {
  VOICE
  DTMF
}

model Interaction {
  id                        String               @id @default(uuid()) @db.Uuid
  tenantId                  String               @map("tenant_id") @db.Uuid
  channel                   ChannelType
  direction                 Direction
  state                     InteractionStateType @default(QUEUED)
  queueId                   String?              @map("queue_id") @db.Uuid
  agentId                   String?              @map("agent_id") @db.Uuid
  contactId                 String?              @map("contact_id") @db.Uuid
  // thread ที่งานนี้เกิดขึ้น — null สำหรับ voice (ADR-023)
  conversationId            String?              @map("conversation_id") @db.Uuid
  // งานนี้เกิดจากลูกค้าพิมพ์กลับภายใน reopen window ของงานใบไหน (ADR-023 ข้อ 4)
  // งานเดิมไม่ถูกแก้เลย — AHT/SLA/billing ย้อนหลังจึงไม่เปลี่ยน
  reopenedFromInteractionId String?              @map("reopened_from_interaction_id") @db.Uuid
  // id ฝั่งระบบภายนอก เช่น FreeSWITCH call UUID
  externalId                String?              @map("external_id")
  wrapUpCode                String?              @map("wrap_up_code")
  metadata                  Json?

  queuedAt          DateTime       @default(now()) @map("queued_at")
  assignedAt        DateTime?      @map("assigned_at")
  answeredAt        DateTime?      @map("answered_at")
  endedAt           DateTime?      @map("ended_at")
  offerExpiresAt    DateTime?      @map("offer_expires_at")
  requeueAt         DateTime?      @map("requeue_at")
  ivrDestinationId  String?        @map("ivr_destination_id") @db.Uuid
  ivrStage          IvrInputStage? @map("ivr_stage")
  ivrAttempts       Int            @default(0) @map("ivr_attempts")
  ivrInputExpiresAt DateTime?      @map("ivr_input_expires_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  queue               Queue?               @relation(fields: [queueId], references: [id])
  agent               User?                @relation(fields: [agentId], references: [id])
  contact             Contact?             @relation(fields: [contactId], references: [id])
  conversation        Conversation?        @relation(fields: [conversationId], references: [id])
  reopenedFrom        Interaction?         @relation("InteractionReopenChain", fields: [reopenedFromInteractionId], references: [id])
  reopenedBy          Interaction[]        @relation("InteractionReopenChain")
  events              InteractionEvent[]
  messages            Message[]
  recordings          Recording[]
  qmTranscriptionJobs QmTranscriptionJob[]
  qmTranscripts       QmTranscript[]
  qmEvaluations       QmEvaluation[]
  qmConsoleContexts   QmConsoleContext[]

  @@unique([tenantId, externalId])
  @@index([tenantId, queuedAt])
  @@index([tenantId, conversationId, queuedAt])
  @@index([tenantId, reopenedFromInteractionId])
  @@index([tenantId, ivrInputExpiresAt])
  @@map("interactions")
}

// append-only event log — source of truth สำหรับ historical reporting
model InteractionEvent {
  id            BigInt   @id @default(autoincrement())
  tenantId      String   @map("tenant_id") @db.Uuid
  interactionId String   @map("interaction_id") @db.Uuid
  type          String
  payload       Json?
  createdAt     DateTime @default(now()) @map("created_at")

  interaction Interaction @relation(fields: [interactionId], references: [id])

  @@index([tenantId, interactionId])
  @@index([tenantId, createdAt])
  @@map("interaction_events")
}

// ─────────────────────────── Conversations (chat/social/email threads) ───────────────────────────

// สถานะของ "ห้อง" ไม่ใช่ของงาน — ดู ADR-023
enum ConversationState {
  OPEN // มีงานที่ยังทำอยู่
  IDLE // ไม่มีงานค้าง แต่ลูกค้าพิมพ์กลับมาได้ตลอด
  RESOLVED // ปิดเรื่องล่าสุดแล้ว (พิมพ์กลับมาได้ → เข้ากติกา reopen window)
  BLOCKED // บล็อกโดยผู้ดูแล — ข้อความเข้าไม่สร้างงาน (สิทธิ์หัวหน้าขึ้นไป + audit)
}

/// thread ถาวรกับลูกค้าหนึ่งคนบนหนึ่งช่องทาง — มีหลาย Interaction อ้างถึงได้ (ADR-023)
/// voice ไม่มี conversation (Interaction.conversationId = null)
model Conversation {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  channel          ChannelType
  contactId        String?           @map("contact_id") @db.Uuid
  // บัญชีช่องทางที่รับ webhook นี้ (LINE OA id / FB Page id / WA phone-number-id / widget id / mailbox id)
  // ต้อง NOT NULL เพราะ Postgres ไม่บังคับ unique ให้แถวที่คอลัมน์เป็น NULL — id ฝั่ง provider scope ต่อ account
  channelAccountId String            @map("channel_account_id")
  // thread id ฝั่ง platform เช่น LINE conversation, email Message-ID chain
  externalThreadId String            @map("external_thread_id")
  state            ConversationState @default(OPEN)

  lastCustomerMessageAt DateTime? @map("last_customer_message_at")
  lastAgentMessageAt    DateTime? @map("last_agent_message_at")
  // ปิดงานล่าสุดเมื่อไหร่ — ใช้ตัดสิน reopen window (ADR-023 ข้อ 4)
  lastResolvedAt        DateTime? @map("last_resolved_at")
  blockedReason         String?   @map("blocked_reason")
  createdAt             DateTime  @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  contact      Contact?      @relation(fields: [contactId], references: [id])
  interactions Interaction[]
  messages     Message[]

  @@unique([tenantId, channel, channelAccountId, externalThreadId])
  @@index([tenantId, state, lastCustomerMessageAt])
  @@index([tenantId, contactId])
  @@map("conversations")
}

enum SenderType {
  CONTACT
  AGENT
  SYSTEM
}

/// สถานะการส่ง — แยกจากเนื้อหาข้อความ (ADR-024)
enum MessageDeliveryStatus {
  RECEIVED // ขาเข้า: รับจาก provider แล้ว
  QUEUED // ขาออก: รอ worker หยิบไปส่ง (แถวนี้คือ outbox)
  SENDING
  SENT // provider รับไปแล้ว
  DELIVERED // ถึงเครื่องลูกค้า (provider แจ้งกลับ)
  READ
  FAILED // ครบจำนวนครั้งแล้วยังไม่สำเร็จ
}

model Message {
  id               String     @id @default(uuid()) @db.Uuid
  tenantId         String     @map("tenant_id") @db.Uuid
  conversationId   String     @map("conversation_id") @db.Uuid
  // บัญชีช่องทางที่รับ/ส่งข้อความนี้ — denormalize มาไว้ที่นี่เพราะ dedupe ต้องทำ
  // "ก่อน" resolve thread คีย์จึงต้องประกอบจากสิ่งที่รู้ตอน webhook เข้าเท่านั้น (ADR-024 ข้อ 2)
  channelAccountId String     @map("channel_account_id")
  // งานชิ้นไหนเป็นเจ้าของข้อความนี้ — null = เข้ามาตอนยังไม่มีงาน (บอตคุยอยู่) · ADR-023 ข้อ 3
  interactionId    String?    @map("interaction_id") @db.Uuid
  senderType       SenderType @map("sender_type")
  direction        Direction
  contentType      String     @default("text/plain") @map("content_type")
  body             String

  // ── idempotency สองทาง (ADR-024) ──
  // ขาเข้า: id จาก "ระบบผู้รับ" เท่านั้น ห้ามเป็นค่าที่ผู้ส่งกำหนด (ADR-024 ข้อ 2)
  // LINE message.id · Messenger mid · WhatsApp wamid · อีเมล = UIDVALIDITY:UID ของ mailbox
  providerMessageId String? @map("provider_message_id")
  // ขาออก: token จากผู้สั่งส่ง — กัน Kafka at-least-once ทำให้ลูกค้าได้ข้อความซ้ำ
  clientToken       String? @map("client_token")

  status        MessageDeliveryStatus @default(RECEIVED)
  attempts      Int                   @default(0)
  nextAttemptAt DateTime?             @map("next_attempt_at")
  // claim ของ outbox worker — SELECT … FOR UPDATE SKIP LOCKED + lease (ADR-024 ข้อ 3)
  lockedAt      DateTime?             @map("locked_at")
  lockedBy      String?               @map("locked_by")
  failureCode   String?               @map("failure_code")
  failureReason String?               @map("failure_reason")

  sentAt      DateTime? @map("sent_at")
  deliveredAt DateTime? @map("delivered_at")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  conversation Conversation        @relation(fields: [conversationId], references: [id])
  interaction  Interaction?        @relation(fields: [interactionId], references: [id])
  attachments  MessageAttachment[]

  @@unique([tenantId, channelAccountId, providerMessageId])
  @@unique([tenantId, clientToken])
  @@index([tenantId, conversationId, createdAt])
  @@index([tenantId, interactionId])
  // outbox scan: หยิบงานที่ถึงเวลาส่ง/ลองใหม่
  @@index([status, nextAttemptAt])
  @@map("messages")
}

/// ไฟล์แนบฝั่งลูกค้า — URL ของ provider หมดอายุ จึงต้องดึงมาเก็บทันทีที่ webhook เข้า (ADR-024)
enum MediaScanStatus {
  PENDING_FETCH // ยังไม่ได้ดึงจาก provider
  PENDING_SCAN // ดึงมาแล้ว รอสแกน — ดาวน์โหลดไม่ได้
  CLEAN
  INFECTED // กักไว้ ไม่ลบ (เป็นหลักฐาน) แต่ห้ามเปิด
  FETCH_FAILED // ดึงไม่ทันก่อน URL หมดอายุ
}

model MessageAttachment {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  messageId   String          @map("message_id") @db.Uuid
  fileName    String          @map("file_name")
  mime        String
  bytes       Int
  // URL ต้นทางจาก provider — เก็บไว้เพื่อสืบสวนเท่านั้น ใช้เปิดไม่ได้เพราะหมดอายุ
  providerUrl String?         @map("provider_url")
  // media/{tenantId}/{yyyy}/{id} — null ถ้ายังดึงไม่สำเร็จ
  storageKey  String?         @map("storage_key")
  thumbKey    String?         @map("thumb_key")
  scanStatus  MediaScanStatus @default(PENDING_FETCH) @map("scan_status")
  fetchedAt   DateTime?       @map("fetched_at")
  createdAt   DateTime        @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id])

  @@index([tenantId, messageId])
  @@index([scanStatus, createdAt])
  @@map("message_attachments")
}

// ─────────────────────────── Recordings ───────────────────────────

enum RecordingChannelLayout {
  PER_LEG
  STEREO
}

enum RecordingAuditAction {
  PAUSED
  RESUMED
  PLAYBACK_URL_ISSUED
  PLAYBACK_ACCESSED
  DOWNLOAD_DENIED
  RETENTION_DELETED
  LEGAL_HOLD_PLACED
  LEGAL_HOLD_RELEASED
}

model Recording {
  id             String                 @id @default(uuid()) @db.Uuid
  tenantId       String                 @map("tenant_id") @db.Uuid
  interactionId  String                 @map("interaction_id") @db.Uuid
  // key ใน object storage (MinIO/S3)
  storageKey     String                 @map("storage_key")
  // path บน telephony node สำหรับคำสั่ง pause/resume; ไม่เปิดให้ browser ใช้
  telephonyPath  String                 @map("telephony_path")
  channelLayout  RecordingChannelLayout @default(STEREO) @map("channel_layout")
  pauseIntervals Json                   @default("[]") @map("pause_intervals")
  durationSec    Int?                   @map("duration_sec")
  startedAt      DateTime               @map("started_at")
  endedAt        DateTime?              @map("ended_at")
  archivedAt     DateTime?              @map("archived_at")
  deletedAt      DateTime?              @map("deleted_at")

  interaction         Interaction           @relation(fields: [interactionId], references: [id])
  auditEvents         RecordingAuditEvent[]
  legalHolds          RecordingLegalHold[]
  qmTranscriptionJobs QmTranscriptionJob[]
  qmTranscripts       QmTranscript[]

  @@unique([tenantId, interactionId])
  @@index([tenantId, interactionId])
  @@index([tenantId, deletedAt])
  @@map("recordings")
}

model RecordingAuditEvent {
  id          String               @id @default(uuid()) @db.Uuid
  tenantId    String               @map("tenant_id") @db.Uuid
  recordingId String               @map("recording_id") @db.Uuid
  actorUserId String?              @map("actor_user_id") @db.Uuid
  action      RecordingAuditAction
  reason      String?
  details     Json                 @default("{}")
  createdAt   DateTime             @default(now()) @map("created_at")

  recording Recording @relation(fields: [recordingId], references: [id])

  @@index([tenantId, recordingId, createdAt])
  @@map("recording_audit_events")
}

model RecordingLegalHold {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  recordingId      String    @map("recording_id") @db.Uuid
  reason           String
  placedByUserId   String    @map("placed_by_user_id") @db.Uuid
  placedAt         DateTime  @default(now()) @map("placed_at")
  releasedByUserId String?   @map("released_by_user_id") @db.Uuid
  releasedAt       DateTime? @map("released_at")

  recording Recording @relation(fields: [recordingId], references: [id])

  @@index([tenantId, recordingId, releasedAt])
  @@map("recording_legal_holds")
}

// ─────────────────────────── Quality Management ───────────────────────────

enum QmTranscriptionStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum QmTranscriptionTrigger {
  AUTOMATIC
  MANUAL
}

enum QmAuditAction {
  TRANSCRIPTION_REQUESTED
  TRANSCRIPTION_STARTED
  TRANSCRIPTION_RETRY_SCHEDULED
  TRANSCRIPTION_FAILED
  TRANSCRIPTION_READY
  AUTO_QM_DRAFT_CREATED
  TRANSCRIPT_ACCESSED
  EVALUATION_PUBLISHED
}

enum QmTranscriptSpeaker {
  AGENT
  CONTACT
  SYSTEM
  IVR
}

enum QmEvaluationSource {
  AUTO_DRAFT
  HUMAN
}

enum QmEvaluationStatus {
  DRAFT
  PUBLISHED
}

model QmTranscriptionJob {
  id            String                 @id @default(uuid()) @db.Uuid
  tenantId      String                 @map("tenant_id") @db.Uuid
  interactionId String                 @map("interaction_id") @db.Uuid
  recordingId   String                 @map("recording_id") @db.Uuid
  sourceEventId String?                @map("source_event_id") @db.Uuid
  status        QmTranscriptionStatus  @default(PENDING)
  trigger       QmTranscriptionTrigger
  languageHint  String                 @map("language_hint")
  attempts      Int                    @default(0)
  maxAttempts   Int                    @map("max_attempts")
  nextAttemptAt DateTime?              @map("next_attempt_at")
  dispatchedAt  DateTime?              @map("dispatched_at")
  failureCode   String?                @map("failure_code")
  failureReason String?                @map("failure_reason")
  providerId    String?                @map("provider_id")
  startedAt     DateTime?              @map("started_at")
  completedAt   DateTime?              @map("completed_at")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  interaction Interaction   @relation(fields: [interactionId], references: [id])
  recording   Recording     @relation(fields: [recordingId], references: [id])
  transcript  QmTranscript?

  @@unique([tenantId, interactionId])
  @@index([status, nextAttemptAt, createdAt])
  @@index([tenantId, status, createdAt])
  @@map("qm_transcription_jobs")
}

model QmTranscript {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  interactionId String   @map("interaction_id") @db.Uuid
  recordingId   String   @map("recording_id") @db.Uuid
  jobId         String   @unique @map("job_id") @db.Uuid
  providerId    String   @map("provider_id")
  modelId       String   @map("model_id")
  language      String
  confidenceAvg Float    @map("confidence_avg")
  baseline      Json
  createdAt     DateTime @default(now()) @map("created_at")

  tenant      Tenant                @relation(fields: [tenantId], references: [id])
  interaction Interaction           @relation(fields: [interactionId], references: [id])
  recording   Recording             @relation(fields: [recordingId], references: [id])
  job         QmTranscriptionJob    @relation(fields: [jobId], references: [id])
  segments    QmTranscriptSegment[]

  @@unique([tenantId, interactionId, providerId, modelId])
  @@index([tenantId, interactionId, createdAt])
  @@map("qm_transcripts")
}

model QmTranscriptSegment {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  transcriptId String              @map("transcript_id") @db.Uuid
  speaker      QmTranscriptSpeaker
  startMs      Int                 @map("start_ms")
  endMs        Int                 @map("end_ms")
  text         String
  confidence   Float?

  transcript QmTranscript @relation(fields: [transcriptId], references: [id])

  @@index([tenantId, transcriptId, startMs])
  @@map("qm_transcript_segments")
}

model QmEvaluation {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @map("tenant_id") @db.Uuid
  interactionId String             @map("interaction_id") @db.Uuid
  agentId       String             @map("agent_id") @db.Uuid
  evaluatorId   String?            @map("evaluator_id") @db.Uuid
  source        QmEvaluationSource @default(AUTO_DRAFT)
  status        QmEvaluationStatus @default(DRAFT)
  providerId    String             @map("provider_id")
  modelId       String             @map("model_id")
  promptVersion String             @map("prompt_version")
  answers       Json
  publishedAt   DateTime?          @map("published_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  interaction Interaction @relation(fields: [interactionId], references: [id])

  @@unique([tenantId, interactionId, source])
  @@index([tenantId, agentId, status])
  @@map("qm_evaluations")
}

/// opaque context สำหรับเปิด Console ข้ามแอป: URL ไม่มี Interaction ID หรือ token
model QmConsoleContext {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  interactionId   String   @map("interaction_id") @db.Uuid
  issuedForUserId String   @map("issued_for_user_id") @db.Uuid
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  interaction Interaction @relation(fields: [interactionId], references: [id])

  @@index([tenantId, issuedForUserId, expiresAt])
  @@index([tenantId, interactionId, expiresAt])
  @@map("qm_console_contexts")
}

/// receipt durable สำหรับ retry ของ remote mutation: commandId เดิมห้ามทำ side effect ซ้ำ
model CommandReceipt {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  commandId   String   @map("command_id") @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  action      String
  resourceId  String   @map("resource_id") @db.Uuid
  result      Json
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, commandId])
  @@index([tenantId, resourceId, createdAt])
  @@map("command_receipts")
}

model QmAuditEvent {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  actorUserId  String?       @map("actor_user_id") @db.Uuid
  action       QmAuditAction
  resourceType String        @map("resource_type")
  resourceId   String        @map("resource_id") @db.Uuid
  details      Json          @default("{}")
  createdAt    DateTime      @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, resourceType, resourceId, createdAt])
  @@map("qm_audit_events")
}

// ─────────────────────────── Administration / IAM ───────────────────────────

enum IamScopePermission {
  WORK
  CONTACT
}

enum IamScopeProjectionState {
  IN
  OUT
  INVALIDATED
}

enum IamScopeOutboxState {
  PENDING
  PUBLISHED
  FAILED
}

enum IamScopeInvalidationKind {
  GRANTED
  REVOKED
  TEAM_DEACTIVATED
  DELEGATION_REVOKED
}

model IamTeamSegmentScopeGrant {
  id           String             @id @db.Uuid
  tenantId     String             @map("tenant_id") @db.Uuid
  teamId       String             @map("team_id") @db.Uuid
  segmentId    String             @map("segment_id")
  permission   IamScopePermission
  grantVersion Int                @map("grant_version")
  startsAt     DateTime           @default(now()) @map("starts_at")
  createdAt    DateTime           @default(now()) @map("created_at")

  @@unique([tenantId, id])
  @@index([tenantId, teamId, segmentId, permission])
  @@map("iam_team_segment_scope_grants")
}

/// Mutable head only; grant and revocation rows remain append-only audit evidence.
model IamTeamSegmentScopeActiveGrant {
  tenantId   String             @map("tenant_id") @db.Uuid
  teamId     String             @map("team_id") @db.Uuid
  segmentId  String             @map("segment_id")
  permission IamScopePermission
  grantId    String             @map("grant_id") @db.Uuid
  updatedAt  DateTime           @updatedAt @map("updated_at")

  @@id([tenantId, teamId, segmentId, permission])
  @@unique([tenantId, grantId])
  @@map("iam_team_segment_scope_active_grants")
}

model IamTeamSegmentScopeRevocation {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  grantId      String   @map("grant_id") @db.Uuid
  scopeVersion Int      @map("scope_version")
  reasonCode   String   @map("reason_code")
  revokedAt    DateTime @default(now()) @map("revoked_at")

  @@unique([tenantId, id])
  @@unique([tenantId, grantId])
  @@map("iam_team_segment_scope_revocations")
}

model IamTeamScopeVersion {
  tenantId     String   @map("tenant_id") @db.Uuid
  teamId       String   @map("team_id") @db.Uuid
  scopeVersion Int      @default(0) @map("scope_version")
  updatedAt    DateTime @default(now()) @map("updated_at")

  @@id([tenantId, teamId])
  @@map("iam_team_scope_versions")
}

model IamContactSegmentScopeProjection {
  tenantId          String                  @map("tenant_id") @db.Uuid
  contactId         String                  @map("contact_id") @db.Uuid
  segmentId         String                  @map("segment_id")
  state             IamScopeProjectionState
  membershipRevision Int                    @map("membership_revision")
  entryId           String?                 @map("entry_id")
  sourceEventId     String                  @map("source_event_id")
  sourceOccurredAt  DateTime                @map("source_occurred_at")
  updatedAt         DateTime                @default(now()) @map("updated_at")

  @@id([tenantId, contactId, segmentId])
  @@map("iam_contact_segment_scope_projection")
}

model IamScopeInvalidationOutbox {
  id           String                   @id @db.Uuid
  tenantId     String                   @map("tenant_id") @db.Uuid
  teamId       String                   @map("team_id") @db.Uuid
  eventId      String                   @map("event_id")
  scopeVersion Int                      @map("scope_version")
  kind         IamScopeInvalidationKind
  payload      Json
  payloadHash  String                   @map("payload_hash") @db.Char(64)
  state        IamScopeOutboxState      @default(PENDING)
  attempts     Int                      @default(0)
  availableAt  DateTime                 @default(now()) @map("available_at")
  publishedAt  DateTime?                @map("published_at")
  createdAt    DateTime                 @default(now()) @map("created_at")

  @@unique([tenantId, id])
  @@unique([tenantId, eventId])
  @@index([tenantId, state, availableAt, createdAt])
  @@map("iam_scope_invalidation_outbox")
}

model IamScopeConsumerInbox {
  consumerGroup String   @map("consumer_group")
  tenantId      String   @map("tenant_id") @db.Uuid
  eventId       String   @map("event_id")
  completedAt   DateTime @default(now()) @map("completed_at")

  @@id([consumerGroup, tenantId, eventId])
  @@map("iam_scope_consumer_inbox")
}
