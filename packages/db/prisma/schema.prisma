model IntServiceCapabilityRevocation {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  grantId          String   @map("grant_id") @db.Uuid
  evidenceRef      String   @map("evidence_ref")
  reasonCode       String   @map("reason_code")
  actorIdentityKey String   @map("actor_identity_key")
  commandId        String   @map("command_id") @db.Uuid
  revokedAt        DateTime @default(dbgenerated("clock_timestamp()")) @map("revoked_at") @db.Timestamptz(6)

  @@unique([tenantId, grantId])
  @@map("int_service_capability_revocations")
}

model IntServiceContactGrant {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  principalId      String   @map("principal_id") @db.Uuid
  contactId        String   @map("contact_id") @db.Uuid
  permission       String
  evidenceRef      String   @map("evidence_ref")
  actorIdentityKey String   @map("actor_identity_key")
  commandId        String   @map("command_id") @db.Uuid
  grantedAt        DateTime @default(dbgenerated("clock_timestamp()")) @map("granted_at") @db.Timestamptz(6)

  @@unique([tenantId, id])
  @@index([tenantId, principalId], map: "int_service_contact_grantee_idx")
  @@map("int_service_contact_grants")
}

model IntServiceContactRevocation {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  grantId          String   @map("grant_id") @db.Uuid
  evidenceRef      String   @map("evidence_ref")
  reasonCode       String   @map("reason_code")
  actorIdentityKey String   @map("actor_identity_key")
  commandId        String   @map("command_id") @db.Uuid
  revokedAt        DateTime @default(dbgenerated("clock_timestamp()")) @map("revoked_at") @db.Timestamptz(6)

  @@unique([tenantId, grantId])
  @@map("int_service_contact_revocations")
}

/// M3-A: exact owner-purpose ledger before granting INTEGRATION custody; no PII snapshot
model IntServiceCommandEvidence {
  tenantId         String   @map("tenant_id") @db.Uuid
  actorIdentityKey String   @map("actor_identity_key")
  commandId        String   @map("command_id") @db.Uuid
  principalId      String   @map("principal_id") @db.Uuid
  contactId        String   @map("contact_id") @db.Uuid
  purpose          String
  createdAt        DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)

  @@id([tenantId, actorIdentityKey, commandId])
  @@unique([tenantId, contactId])
  @@map("int_service_command_evidence")
}
