  lastError      String?               @map("last_error")
  createdAt      DateTime              @default(now()) @map("created_at")

  @@unique([tenantId, id])
  @@unique([tenantId, policyId, policyVersion])
  @@index([tenantId, state, scheduledFor])
  @@map("cg_policy_activation_job")
}

model Cg4Exception {
  id                  String                @id @default(uuid()) @db.Uuid
  tenantId            String                @map("tenant_id") @db.Uuid
  exceptionId         String                @map("exception_id") @db.Uuid
  revision            Int
  contactId           String                @map("contact_id") @db.Uuid
  identityId          String?               @map("identity_id") @db.Uuid
  scopeKind           Cg4ExceptionScopeKind @map("scope_kind")
  channel             ChannelType
  purpose             String
  sourceType          String                @map("source_type")
  sourceId            String                @map("source_id")
  allowedRuleCodes    String[]              @map("allowed_rule_codes")
  policyId            String                @map("policy_id") @db.Uuid
  policyVersion       Int                   @map("policy_version")
  policyContentDigest String                @map("policy_content_digest") @db.Char(64)
  registryVersion     String                @map("registry_version")
  startsAt            DateTime              @map("starts_at")
  expiresAt           DateTime              @map("expires_at")
  tier                Cg4ExceptionTier
  status              Cg4ExceptionStatus    @default(PENDING)
  reasonCode          String                @map("reason_code")
  ticketRef           String?               @map("ticket_ref")
  evidenceRef         String                @map("evidence_ref")
  actorRef            String                @map("actor_ref")
  requestHash         String                @map("request_hash") @db.Char(64)
  supersedesId        String?               @map("supersedes_id") @db.Uuid
  // CG4.4 (#187): renewal is always a NEW series that points back at the one it renews —
  // never an in-place extension of the original's expiresAt.
  renewsExceptionId   String?               @map("renews_exception_id") @db.Uuid
  createdAt           DateTime              @default(now()) @map("created_at")

  @@unique([tenantId, id])
  @@unique([tenantId, exceptionId, revision])
  @@index([tenantId, contactId, status, expiresAt])
  @@index([tenantId, policyId, policyVersion])
  @@map("cg_exception")
}

model Cg4ExceptionHead {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  exceptionId       String             @map("exception_id") @db.Uuid
  currentRevisionId String             @map("current_revision_id") @db.Uuid
  currentRevision   Int                @map("current_revision")
  status            Cg4ExceptionStatus
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@unique([tenantId, exceptionId])
  @@map("cg_exception_head")
}

// CG4 has its own concurrency head, separate from CgContactStateHead (CG3-owned):
// sharing a head would make the optimistic-concurrency version and digest chain
// of CG3 preference and CG4 exception collide across systems for the same contact.
model Cg4ContactExceptionHead {
  tenantId         String   @map("tenant_id") @db.Uuid
  contactId        String   @map("contact_id") @db.Uuid
  aggregateVersion Int      @default(0) @map("aggregate_version")
  currentDigest    String   @map("current_digest") @db.Char(64)
  latestMutationId String?  @map("latest_mutation_id") @db.Uuid
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@id([tenantId, contactId])
  @@map("cg_exception_contact_head")
}

// See Cg4PolicyApproval for why the columns from `capability` onward exist.
model Cg4ExceptionApproval {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  exceptionId        String              @map("exception_id") @db.Uuid
  exceptionRevision  Int                 @map("exception_revision")
  decision           Cg4ApprovalDecision
  approverRef        String              @map("approver_ref")
  evidenceRef        String              @map("evidence_ref")
  decidedAt          DateTime            @map("decided_at")
  capability         String
  capabilitySource   Cg4CapabilitySource @map("capability_source")
  delegationId       String?             @map("delegation_id") @db.Uuid
  directCompliance   Boolean             @map("direct_compliance")
  emergencyAuthority Boolean             @map("emergency_authority")
  authorizationEpoch Int                 @map("authorization_epoch")
  scopeVersion       Int                 @map("scope_version")
  createdAt          DateTime            @default(now()) @map("created_at")

  @@unique([tenantId, id])
  @@unique([tenantId, exceptionId, exceptionRevision, approverRef])
  @@index([tenantId, exceptionId, exceptionRevision, decidedAt])
  @@map("cg_exception_approval")
}

// CG4.3 (#186): a maker-checker delegation grant per #173 §3 — exact capability, exact
// scope, a maximum risk tier and a hard <=8h window. Append-only: a delegation is never
// edited, only allowed to expire. `capability` is constrained at the DB layer (see
// migration) to the delegable set (cg.exception.request, cg.exception.approve.standard)
// so a stray write can never grant a HIGH/EMERGENCY or policy-publish/rollback capability
// by delegation.
model Cg4Delegation {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  delegatorSubjectId String   @map("delegator_subject_id")
