  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([tenantId, userId])
  @@map("navigation_user_pins")
}

/// D1.12 (#451): audit of changes to the tenant's default pins — append-only for the app role
model NavigationAuditEvent {
