  @@unique([tenantId, eventId], map: "dl_line_audit_events_event_key")
  @@index([tenantId, category, occurredAt], map: "dl_line_audit_events_category_idx")
  @@map("dl_line_audit_events")
}

// ─────────────────────────── Interactions (the central record for every channel) ───────────────────────────

enum Direction {
  INBOUND
  OUTBOUND
}

enum InteractionStateType {
  QUEUED
  ASSIGNED
  ACTIVE
  WRAPUP
  COMPLETED
  ABANDONED
}

enum IvrInputStage {
  VOICE
  DTMF
}

model Interaction {
  id                        String               @id @default(uuid()) @db.Uuid
  tenantId                  String               @map("tenant_id") @db.Uuid
  channel                   ChannelType
  direction                 Direction
  state                     InteractionStateType @default(QUEUED)
  queueId                   String?              @map("queue_id") @db.Uuid
  agentId                   String?              @map("agent_id") @db.Uuid
  contactId                 String?              @map("contact_id") @db.Uuid
  customerLinkRevision      BigInt               @default(0) @map("customer_link_revision")
  // the thread this work arose in — null for voice (ADR-023)
  conversationId            String?              @map("conversation_id") @db.Uuid
  // which work item the customer replied to within the reopen window (ADR-023 item 4)
  // the original work is not edited at all — so historical AHT/SLA/billing does not change
  reopenedFromInteractionId String?              @map("reopened_from_interaction_id") @db.Uuid
  // id on the external system, e.g. the FreeSWITCH call UUID
  externalId                String?              @map("external_id")
  wrapUpCode                String?              @map("wrap_up_code")
  voiceWrapupPolicy         String               @default("LEGACY") @map("voice_wrapup_policy")
  metadata                  Json?

  queuedAt          DateTime       @default(now()) @map("queued_at")
  assignedAt        DateTime?      @map("assigned_at")
  answeredAt        DateTime?      @map("answered_at")
  endedAt           DateTime?      @map("ended_at")
  offerExpiresAt    DateTime?      @map("offer_expires_at")
  requeueAt         DateTime?      @map("requeue_at")
  ivrDestinationId  String?        @map("ivr_destination_id") @db.Uuid
  ivrStage          IvrInputStage? @map("ivr_stage")
  ivrAttempts       Int            @default(0) @map("ivr_attempts")
  ivrInputExpiresAt DateTime?      @map("ivr_input_expires_at")

  tenant              Tenant                     @relation(fields: [tenantId], references: [id])
  queue               Queue?                     @relation(fields: [queueId], references: [id])
  agent               User?                      @relation(fields: [agentId], references: [id])
  contact             Contact?                   @relation(fields: [contactId], references: [id])
  conversation        Conversation?              @relation(fields: [conversationId], references: [id])
  reopenedFrom        Interaction?               @relation("InteractionReopenChain", fields: [reopenedFromInteractionId], references: [id])
  reopenedBy          Interaction[]              @relation("InteractionReopenChain")
  events              InteractionEvent[]
  messages            Message[]
  recordings          Recording[]
  qmTranscriptionJobs QmTranscriptionJob[]
  qmTranscripts       QmTranscript[]
  qmEvaluations       QmEvaluation[]
  qmConsoleContexts   QmConsoleContext[]
  wrapupResults       InteractionWrapupResult[]
  outcomeOutbox       InteractionOutcomeOutbox[]

  @@unique([tenantId, id, agentId])
  @@unique([tenantId, id], map: "interactions_tenant_managed_id")
  @@unique([tenantId, externalId])
  @@index([tenantId, queuedAt])
  @@index([tenantId, conversationId, queuedAt])
  @@index([tenantId, reopenedFromInteractionId])
  @@index([tenantId, ivrInputExpiresAt])
  @@map("interactions")
}

// append-only event log — the source of truth for historical reporting
model InteractionWrapupResult {
  interactionId String      @id @map("interaction_id") @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  ownerAgentId  String      @map("owner_agent_id") @db.Uuid
  policyVersion Int         @default(1) @map("policy_version")
  disposition   String
  note          String
  recordedAt    DateTime    @default(now()) @map("recorded_at") @db.Timestamptz(3)
  commandId     String      @map("command_id") @db.Uuid
  interaction   Interaction @relation(fields: [tenantId, interactionId, ownerAgentId], references: [tenantId, id, agentId], onDelete: NoAction, onUpdate: NoAction, map: "interaction_wrapup_results_owner_fkey")

  @@index([tenantId, ownerAgentId, recordedAt(sort: Desc), interactionId(sort: Desc)], map: "interaction_wrapup_results_owner_recorded_idx")
  @@map("interaction_wrapup_results")
}

/// #1067 transactional outbox of `interaction.outcome_recorded` (J2 contract): the row is written in the
/// same transaction as the wrap-up result and a relay publishes it to dc.interaction.events at-least-once.
/// `id` is the Kafka eventId, so a re-publish is the same event for every consumer
model InteractionOutcomeOutbox {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  interactionId  String    @map("interaction_id") @db.Uuid
  outcomeType    String    @map("outcome_type")
  outcomeId      String    @map("outcome_id") @db.Uuid
  outcomeVersion Int       @map("outcome_version")
  payload        Json
  correlationId  String    @map("correlation_id")
  state          String    @default("PENDING")
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(3)
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  interaction Interaction @relation(fields: [tenantId, interactionId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "interaction_outcome_outbox_interaction_fk")

  @@unique([tenantId, outcomeType, outcomeId, outcomeVersion], map: "interaction_outcome_outbox_outcome_key")
  @@index([tenantId, state, availableAt], map: "interaction_outcome_outbox_pending_idx")
  @@map("interaction_outcome_outbox")
}

model InteractionEvent {
  id            BigInt   @id @default(autoincrement())
  tenantId      String   @map("tenant_id") @db.Uuid
  interactionId String   @map("interaction_id") @db.Uuid
  type          String
  payload       Json?
  createdAt     DateTime @default(now()) @map("created_at")

  interaction Interaction @relation(fields: [interactionId], references: [id])

  @@index([tenantId, interactionId])
  @@index([tenantId, createdAt])
  @@map("interaction_events")
}

// ─────────────────────────── Conversations (chat/social/email threads) ───────────────────────────

// status of the "room", not of the work — see ADR-023
enum ConversationState {
  OPEN // there is work still in progress
  IDLE // no pending work, but the customer can message back at any time
  RESOLVED // the latest matter is closed (a message back falls under the reopen window rule)
  BLOCKED // blocked by an administrator — an incoming message creates no work (supervisor permission and above + audit)
}

/// a permanent thread with one customer on one channel — many Interactions can refer to it (ADR-023)
/// voice has no conversation (Interaction.conversationId = null)
model Conversation {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  channel          ChannelType
  contactId        String?           @map("contact_id") @db.Uuid
  // the channel account that receives this webhook (LINE OA id / FB Page id / WA phone-number-id / widget id / mailbox id)
  // must be NOT NULL because Postgres does not enforce unique on rows whose column is NULL — provider-side ids are scoped per account
  channelAccountId String            @map("channel_account_id")
  // platform-side thread id, e.g. LINE conversation, email Message-ID chain
  externalThreadId String            @map("external_thread_id")
  state            ConversationState @default(OPEN)

  lastCustomerMessageAt DateTime? @map("last_customer_message_at")
  lastAgentMessageAt    DateTime? @map("last_agent_message_at")
  // when the work was last closed — used to decide the reopen window (ADR-023 item 4)
  lastResolvedAt        DateTime? @map("last_resolved_at")
  blockedReason         String?   @map("blocked_reason")
  createdAt             DateTime  @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  contact      Contact?      @relation(fields: [contactId], references: [id])
  interactions Interaction[]
  messages     Message[]

  @@unique([tenantId, channel, channelAccountId, externalThreadId])
  @@index([tenantId, state, lastCustomerMessageAt])
  @@index([tenantId, contactId])
  @@map("conversations")
}

enum SenderType {
  CONTACT
  AGENT
  SYSTEM
}

/// delivery status — separate from the message content (ADR-024)
enum MessageDeliveryStatus {
  RECEIVED // inbound: received from the provider
  QUEUED // outbound: waiting for a worker to pick it up and send (this row is the outbox)
  SENDING
  SENT // accepted by the provider
  DELIVERED // reached the customer's device (the provider reported back)
  READ
  FAILED // retries exhausted without success
}

model Message {
  id               String     @id @default(uuid()) @db.Uuid
  tenantId         String     @map("tenant_id") @db.Uuid
  conversationId   String     @map("conversation_id") @db.Uuid
  // the channel account that received/sent this message — denormalized here because dedupe must run
  // "before" resolving the thread, so the key must be built only from what is known when the webhook arrives (ADR-024 item 2)
  channelAccountId String     @map("channel_account_id")
  // which work item owns this message — null = arrived while there was no work (a bot is chatting) · ADR-023 item 3
  interactionId    String?    @map("interaction_id") @db.Uuid
  senderType       SenderType @map("sender_type")
  direction        Direction
  contentType      String     @default("text/plain") @map("content_type")
  body             String

  // ── two-way idempotency (ADR-024) ──
  // inbound: an id from the "receiving system" only, never a value set by the sender (ADR-024 item 2)
  // LINE message.id · Messenger mid · WhatsApp wamid · email = UIDVALIDITY:UID of the mailbox
  providerMessageId String? @map("provider_message_id")
  // outbound: a token from whoever ordered the send — prevents Kafka at-least-once from giving the customer a duplicate message
  clientToken       String? @map("client_token")

  status        MessageDeliveryStatus @default(RECEIVED)
  attempts      Int                   @default(0)
  nextAttemptAt DateTime?             @map("next_attempt_at")
  // claim by the outbox worker — SELECT … FOR UPDATE SKIP LOCKED + lease (ADR-024 item 3)
  lockedAt      DateTime?             @map("locked_at")
  lockedBy      String?               @map("locked_by")
  failureCode   String?               @map("failure_code")
  failureReason String?               @map("failure_reason")

  sentAt      DateTime? @map("sent_at")
  deliveredAt DateTime? @map("delivered_at")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  conversation Conversation        @relation(fields: [conversationId], references: [id])
  interaction  Interaction?        @relation(fields: [interactionId], references: [id])
  attachments  MessageAttachment[]

  @@unique([tenantId, channelAccountId, providerMessageId])
  @@unique([tenantId, clientToken])
  @@index([tenantId, conversationId, createdAt])
  @@index([tenantId, interactionId])
  // outbox scan: pick up work that is due to send/retry
  @@index([status, nextAttemptAt])
  @@map("messages")
}

/// customer-side attachment — the provider's URL expires, so it must be fetched and stored as soon as the webhook arrives (ADR-024)
enum MediaScanStatus {
  PENDING_FETCH // not yet fetched from the provider
  PENDING_SCAN // fetched, awaiting scan — cannot be downloaded
  CLEAN
  INFECTED // quarantined, not deleted (it is evidence) but must not be opened
  FETCH_FAILED // could not fetch before the URL expired
}

model MessageAttachment {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  messageId   String          @map("message_id") @db.Uuid
  fileName    String          @map("file_name")
  mime        String
  bytes       Int
  // source URL from the provider — kept for investigation only, cannot be opened because it has expired
  providerUrl String?         @map("provider_url")
  // media/{tenantId}/{yyyy}/{id} — null if not fetched successfully yet
  storageKey  String?         @map("storage_key")
  thumbKey    String?         @map("thumb_key")
  scanStatus  MediaScanStatus @default(PENDING_FETCH) @map("scan_status")
  fetchedAt   DateTime?       @map("fetched_at")
  createdAt   DateTime        @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id])

  @@index([tenantId, messageId])
  @@index([scanStatus, createdAt])
  @@map("message_attachments")
}

// ─────────────────────────── Web chat (#1044) ───────────────────────────

/// #1044 the web chat widget of a tenant; round one allows one per tenant. FKs are declared in the migration
model WebchatWidget {
  tenantId         String   @map("tenant_id") @db.Uuid
  id               String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enabled          Boolean  @default(false)
  queueId          String?  @map("queue_id") @db.Uuid
  /// exact origins (scheme://host[:port]) allowed to embed the widget
  allowedOrigins   String[] @default([]) @map("allowed_origins")
  greetingTh       String   @default("") @map("greeting_th")
  greetingEn       String   @default("") @map("greeting_en")
  maxChatsPerAgent Int      @default(3) @map("max_chats_per_agent")
  idleTimeoutSec   Int      @default(600) @map("idle_timeout_sec")
  revision         Int      @default(1)
  updatedByUserId  String?  @map("updated_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@id([tenantId, id])
  @@unique([tenantId], map: "webchat_widgets_one_per_tenant")
  @@map("webchat_widgets")
}

/// #1044 audit of widget configuration changes — append-only for the app role
model WebchatWidgetAuditEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  widgetId      String   @map("widget_id") @db.Uuid
  actorUserId   String   @map("actor_user_id") @db.Uuid
  /// CREATED | UPDATED
  action        String
  changedKeys   String[] @default([]) @map("changed_keys")
  before        Json?
  after         Json
  correlationId String   @map("correlation_id")
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([tenantId, occurredAt(sort: Desc)], map: "webchat_widget_audit_events_tenant_idx")
  @@map("webchat_widget_audit_events")
}

/// #1044 one anonymous visitor session = one conversation and at most one Interaction
model WebchatSession {
  tenantId       String    @map("tenant_id") @db.Uuid
  id             String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  widgetId       String    @map("widget_id") @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  /// null until the visitor sends the first message
  interactionId  String?   @map("interaction_id") @db.Uuid
  /// SHA-256 digest of the visitor secret; the secret itself is never stored
  tokenHash      String    @map("token_hash")
  origin         String
  /// short anonymous label shown to the Agent
  visitorLabel   String    @map("visitor_label")
  locale         String    @default("th")
  /// CUSTOMER_ENDED | AGENT_ENDED | IDLE_TIMEOUT | CUSTOMER_LEFT
  endReason      String?   @map("end_reason")
  endedAt        DateTime? @map("ended_at") @db.Timestamptz(3)
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([tenantId, id])
  @@unique([tenantId, conversationId], map: "webchat_sessions_conversation_key")
  @@unique([tenantId, interactionId], map: "webchat_sessions_interaction_key")
  @@index([tenantId, widgetId, createdAt(sort: Desc)], map: "webchat_sessions_widget_idx")
  @@map("webchat_sessions")
}

/// #1044 every offer of a chat to an Agent; a chat has at most one PENDING offer (partial unique index in the migration)
model WebchatOffer {
  tenantId      String    @map("tenant_id") @db.Uuid
  id            String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  interactionId String    @map("interaction_id") @db.Uuid
  agentId       String    @map("agent_id") @db.Uuid
  /// PENDING | ACCEPTED | TIMED_OUT | CANCELLED
  outcome       String    @default("PENDING")
  offeredAt     DateTime  @default(now()) @map("offered_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  resolvedAt    DateTime? @map("resolved_at") @db.Timestamptz(3)

  @@id([tenantId, id])
  @@index([tenantId, agentId, outcome], map: "webchat_offers_agent_idx")
  @@index([tenantId, interactionId, offeredAt(sort: Desc)], map: "webchat_offers_interaction_idx")
  @@map("webchat_offers")
}

// ─────────────────────────── LINE chat (#1054) ───────────────────────────

/// #1054 the LINE Official Account of a tenant; round one allows one per tenant. FKs are declared in the migration
model LineChannel {
  tenantId              String    @map("tenant_id") @db.Uuid
  id                    String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enabled               Boolean   @default(false)
  queueId               String?   @map("queue_id") @db.Uuid
  /// the Channel ID shown in LINE Developers, for reference
  lineChannelId         String    @default("") @map("line_channel_id")
  /// the bot's user id; a webhook names it as `destination`
  botUserId             String?   @map("bot_user_id")
  botName               String    @default("") @map("bot_name")
  /// sealed with the account secret key; never returned to a client
  channelSecretSealed   String?   @map("channel_secret_sealed")
  accessTokenSealed     String?   @map("access_token_sealed")
  channelSecretHint     String?   @map("channel_secret_hint")
  accessTokenHint       String?   @map("access_token_hint")
  credentialsVerifiedAt DateTime? @map("credentials_verified_at") @db.Timestamptz(3)
  autoReplyText         String    @default("") @map("auto_reply_text")
  idleTimeoutSec        Int       @default(1800) @map("idle_timeout_sec")
  revision              Int       @default(1)
  updatedByUserId       String?   @map("updated_by_user_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@id([tenantId, id])
  @@unique([tenantId], map: "line_channels_one_per_tenant")
  @@map("line_channels")
}

/// #1054 audit of LINE channel configuration changes — append-only for the app role; never holds secrets
model LineChannelAuditEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  channelId     String   @map("channel_id") @db.Uuid
  actorUserId   String   @map("actor_user_id") @db.Uuid
  /// CREATED | UPDATED
  action        String
  changedKeys   String[] @default([]) @map("changed_keys")
  before        Json?
  after         Json
  correlationId String   @map("correlation_id")
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([tenantId, occurredAt(sort: Desc)], map: "line_channel_audit_events_tenant_idx")
  @@map("line_channel_audit_events")
}

/// #1054 a LINE user of a channel and the one long-lived conversation of everything they wrote (ADR-023)
model LineChatUser {
  tenantId         String    @map("tenant_id") @db.Uuid
  id               String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channelId        String    @map("channel_id") @db.Uuid
  lineUserId       String    @map("line_user_id")
  conversationId   String    @map("conversation_id") @db.Uuid
  displayName      String    @default("") @map("display_name")
