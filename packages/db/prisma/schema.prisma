// Composite tenant FKs, append-only grants and immutable/retire triggers live in the migration
// 20261102100000_cus360_profile_foundation; the models below are typed columns only, so no relation is declared

/// E1 B: admission of a profile command — keeps no raw payload/PII/credential; a tombstone closes a key that was never admitted
model C360ProfileCommand {
  tenantId                     String   @map("tenant_id") @db.Uuid
  actorIdentityKey             String   @map("actor_identity_key")
  commandId                    String   @map("command_id") @db.Uuid
