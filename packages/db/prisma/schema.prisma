  @@unique([tenantId, channelId, lineUserId], map: "line_chat_users_user_key")
  @@unique([tenantId, conversationId], map: "line_chat_users_conversation_key")
  @@map("line_chat_users")
}

// ─────────────────────────── Recordings ───────────────────────────

enum RecordingChannelLayout {
  PER_LEG
  STEREO
}

enum RecordingAuditAction {
  PAUSED
  RESUMED
  PLAYBACK_URL_ISSUED
  PLAYBACK_ACCESSED
  DOWNLOAD_DENIED
  RETENTION_DELETED
  LEGAL_HOLD_PLACED
  LEGAL_HOLD_RELEASED
  // Telephony stopped trying to archive because the source file will never exist (e.g. hung up before FreeSWITCH created the file)
  ARCHIVE_ABANDONED
}

model Recording {
  id             String                 @id @default(uuid()) @db.Uuid
  tenantId       String                 @map("tenant_id") @db.Uuid
  interactionId  String                 @map("interaction_id") @db.Uuid
  // key in object storage (MinIO/S3)
  storageKey     String                 @map("storage_key")
  // path on the telephony node for pause/resume commands; not exposed to the browser
  telephonyPath  String                 @map("telephony_path")
  channelLayout  RecordingChannelLayout @default(STEREO) @map("channel_layout")
  pauseIntervals Json                   @default("[]") @map("pause_intervals")
  durationSec    Int?                   @map("duration_sec")
  startedAt      DateTime               @map("started_at")
  endedAt        DateTime?              @map("ended_at")
  archivedAt     DateTime?              @map("archived_at")
  deletedAt      DateTime?              @map("deleted_at")

  interaction         Interaction           @relation(fields: [interactionId], references: [id])
  auditEvents         RecordingAuditEvent[]
  legalHolds          RecordingLegalHold[]
  qmTranscriptionJobs QmTranscriptionJob[]
  qmTranscripts       QmTranscript[]

  @@unique([tenantId, interactionId])
  @@index([tenantId, interactionId])
  @@index([tenantId, deletedAt])
  @@map("recordings")
}

model RecordingAuditEvent {
  id          String               @id @default(uuid()) @db.Uuid
  tenantId    String               @map("tenant_id") @db.Uuid
  recordingId String               @map("recording_id") @db.Uuid
  actorUserId String?              @map("actor_user_id") @db.Uuid
  action      RecordingAuditAction
  reason      String?
  details     Json                 @default("{}")
