/// Journey publish acknowledgement หลัง durable apply สำเร็จแล้วเท่านั้น. Relay retry
/// ได้โดยไม่ต้อง apply event ซ้ำ และ payload มี opaque id/digest เท่านั้น.
model JrGovernanceAcknowledgementOutbox {
  id                 String                           @id @default(uuid()) @db.Uuid
  tenantId           String                           @map("tenant_id") @db.Uuid
  eventId            String                           @map("event_id")
  consumer           String
  aggregateType      CgAggregateType                  @map("aggregate_type")
  aggregateId        String                           @map("aggregate_id") @db.Uuid
  appliedVersion     Int                              @map("applied_version")
  outcome            CgConsumerAckOutcome
  affectedCount      Int                              @default(0) @map("affected_count")
  sourcePayloadHash  String                           @map("source_payload_hash")
  appliedStateDigest String?                          @map("applied_state_digest") @db.Char(64)
