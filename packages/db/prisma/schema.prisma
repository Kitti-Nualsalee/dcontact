  requestId       String      @map("request_id") @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  requestRevision Int         @map("request_revision")
  payloadDigest   String      @map("payload_digest") @db.Char(64)
  changedFields   String[]    @map("changed_fields")
  actorKind       PfActorKind @map("actor_kind")
  actorSubject    String      @map("actor_subject")
  reasonCode      String      @map("reason_code")
  createdAt       DateTime    @map("created_at")

  request PfProvisioningRequest @relation(fields: [tenantId, requestId], references: [tenantId, id], map: "pf_request_payload_revisions_request_fkey")

  @@unique([requestId, requestRevision], map: "pf_request_payload_revisions_revision_key")
  @@map("pf_request_payload_revisions")
}

/// A1.5b (#441) append-only: changing the first admin email (hash only) before the identity step succeeds
model PfFirstAdminEmailRevision {
  id                String      @id @db.Uuid
  requestId         String      @map("request_id") @db.Uuid
  tenantId          String      @map("tenant_id") @db.Uuid
  requestRevision   Int         @map("request_revision")
  previousEmailHash String      @map("previous_email_hash") @db.Char(64)
  emailHash         String      @map("email_hash") @db.Char(64)
  payloadDigest     String      @map("payload_digest") @db.Char(64)
  actorKind         PfActorKind @map("actor_kind")
  actorSubject      String      @map("actor_subject")
  reasonCode        String      @map("reason_code")
  createdAt         DateTime    @map("created_at")

  request PfProvisioningRequest @relation(fields: [tenantId, requestId], references: [tenantId, id], map: "pf_first_admin_email_revisions_request_fkey")

  @@unique([requestId, requestRevision], map: "pf_first_admin_email_revisions_revision_key")
  @@map("pf_first_admin_email_revisions")
}

enum PfOperatorCommandKind {
  PREVIEW
  EXECUTE
}

enum PfOperatorCommandState {
  QUEUED
  RUNNING
  SUCCEEDED
  REJECTED
}

/// A1.6 (#411) durable operator command — the API records it and answers 202, a worker claims it with lease/CAS and really does it
/// (a single active EXECUTE per request is enforced by a partial unique index in the migration)
model PfOperatorCommand {
  id                 String                 @id @db.Uuid
  requestId          String                 @map("request_id") @db.Uuid
  tenantId           String                 @map("tenant_id") @db.Uuid
  kind               PfOperatorCommandKind
  action             String
  state              PfOperatorCommandState @default(QUEUED)
  revision           Int                    @default(1)
  expectedRevision   Int?                   @map("expected_revision")
  previewDigest      String?                @map("preview_digest") @db.Char(64)
  reasonCode         String?                @map("reason_code")
  comment            String?
  idempotencyKeyHash String?                @unique @map("idempotency_key_hash") @db.Char(64)
  actorKind          PfActorKind            @map("actor_kind")
  actorSubject       String                 @map("actor_subject")
  actorRole          String?                @map("actor_role")
  actorSessionRef    String?                @map("actor_session_ref")
  correlationId      String                 @map("correlation_id")
  attempt            Int                    @default(0)
  leaseOwner         String?                @map("lease_owner")
  leaseExpiresAt     DateTime?              @map("lease_expires_at")
  result             Json?
  errorCode          String?                @map("error_code")
  createdAt          DateTime               @map("created_at")
  startedAt          DateTime?              @map("started_at")
  finishedAt         DateTime?              @map("finished_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  /// A1.8b (#473): W3C traceparent of the request that sent the command
  traceParent        String?                @map("trace_parent")

  request PfProvisioningRequest @relation(fields: [tenantId, requestId], references: [tenantId, id], map: "pf_operator_commands_request_fkey")

  @@index([state, createdAt], map: "pf_operator_commands_claim_idx")
  @@index([requestId, createdAt], map: "pf_operator_commands_request_idx")
  @@map("pf_operator_commands")
}

enum PfInvitationState {
  INTENT
  SENT
  FAILED
  AMBIGUOUS
}

/// A1.4 (#409) invitation outbox of the first Tenant Admin — one row per generation, intent always before sending
/// no raw email/action token; the resend cap and consecutive generations are enforced by a trigger
model PfInvitation {
  id              String            @id @db.Uuid
  requestId       String            @map("request_id") @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  generation      Int
