/// C1.5 extends the enrollment into a durable execution cursor: `event_inbox_id` is relaxed to
/// nullable because a Schedule trigger has no originating event, and `(current_step_id, step_sequence)`
/// is the only position that says how far the enrollment has progressed — every worker must CAS on step_sequence
model JrEnrollment {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  eventInboxId     String?           @map("event_inbox_id") @db.Uuid
  occurrenceId     String?           @map("occurrence_id") @db.Uuid
  /// J2.7: an enrollment created by an INTERACTION_OUTCOME trigger — nullable like
  /// eventInboxId/occurrenceId because an enrollment can have only one trigger source
  ///
  /// points at the first receipt revision of the logical outcome that made this journey match — a correction
  /// revision after the original outcome re-evaluates this enrollment and does not create a new one (#123), and
  /// one receipt can fan out to several published journeys, so it is unique at the (receipt, journey) level
  outcomeReceiptId String?           @map("outcome_receipt_id") @db.Uuid
  /// J3.7 (#218): an enrollment created by a SEGMENT_ENTRY trigger
  ///
  /// bound to an "intent", not a receipt like outcomeReceiptId, because one segment revision
  /// fans out to several journeys at once, while an intent is already one per (journey, version, entry),
  /// so the relationship is truly 1:1 and the unique constraint below can enforce it directly
  segmentIntentId  String?           @map("segment_intent_id") @db.Uuid
  journeyId        String?           @map("journey_id") @db.Uuid
  journeyVersion   Int               @map("journey_version")
  contactId        String?           @map("contact_id") @db.Uuid
  decisionId       String?           @map("decision_id") @db.Uuid
  state            JrEnrollmentState @default(PENDING)
  runState         JrRunState        @default(RUNNING) @map("run_state")
  currentStepId    String?           @map("current_step_id")
  stepSequence     Int               @default(0) @map("step_sequence")
  waitUntil        DateTime?         @map("wait_until")
  maxAgeAt         DateTime?         @map("max_age_at")
  terminalReason   JrTerminalReason? @map("terminal_reason")
  terminalStepId   String?           @map("terminal_step_id")
  terminalAt       DateTime?         @map("terminal_at")
  claimedBy        String?           @map("claimed_by")
  claimExpiresAt   DateTime?         @map("claim_expires_at")
  correlationId    String?           @map("correlation_id")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  tenant             Tenant                     @relation(fields: [tenantId], references: [id])
  eventInbox         JrEventInbox?              @relation(fields: [eventInboxId], references: [id])
  occurrence         JrScheduleOccurrence?      @relation(fields: [occurrenceId], references: [id])
  outcomeReceipt     JrOutcomeReceipt?          @relation(fields: [outcomeReceiptId], references: [id])
  segmentIntent      JrSegmentEnrollmentIntent? @relation(fields: [tenantId, segmentIntentId], references: [tenantId, id])
  contact            Contact?                   @relation(fields: [contactId], references: [id])
  decision           CgDecisionLog?             @relation(fields: [decisionId], references: [id])
  actions            JrAction[]
  stepRuns           JrStepRun[]
  ownerContinuations JrOwnerContinuation[]

  @@unique([tenantId, id])
  @@unique([tenantId, eventInboxId])
  @@unique([tenantId, occurrenceId], map: "jr_enrollments_tenant_occurrence_key")
  @@unique([tenantId, outcomeReceiptId, journeyId], map: "jr_enrollments_tenant_outcome_receipt_journey_key")
  @@unique([tenantId, segmentIntentId], map: "jr_enrollments_tenant_segment_intent_key")
  @@index([tenantId, contactId, state])
  @@index([tenantId, runState, waitUntil], map: "jr_enrollments_tenant_run_state_wait_until_idx")
  @@index([tenantId, runState, maxAgeAt], map: "jr_enrollments_tenant_run_state_max_age_idx")
  @@index([tenantId, journeyId, createdAt(sort: Desc), id(sort: Desc)], map: "jr_enrollments_tenant_journey_created_idx")
  @@map("jr_enrollments")
}

/// One row per occurrence of a Schedule trigger — the unique key stops a cron that fires twice
/// (the scheduler itself, several workers or a restart) from enrolling twice in the same tenant
model JrScheduleOccurrence {
  id             String                    @id @default(uuid()) @db.Uuid
  tenantId       String                    @map("tenant_id") @db.Uuid
  journeyId      String                    @map("journey_id") @db.Uuid
  journeyVersion Int                       @map("journey_version")
  occurrenceAt   DateTime                  @map("occurrence_at")
  state          JrScheduleOccurrenceState @default(CLAIMED)
  correlationId  String                    @map("correlation_id")
  createdAt      DateTime                  @default(now()) @map("created_at")

  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  enrollments JrEnrollment[]

  @@unique([tenantId, id])
  @@unique([tenantId, journeyId, journeyVersion, occurrenceAt], map: "jr_schedule_occurrences_tenant_occurrence_key")
  @@index([tenantId, state, occurrenceAt], map: "jr_schedule_occurrences_tenant_state_occurrence_idx")
  @@map("jr_schedule_occurrences")
}

/// Ledger of every node an enrollment walks through; `(enrollment_id, step_sequence)` is unique
/// so it prevents two workers from running the same node twice even when they claim the work at the same time
model JrStepRun {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  enrollmentId  String         @map("enrollment_id") @db.Uuid
  stepSequence  Int            @map("step_sequence")
  stepId        String         @map("step_id")
  stepType      String         @map("step_type")
  state         JrStepRunState
  nextStepId    String?        @map("next_step_id")
  branchResult  Boolean?       @map("branch_result")
  correlationId String         @map("correlation_id")
  causationId   String?        @map("causation_id")
  startedAt     DateTime       @map("started_at")
  createdAt     DateTime       @default(now()) @map("created_at")

  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  enrollment JrEnrollment @relation(fields: [tenantId, enrollmentId], references: [tenantId, id], map: "jr_step_runs_tenant_enrollment_fkey")

  @@unique([tenantId, enrollmentId, stepSequence], map: "jr_step_runs_tenant_enrollment_sequence_key")
  @@index([tenantId, enrollmentId, stepId], map: "jr_step_runs_tenant_enrollment_step_idx")
  @@map("jr_step_runs")
}

model JrAction {
