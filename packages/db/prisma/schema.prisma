// ─────────────────────────── A1 Platform control plane (#406) ───────────────────────────
// platform-scoped metadata only: accessed through role `dcontact_platform`, which has no privileges on tenant business
// tables, and `dcontact_app` has no privileges on `pf_*` tables — tenant RLS is not used because this is not tenant data

enum TenantLifecycleStatus {
  PROVISIONING
  ACTIVE
}

enum PfProvisioningStatus {
  PENDING
  RUNNING
  SUCCEEDED
  ACTION_REQUIRED
  FAILED_FINAL
  CANCELLED
}

enum PfStepKey {
  TENANT_RECORD
  KEYCLOAK_ORGANIZATION
  PLAN_BOOTSTRAP
  FIRST_ADMIN
  INVITATION
  READINESS
}

enum PfStepState {
  PENDING
  RUNNING
  SUCCEEDED
  ACTION_REQUIRED
}

enum PfReservationKind {
  SLUG
  PRIMARY_DOMAIN
  FIRST_ADMIN_EMAIL
}

enum PfReservationState {
  HELD
  CONSUMED
  TOMBSTONED
}

enum PfBootstrapTemplateStatus {
  ACTIVE
  DEPRECATED
  REVOKED
}

enum PfActionKind {
  REQUEST_ACCEPTED
  COMMAND_REPLAYED
  STATE_CHANGED
  STEP_STARTED
  STEP_SUCCEEDED
  STEP_ACTION_REQUIRED
  STEP_RETRY_SCHEDULED
  RECONCILE
  RETRY_STEP
  RESEND_INVITATION
  SAFE_COMPENSATE
  MARK_FAILED_FINAL
  CANCEL
  RESERVATION_TOMBSTONED
  SECURITY_DENIED
  REQUEST_EDITED
  FIRST_ADMIN_EMAIL_VERIFIED
  FIRST_ADMIN_PASSWORD_SET
  FIRST_ADMIN_TOTP_ENROLLED
  FIRST_ADMIN_ACTIVATED
}

enum PfActorKind {
  PLATFORM_OPERATOR
  PLATFORM_AUDITOR
  SYSTEM
  FIRST_ADMIN
}

/// immutable versioned bootstrap manifest (#392) — can change only status ACTIVE → DEPRECATED → REVOKED
model PfBootstrapTemplate {
  version       String                    @id
  contentDigest String                    @map("content_digest") @db.Char(64)
  status        PfBootstrapTemplateStatus @default(ACTIVE)
  manifest      Json
  createdAt     DateTime                  @default(now()) @map("created_at")
  updatedAt     DateTime                  @updatedAt @map("updated_at")

  requests PfProvisioningRequest[]

  @@unique([version, contentDigest], map: "pf_bootstrap_templates_pin_key")
  @@map("pf_bootstrap_templates")
}

/// durable intent of a tenant creation request (#389/#390) — identity/pin fields are immutable after accept
model PfProvisioningRequest {
  id                       String               @id @db.Uuid
  tenantId                 String               @unique @map("tenant_id") @db.Uuid
  idempotencyKeyHash       String               @unique @map("idempotency_key_hash") @db.Char(64)
  payloadDigest            String               @map("payload_digest") @db.Char(64)
  status                   PfProvisioningStatus @default(PENDING)
  revision                 Int                  @default(1)
  displayName              String               @map("display_name")
  slug                     String
  primaryDomain            String               @map("primary_domain")
  sipDomain                String               @map("sip_domain")
  locale                   String
  timezone                 String
  planCode                 String               @map("plan_code")
  planVersion              Int                  @map("plan_version")
  planSnapshotDigest       String               @map("plan_snapshot_digest") @db.Char(64)
  bootstrapTemplateVersion String               @map("bootstrap_template_version")
  bootstrapTemplateDigest  String               @map("bootstrap_template_digest") @db.Char(64)
  /// operational PII that A1.4 needs to send an invitation — must not go to logs/audit/evidence (use a hash instead)
  firstAdminEmail          String               @map("first_admin_email")
  firstAdminEmailHash      String               @map("first_admin_email_hash") @db.Char(64)
  firstAdminDisplayName    String               @map("first_admin_display_name")
  requestedBy              String               @map("requested_by")
  correlationId            String               @map("correlation_id")
  failureCode              String?              @map("failure_code")
  acceptedAt               DateTime             @map("accepted_at")
  deadlineAt               DateTime             @map("deadline_at")
  terminalAt               DateTime?            @map("terminal_at")
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")
  /// A1.8b (#473): W3C traceparent when the request was received — the worker continues the span as one trace
  traceParent              String?              @map("trace_parent")

  tenant           Tenant                      @relation(fields: [tenantId], references: [id])
  template         PfBootstrapTemplate         @relation(fields: [bootstrapTemplateVersion, bootstrapTemplateDigest], references: [version, contentDigest], map: "pf_provisioning_requests_template_pin_fkey")
  plan             PfPlanVersion               @relation(fields: [planCode, planVersion, planSnapshotDigest], references: [planCode, version, snapshotDigest], onDelete: Restrict, onUpdate: Restrict, map: "pf_provisioning_requests_plan_pin_fkey")
  steps            PfProvisioningStep[]
  receipts         PfProvisioningStepReceipt[]
  commands         PfCommandReceipt[]
  reservations     PfIdentityReservation[]
  actions          PfActionHistory[]
  invitations      PfInvitation[]
  payloadRevisions PfRequestPayloadRevision[]
  operatorCommands PfOperatorCommand[]
  emailRevisions   PfFirstAdminEmailRevision[]

  @@unique([tenantId, id], map: "pf_provisioning_requests_binding_key")
  @@index([status, updatedAt], map: "pf_provisioning_requests_status_idx")
  @@map("pf_provisioning_requests")
}

/// head of the step ledger per (request, stepKey) — cannot be edited once SUCCEEDED (#390)
model PfProvisioningStep {
  requestId      String      @map("request_id") @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  stepKey        PfStepKey   @map("step_key")
  ordinal        Int
  state          PfStepState @default(PENDING)
  attempt        Int         @default(0)
  revision       Int         @default(1)
  leaseOwner     String?     @map("lease_owner")
  leaseExpiresAt DateTime?   @map("lease_expires_at")
  inputDigest    String?     @map("input_digest") @db.Char(64)
  outputDigest   String?     @map("output_digest") @db.Char(64)
  externalRef    String?     @map("external_ref")
  errorCode      String?     @map("error_code")
  /// A1.3: backoff + jitter after a transient failure; a worker does not claim before this time
  nextAttemptAt  DateTime?   @map("next_attempt_at")
  /// A1.3: start of the current attempt budget (an operator Retry opens a new budget without resetting attempts)
  attemptFloor   Int         @default(0) @map("attempt_floor")
  startedAt      DateTime?   @map("started_at")
  finishedAt     DateTime?   @map("finished_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  request PfProvisioningRequest @relation(fields: [tenantId, requestId], references: [tenantId, id], map: "pf_provisioning_steps_request_fkey")

  @@id([requestId, stepKey])
  @@unique([requestId, ordinal], map: "pf_provisioning_steps_ordinal_key")
  @@index([state, nextAttemptAt, leaseExpiresAt], map: "pf_provisioning_steps_claim_idx")
  @@map("pf_provisioning_steps")
}

/// append-only receipt per attempt of a step — a replay of SUCCEEDED returns the original row
model PfProvisioningStepReceipt {
  id              String      @id @db.Uuid
  requestId       String      @map("request_id") @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  stepKey         PfStepKey   @map("step_key")
  attempt         Int
  outcome         PfStepState
  inputDigest     String?     @map("input_digest") @db.Char(64)
  outputDigest    String?     @map("output_digest") @db.Char(64)
  externalRefHash String?     @map("external_ref_hash") @db.Char(64)
  errorCode       String?     @map("error_code")
  recordedAt      DateTime    @map("recorded_at")

  request PfProvisioningRequest @relation(fields: [tenantId, requestId], references: [tenantId, id], map: "pf_provisioning_step_receipts_request_fkey")

  @@unique([requestId, stepKey, attempt], map: "pf_provisioning_step_receipts_attempt_key")
  @@map("pf_provisioning_step_receipts")
}

/// A1.5 (#410) plan catalog — entitlement snapshot immutable per (code, version); a request pins it by digest
model PfPlanVersion {
  planCode       String                    @map("plan_code")
  version        Int
  status         PfBootstrapTemplateStatus @default(ACTIVE)
  entitlements   Json
  snapshotDigest String                    @map("snapshot_digest") @db.Char(64)
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")

