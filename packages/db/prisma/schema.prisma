// CG4 canonical policy และ exception records แยกจาก cg_policies ของ CG3
// เพื่อให้ migration เป็น expand-only และค่อยสลับ writer ใน ticket ถัดไป.
enum Cg4PolicyStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  SCHEDULED
  ACTIVE
  SUPERSEDED
  REJECTED
  WITHDRAWN
}

enum Cg4ApprovalDecision {
  APPROVED
  REJECTED
}

// CG4.5 (#188): semantic diff class ของ policy version; ตัดสิน required quorum ตาม #173 §2
enum Cg4PolicyDiffClass {
  TIGHTENING
  NEUTRAL
  RELAXATION
}

enum Cg4PolicyTestOutcome {
  PASS
  FAIL
}

enum Cg4ActivationJobState {
  PENDING
  CLAIMED
  COMPLETE
  FAILED
  CANCELLED
}

enum Cg4ExceptionScopeKind {
  IDENTITY
  CONTACT_WIDE
}

// Workflow state per #177. `Cg4ExceptionHead.status` is the authority; a revision row
// keeps whatever status it was inserted with (always PENDING) because `cg_exception` is
// insert-only. EXPIRED is an *effective* state computed from database time at evaluation
// and is never persisted here — persisting it would make the expiry scheduler a
// correctness authority, which #177 forbids.
enum Cg4ExceptionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REVOKED
  EXPIRED
  SUPERSEDED
}

enum Cg4ExceptionTier {
  STANDARD
  HIGH
  EMERGENCY
}

enum Cg4KillSwitchState {
  ACTIVE
  CLEARED
}

enum Cg4CapabilitySource {
  DIRECT
  DELEGATED
  // CG4.10 (#193): approval เดิมของ CG3 ที่ย้ายมาเป็นหลักฐาน baseline ใช้ได้เฉพาะ LEGACY_CG3 version
  LEGACY_MIGRATED
}

/// CG4.10 (#193): ที่มาของ policy version — CG4 writer หรือ backfill จาก cg_policies ของ CG3
enum Cg4PolicyOrigin {
  CG4
  LEGACY_CG3
}

enum Cg4AuthenticationStrength {
  STANDARD
  STRONG
}

enum JrEventInboxState {
  PENDING
  PUBLISHED
  PROCESSED
  FAILED
}

enum JrEnrollmentState {
  PENDING
  REVIEW
  BLOCKED
  DEFERRED
  AUTHORIZED
}

/// C1.5: สถานะการเดินของ enrollment แยกจาก `JrEnrollmentState` ซึ่งบันทึกผล authorize
enum JrRunState {
  RUNNING
  WAITING
  TERMINAL
}

/// เหตุผลเดียวที่ enrollment จบ — บันทึกครั้งแรกครั้งเดียว ห้ามเขียนทับ
enum JrTerminalReason {
  GRAPH_EXIT
  GOAL_REACHED
  EXIT_RULE
  MAX_AGE
  CANCELLED
}

enum JrStepRunState {
  COMPLETED
  AWAITING_SEND
}

enum JrScheduleOccurrenceState {
  CLAIMED
  ENROLLED
}

/// S1.5: Journey เป็นเจ้าของ lifecycle ของ action หลังรับ CG3 mutation. ค่านี้บอก
/// ขอบเขตที่ยกเลิกได้ ไม่ใช่สถานะของ reservation หรือ provider delivery.
enum JrRealtimeActionState {
  QUEUED
  RESERVED
  PRE_BARRIER
  POST_BARRIER
  ACCEPTED
  CANCELLED
  DEFERRED
  PARKED
  HELD
  CANCEL_REQUESTED
  SETTLED
}

/// ผล durable ของ CG3 event ใน Journey consumer. GAP/QUARANTINED ต้อง fail closed
/// และไม่อนุญาตให้ action กลับไป dispatch จนกว่าจะ replay/reconcile สำเร็จ.
enum JrGovernanceConsumerState {
  APPLIED
  NO_OP
  GAP
  QUARANTINED
  // CG4.8 (#191): version+digest ซ้ำกับที่ apply แล้วแต่ eventId ต่าง; ไม่ขยับ cursor
  DUPLICATE
}

enum JrGovernanceAcknowledgementState {
  PENDING
  PUBLISHED
  FAILED
}

/// งานภายนอกของ Journey ที่ต้องเกิดหลัง owner-local inbox/action commit เท่านั้น
enum JrGovernanceEffectState {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum JrGovernanceEffectKind {
  RELEASE_BEFORE_BARRIER
  REQUEST_RECONCILE
}

enum JrActionLifecycleState {
  PRE_BARRIER
  POST_BARRIER
  ACCEPTED
}

/// S1.7: Dialer เก็บ raw outbound attempt ของตนเองและใช้ state นี้สำหรับ
/// CG3 invalidation เท่านั้น ไม่ใช่ source of truth ของ reservation หรือ policy.
enum ObAttemptRealtimeState {
  QUEUED
  RESERVED
  PRE_BARRIER
  POST_BARRIER
  ACCEPTED
  IN_PROGRESS
  CANCELLED
  DEFERRED
  PARKED
  HELD
  CANCEL_REQUESTED
  SETTLED
}

enum ObGovernanceConsumerState {
  APPLIED
  NO_OP
  GAP
  QUARANTINED
  // CG4.8 (#191): version+digest ซ้ำกับที่ apply แล้วแต่ eventId ต่าง; ไม่ขยับ cursor
  DUPLICATE
}

enum ObGovernanceAcknowledgementState {
  PENDING
  PUBLISHED
  FAILED
}

enum ObGovernanceEffectState {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum ObGovernanceEffectKind {
  RELEASE_BEFORE_BARRIER
  REQUEST_RECONCILE
}

model CgRestriction {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  contactId   String?           @map("contact_id") @db.Uuid
  identityId  String?           @map("identity_id") @db.Uuid
  type        CgRestrictionType
  channel     ChannelType?
  purpose     String?
  scope       String
  overridable Boolean           @default(false)
  reasonCode  String            @map("reason_code")
  source      String
  evidence    Json?
  startsAt    DateTime          @default(now()) @map("starts_at")
  expiresAt   DateTime?         @map("expires_at")
  createdBy   String            @map("created_by")
  createdAt   DateTime          @default(now()) @map("created_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  contact  Contact?         @relation(fields: [tenantId, contactId], references: [tenantId, id], map: "cg_restrictions_tenant_contact_fkey")
  identity ContactIdentity? @relation(fields: [tenantId, identityId], references: [tenantId, id], map: "cg_restrictions_tenant_identity_fkey")

  @@index([tenantId, contactId, startsAt])
  @@index([tenantId, identityId, startsAt])
  @@index([tenantId, type, startsAt])
  @@map("cg_restrictions")
}

model CgConsent {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  contactId     String          @map("contact_id") @db.Uuid
  identityId    String?         @map("identity_id") @db.Uuid
  purpose       String
  channel       ChannelType
  status        CgConsentStatus
  lawfulBasis   String          @map("lawful_basis")
  noticeVersion String?         @map("notice_version")
  evidence      Json            @default("{}")
  grantedAt     DateTime?       @map("granted_at")
  revokedAt     DateTime?       @map("revoked_at")
  expiresAt     DateTime?       @map("expires_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  contact  Contact          @relation(fields: [tenantId, contactId], references: [tenantId, id], map: "cg_consents_tenant_contact_fkey")
  identity ContactIdentity? @relation(fields: [tenantId, identityId], references: [tenantId, id], map: "cg_consents_tenant_identity_fkey")

  @@index([tenantId, contactId, purpose, channel, status])
  @@index([tenantId, identityId, purpose, channel, status])
  @@map("cg_consents")
}

model CgReservation {
  id                            String                      @id @default(uuid()) @db.Uuid
  tenantId                      String                      @map("tenant_id") @db.Uuid
  contactId                     String                      @map("contact_id") @db.Uuid
  identityId                    String?                     @map("identity_id") @db.Uuid
  channel                       ChannelType
  purpose                       String
  source                        String
  sourceId                      String                      @map("source_id")
  teamId                        String?                     @map("team_id") @db.Uuid
  segmentSnapshot               Json?                       @map("segment_snapshot")
  scopeVersion                  Int?                        @map("scope_version")
  actionKey                     String                      @map("action_key")
  inputHash                     String                      @map("input_hash")
  state                         CgReservationState          @default(RESERVED)
  expiresAt                     DateTime                    @map("expires_at")
  confirmedAt                   DateTime?                   @map("confirmed_at")
  releasedAt                    DateTime?                   @map("released_at")
  refundedAt                    DateTime?                   @map("refunded_at")
  deliveryId                    String?                     @map("delivery_id")
  senderIdentityId              String?                     @map("sender_identity_id")
  providerRequestKey            String?                     @map("provider_request_key")
  leaseVersion                  Int?                        @map("lease_version")
  leaseExpiresAt                DateTime?                   @map("lease_expires_at")
  submissionStartedAt           DateTime?                   @map("submission_started_at")
  settlementStatus              CgDeliverySettlementStatus? @map("settlement_status")
  terminalOutcome               CgFactOutcome?              @map("terminal_outcome")
  terminalOutcomeRef            String?                     @map("terminal_outcome_ref")
  settledAt                     DateTime?                   @map("settled_at")
  authorizationAggregateVersion Int?                        @map("authorization_aggregate_version")
  authorizationPolicyVersion    Int?                        @map("authorization_policy_version")
  /// S1.5: context ที่ immutable เพื่อ canonical re-evaluation แบบ fail-closed
  authorizationContactKind      String?                     @map("authorization_contact_kind")
  authorizationContextVersion   Int                         @default(0) @map("authorization_context_version")
  authorizationDecisionId       String?                     @map("authorization_decision_id") @db.Uuid
  createdAt                     DateTime                    @default(now()) @map("created_at")
  updatedAt                     DateTime                    @updatedAt @map("updated_at")

  tenant                Tenant                        @relation(fields: [tenantId], references: [id])
  contact               Contact                       @relation(fields: [contactId], references: [id])
  identity              ContactIdentity?              @relation(fields: [identityId], references: [id])
  decisionLogs          CgDecisionLog[]
  journeyActions        JrAction[]
  attempts              CgAttempt[]
  touches               CgTouch[]
  commandReceipts       CgReservationCommandReceipt[]
  outboxEntries         DlOutboxEntry[]
  obAttempts            ObAttempt[]
  authorizationDecision CgDecisionLog?                @relation("CgAuthorizationDecision", fields: [tenantId, authorizationDecisionId], references: [tenantId, id], map: "cg_reservations_tenant_authorization_decision_fkey")

  @@unique([tenantId, id])
  @@unique([tenantId, actionKey])
  @@unique([tenantId, deliveryId])
  @@unique([tenantId, providerRequestKey])
  @@index([tenantId, contactId, state, createdAt])
  @@index([tenantId, state, expiresAt])
  @@index([tenantId, settlementStatus, leaseExpiresAt], map: "cg_reservations_tenant_id_settlement_status_lease_expiry_idx")
  @@map("cg_reservations")
}

/// ผลลัพธ์ durable ของ command เพื่อให้ duplicate คืน snapshot เดิมหลัง restart
model CgReservationCommandReceipt {
  id             String                        @id @default(uuid()) @db.Uuid
  tenantId       String                        @map("tenant_id") @db.Uuid
  reservationId  String                        @map("reservation_id") @db.Uuid
  operation      CgReservationCommandOperation
  idempotencyKey String                        @map("idempotency_key")
  inputHash      String                        @map("input_hash")
  response       Json
  createdAt      DateTime                      @default(now()) @map("created_at")

  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  reservation CgReservation @relation(fields: [tenantId, reservationId], references: [tenantId, id], map: "cg_reservation_command_receipts_tenant_reservation_fkey")

  @@unique([tenantId, operation, idempotencyKey], map: "cg_reservation_command_receipts_tenant_operation_key")
  @@index([tenantId, reservationId, createdAt], map: "cg_reservation_command_receipts_tenant_reservation_created_idx")
