  createdAt             DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("tenant_plan_bindings")
}

/// D1.12 (#451): default app pins of a tenant (set by the tenant ADMIN) — new users see this set
/// `appIds` are ids in the API app registry in the order on the rail (≤15); `revision` is used with expectedRevision
