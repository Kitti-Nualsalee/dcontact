  initializedByUser        User?              @relation("CoreSettingsInitializer", fields: [tenantId, initializedByUserId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "core_settings_initializer_user")
  initializedByCommand     TenantCoreCommand? @relation(fields: [tenantId, initializedByIdentityKey, initializedByCommandId], references: [tenantId, actorIdentityKey, commandId], onDelete: NoAction, onUpdate: NoAction, map: "core_settings_initializer_command")
  tenantId                 String             @id @map("tenant_id") @db.Uuid
  locale                   String
