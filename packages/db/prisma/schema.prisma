generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin", "darwin-arm64"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Tenancy & Users ───────────────────────────

model Tenant {
  id                        String                  @id @default(uuid()) @db.Uuid
  name                      String
  slug                      String                  @unique
  sipDomain                 String                  @unique @map("sip_domain")
  defaultOfferTimeoutSec    Int                     @default(20) @map("default_offer_timeout_sec")
  defaultOfferTimeoutAction QueueOfferTimeoutAction @default(COOLDOWN_REQUEUE) @map("default_offer_timeout_action")
  defaultOfferCooldownSec   Int                     @default(60) @map("default_offer_cooldown_sec")
  defaultMaxWaitSec         Int?                    @map("default_max_wait_sec")
  defaultMaxWaitAction      QueueMaxWaitAction      @default(VOICEMAIL) @map("default_max_wait_action")
  createdAt                 DateTime                @default(now()) @map("created_at")

  users                        User[]
  teams                        Team[]
  queues                       Queue[]
  voiceDestinations            VoiceDestination[]
  queueAuditEvents             QueueAuditEvent[]
  skills                       Skill[]
  contacts                     Contact[]
  interactions                 Interaction[]
  conversations                Conversation[]
  qmTranscriptionJobs          QmTranscriptionJob[]
  qmAuditEvents                QmAuditEvent[]
  qmTranscripts                QmTranscript[]
  qmEvaluations                QmEvaluation[]
  qmConsoleContexts            QmConsoleContext[]
  commandReceipts              CommandReceipt[]
  cgRestrictions               CgRestriction[]
  cgConsents                   CgConsent[]
  cgDecisionLogs               CgDecisionLog[]
  cgReservations               CgReservation[]
  cgReservationCommandReceipts CgReservationCommandReceipt[]
  cgAttempts                   CgAttempt[]
  cgTouches                    CgTouch[]
  jrEventInbox                 JrEventInbox[]
  jrKafkaConsumerInbox         JrKafkaConsumerInbox[]
  jrEnrollments                JrEnrollment[]
  jrActions                    JrAction[]
  jrJourneyDefinitions         JrJourneyDefinition[]
  dvOutboxes                   DvOutbox[]

  @@map("tenants")
}

enum UserRole {
  AGENT
  SUPERVISOR
  ADMIN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  keycloakId   String?  @unique @map("keycloak_id") @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  role         UserRole @default(AGENT)
  // SIP extension สำหรับ softphone (agent เท่านั้น)
  extension    String?
  sipPassword  String?  @map("sip_password")
  teamId       String?  @map("team_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  team         Team?           @relation(fields: [teamId], references: [id])
  skills       AgentSkill[]
  stateLogs    AgentStateLog[]
  interactions Interaction[]

  @@unique([tenantId, email])
  @@unique([tenantId, extension])
  @@index([tenantId])
  @@map("users")
}

model Team {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name     String

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  members User[]
  queues  Queue[]

  @@unique([tenantId, name])
  @@map("teams")
}

// ─────────────────────────── Routing: Queues & Skills ───────────────────────────

enum ChannelType {
  VOICE
  WEBCHAT
  LINE
  FACEBOOK
  WHATSAPP
  EMAIL
}

enum QueueOfferTimeoutAction {
  IMMEDIATE_REQUEUE
  COOLDOWN_REQUEUE
  ABANDON
}

enum QueueMaxWaitAction {
  WAIT
  CALLBACK
  VOICEMAIL
}

enum QueueRoutingStrategy {
  LONGEST_AVAILABLE_IDLE
  LONGEST_SINCE_LAST_INTERACTION
  ROUND_ROBIN
}

enum QueueTranscriptionMode {
  OFF
  AUTOMATIC
  MANUAL
}

model Queue {
  id                            String                   @id @default(uuid()) @db.Uuid
  tenantId                      String                   @map("tenant_id") @db.Uuid
  name                          String
  // universal queue: รองรับหลาย channel ใน queue เดียว
  channels                      ChannelType[]
  slaThresholdSec               Int                      @default(20) @map("sla_threshold_sec")
  maxWaitSec                    Int?                     @map("max_wait_sec")
  offerTimeoutSec               Int?                     @map("offer_timeout_sec")
  offerTimeoutAction            QueueOfferTimeoutAction? @map("offer_timeout_action")
  offerCooldownSec              Int?                     @map("offer_cooldown_sec")
  maxWaitAction                 QueueMaxWaitAction?      @map("max_wait_action")
  routingStrategy               QueueRoutingStrategy     @default(LONGEST_AVAILABLE_IDLE) @map("routing_strategy")
  priority                      Int                      @default(0)
  teamId                        String?                  @map("team_id") @db.Uuid
  isActive                      Boolean                  @default(true) @map("is_active")
  recordingEnabled              Boolean                  @default(false) @map("recording_enabled")
  recordingAnnouncement         String?                  @map("recording_announcement")
  recordingAnnouncementLanguage String?                  @map("recording_announcement_language")
  recordingPauseResumeEnabled   Boolean                  @default(false) @map("recording_pause_resume_enabled")
  recordingAgentSelfAccess      Boolean                  @default(false) @map("recording_agent_self_access")
  recordingDownloadAllowed      Boolean                  @default(false) @map("recording_download_allowed")
  recordingRetentionDays        Int?                     @map("recording_retention_days")
  recordingChannelLayout        RecordingChannelLayout   @default(STEREO) @map("recording_channel_layout")
  transcriptionMode             QueueTranscriptionMode   @default(OFF) @map("transcription_mode")
  transcriptionLanguage         String                   @default("th-TH") @map("transcription_language")
  transcriptionMaxAttempts      Int                      @default(3) @map("transcription_max_attempts")
  autoQmEnabled                 Boolean                  @default(false) @map("auto_qm_enabled")
  createdAt                     DateTime                 @default(now()) @map("created_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  team              Team?              @relation(fields: [teamId], references: [id])
  skills            QueueSkill[]
  interactions      Interaction[]
  voiceDestinations VoiceDestination[]
  auditEvents       QueueAuditEvent[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, teamId])
  @@map("queues")
}

enum VoiceDestinationEntryMode {
  DIRECT_QUEUE
  IVR
}

model VoiceDestination {
  id          String                    @id @default(uuid()) @db.Uuid
  tenantId    String                    @map("tenant_id") @db.Uuid
  destination String
  entryMode   VoiceDestinationEntryMode @default(DIRECT_QUEUE) @map("entry_mode")
  queueId     String                    @map("queue_id") @db.Uuid
  ivrConfig   Json?                     @map("ivr_config")
  isActive    Boolean                   @default(true) @map("is_active")
  createdAt   DateTime                  @default(now()) @map("created_at")
  updatedAt   DateTime                  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  queue  Queue  @relation(fields: [tenantId, queueId], references: [tenantId, id])

  @@unique([tenantId, destination])
  @@index([tenantId, queueId])
  @@map("voice_destinations")
}

enum QueueAuditAction {
  QUEUE_CREATED
  QUEUE_UPDATED
  QUEUE_ENABLED
  QUEUE_DISABLED
  DIRECT_DESTINATION_SET
}

model QueueAuditEvent {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  queueId     String           @map("queue_id") @db.Uuid
  actorUserId String           @map("actor_user_id") @db.Uuid
  action      QueueAuditAction
  details     Json
  createdAt   DateTime         @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  queue  Queue  @relation(fields: [tenantId, queueId], references: [tenantId, id])

  @@index([tenantId, createdAt])
  @@index([tenantId, queueId, createdAt])
  @@map("queue_audit_events")
}

model Skill {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name     String

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  agents AgentSkill[]
  queues QueueSkill[]

  @@unique([tenantId, name])
  @@map("skills")
}

model AgentSkill {
  userId  String @map("user_id") @db.Uuid
  skillId String @map("skill_id") @db.Uuid
  level   Int    @default(1) // 1-5

  user  User  @relation(fields: [userId], references: [id])
  skill Skill @relation(fields: [skillId], references: [id])

  @@id([userId, skillId])
  @@map("agent_skills")
}

model QueueSkill {
  queueId  String @map("queue_id") @db.Uuid
  skillId  String @map("skill_id") @db.Uuid
  minLevel Int    @default(1) @map("min_level")

  queue Queue @relation(fields: [queueId], references: [id])
  skill Skill @relation(fields: [skillId], references: [id])

  @@id([queueId, skillId])
  @@map("queue_skills")
}

// ─────────────────────────── Agent State ───────────────────────────

enum AgentStateType {
  OFFLINE
  AVAILABLE
  RESERVED
  BUSY
  ACW
  BREAK
}

// append-only log ของทุกการเปลี่ยน state — ใช้ทำ reporting (occupancy, adherence)
model AgentStateLog {
  id          BigInt         @id @default(autoincrement())
  tenantId    String         @map("tenant_id") @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  state       AgentStateType
  reason      String?
  actorUserId String?        @map("actor_user_id") @db.Uuid
  startedAt   DateTime       @default(now()) @map("started_at")
  endedAt     DateTime?      @map("ended_at")

  user User @relation(fields: [userId], references: [id])

  @@index([tenantId, userId, startedAt])
  @@map("agent_state_logs")
}

// ─────────────────────────── Contacts (customer identity) ───────────────────────────

enum IdentityType {
  PHONE
  LINE
  FACEBOOK
  WHATSAPP
  EMAIL
  WEB
}

model Contact {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  identities     ContactIdentity[]
  interactions   Interaction[]
  conversations  Conversation[]
  cgRestrictions CgRestriction[]
  cgConsents     CgConsent[]
  cgDecisionLogs CgDecisionLog[]
  cgReservations CgReservation[]
  cgAttempts     CgAttempt[]
  cgTouches      CgTouch[]
  jrEnrollments  JrEnrollment[]
  jrActions      JrAction[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("contacts")
}

// รวม identity หลาย channel เป็น contact เดียว (เบอร์โทร + LINE ID + email = คนเดียวกัน)
model ContactIdentity {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  contactId String       @map("contact_id") @db.Uuid
  type      IdentityType
  value     String // เบอร์โทร / LINE user id / email ฯลฯ

  contact        Contact         @relation(fields: [contactId], references: [id])
  cgRestrictions CgRestriction[]
  cgConsents     CgConsent[]
  cgDecisionLogs CgDecisionLog[]
  cgReservations CgReservation[]
  cgAttempts     CgAttempt[]
  cgTouches      CgTouch[]
  jrActions      JrAction[]

  @@unique([tenantId, id])
  @@unique([tenantId, type, value])
  @@map("contact_identities")
}

// ─────────────────────────── Contact Governance & Journey Inbox ───────────────────────────

enum CgRestrictionType {
  DNC
  OBJECTION
  CONSENT_REVOKED
  INBOUND_SAFETY
  REGULATORY
}

enum CgConsentStatus {
  GRANTED
  REVOKED
  EXPIRED
}

enum CgDecision {
  ALLOW
  BLOCK
  DEFER
  REVIEW
}

enum CgReservationState {
  RESERVED
  CONFIRMED
  RELEASED
  REFUNDED
}

enum CgFactOutcome {
  PROVIDER_REJECTED
  DELIVERED
  DELIVERY_FAILED
}

enum CgDeliverySettlementStatus {
  UNCLAIMED
  CLAIMED
  UNKNOWN_RECONCILING
  ACCEPTED
  SETTLED
}

enum CgReservationCommandOperation {
  CLAIM
  RENEW
  BEGIN_SUBMISSION
  CONFIRM
  RELEASE
  SETTLE
}

enum JrEventInboxState {
  PENDING
  PUBLISHED
  PROCESSED
  FAILED
}

enum JrEnrollmentState {
  PENDING
  REVIEW
  BLOCKED
  DEFERRED
  AUTHORIZED
}

model CgRestriction {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  contactId   String?           @map("contact_id") @db.Uuid
  identityId  String?           @map("identity_id") @db.Uuid
  type        CgRestrictionType
  channel     ChannelType?
  purpose     String?
  scope       String
  overridable Boolean           @default(false)
  reasonCode  String            @map("reason_code")
  source      String
  evidence    Json?
  startsAt    DateTime          @default(now()) @map("starts_at")
  expiresAt   DateTime?         @map("expires_at")
  createdBy   String            @map("created_by")
  createdAt   DateTime          @default(now()) @map("created_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  contact  Contact?         @relation(fields: [contactId], references: [id])
  identity ContactIdentity? @relation(fields: [identityId], references: [id])

  @@index([tenantId, contactId, startsAt])
  @@index([tenantId, identityId, startsAt])
  @@index([tenantId, type, startsAt])
  @@map("cg_restrictions")
}

model CgConsent {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  contactId     String          @map("contact_id") @db.Uuid
  identityId    String?         @map("identity_id") @db.Uuid
  purpose       String
  channel       ChannelType
  status        CgConsentStatus
  lawfulBasis   String          @map("lawful_basis")
  noticeVersion String?         @map("notice_version")
  evidence      Json            @default("{}")
  grantedAt     DateTime?       @map("granted_at")
  revokedAt     DateTime?       @map("revoked_at")
  expiresAt     DateTime?       @map("expires_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  contact  Contact          @relation(fields: [contactId], references: [id])
  identity ContactIdentity? @relation(fields: [identityId], references: [id])

  @@index([tenantId, contactId, purpose, channel, status])
  @@index([tenantId, identityId, purpose, channel, status])
  @@map("cg_consents")
}

model CgReservation {
  id                  String                      @id @default(uuid()) @db.Uuid
  tenantId            String                      @map("tenant_id") @db.Uuid
  contactId           String                      @map("contact_id") @db.Uuid
  identityId          String?                     @map("identity_id") @db.Uuid
  channel             ChannelType
  purpose             String
  source              String
  sourceId            String                      @map("source_id")
  teamId              String?                     @map("team_id") @db.Uuid
  segmentSnapshot     Json?                       @map("segment_snapshot")
  scopeVersion        Int?                        @map("scope_version")
  actionKey           String                      @map("action_key")
  inputHash           String                      @map("input_hash")
  state               CgReservationState          @default(RESERVED)
  expiresAt           DateTime                    @map("expires_at")
  confirmedAt         DateTime?                   @map("confirmed_at")
  releasedAt          DateTime?                   @map("released_at")
  refundedAt          DateTime?                   @map("refunded_at")
  deliveryId          String?                     @map("delivery_id")
  senderIdentityId    String?                     @map("sender_identity_id")
  providerRequestKey  String?                     @map("provider_request_key")
  leaseVersion        Int?                        @map("lease_version")
  leaseExpiresAt      DateTime?                   @map("lease_expires_at")
  submissionStartedAt DateTime?                   @map("submission_started_at")
  settlementStatus    CgDeliverySettlementStatus? @map("settlement_status")
  terminalOutcome     CgFactOutcome?              @map("terminal_outcome")
  terminalOutcomeRef  String?                     @map("terminal_outcome_ref")
  settledAt           DateTime?                   @map("settled_at")
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")

  tenant          Tenant                        @relation(fields: [tenantId], references: [id])
  contact         Contact                       @relation(fields: [contactId], references: [id])
  identity        ContactIdentity?              @relation(fields: [identityId], references: [id])
  decisionLogs    CgDecisionLog[]
  journeyActions  JrAction[]
  attempts        CgAttempt[]
  touches         CgTouch[]
  commandReceipts CgReservationCommandReceipt[]

  @@unique([tenantId, id])
  @@unique([tenantId, actionKey])
  @@unique([tenantId, deliveryId])
  @@unique([tenantId, providerRequestKey])
  @@index([tenantId, contactId, state, createdAt])
  @@index([tenantId, state, expiresAt])
  @@index([tenantId, settlementStatus, leaseExpiresAt], map: "cg_reservations_tenant_id_settlement_status_lease_expiry_idx")
  @@map("cg_reservations")
}

/// ผลลัพธ์ durable ของ command เพื่อให้ duplicate คืน snapshot เดิมหลัง restart
model CgReservationCommandReceipt {
  id             String                        @id @default(uuid()) @db.Uuid
  tenantId       String                        @map("tenant_id") @db.Uuid
  reservationId  String                        @map("reservation_id") @db.Uuid
  operation      CgReservationCommandOperation
  idempotencyKey String                        @map("idempotency_key")
  inputHash      String                        @map("input_hash")
  response       Json
  createdAt      DateTime                      @default(now()) @map("created_at")

  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  reservation CgReservation @relation(fields: [tenantId, reservationId], references: [tenantId, id], map: "cg_reservation_command_receipts_tenant_reservation_fkey")

  @@unique([tenantId, operation, idempotencyKey], map: "cg_reservation_command_receipts_tenant_operation_key")
  @@index([tenantId, reservationId, createdAt], map: "cg_reservation_command_receipts_tenant_reservation_created_idx")
  @@map("cg_reservation_command_receipts")
}

/// Fact ของ Contact Governance แบบ immutable: หนึ่ง canonical attempt ต่อ outcomeRef ใน tenant
model CgAttempt {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  reservationId String        @map("reservation_id") @db.Uuid
  deliveryId    String        @map("delivery_id")
  outcomeRef    String        @map("outcome_ref")
  contactId     String        @map("contact_id") @db.Uuid
  identityId    String?       @map("identity_id") @db.Uuid
  channel       ChannelType
  purpose       String
  source        String
  outcome       CgFactOutcome
  occurredAt    DateTime      @map("occurred_at")
  correlationId String        @map("correlation_id")
  causationId   String?       @map("causation_id")
  createdAt     DateTime      @default(now()) @map("created_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  reservation CgReservation    @relation(fields: [tenantId, reservationId], references: [tenantId, id])
  contact     Contact          @relation(fields: [tenantId, contactId], references: [tenantId, id])
  identity    ContactIdentity? @relation(fields: [tenantId, identityId], references: [tenantId, id])
  touch       CgTouch?

  @@unique([tenantId, id])
  @@unique([tenantId, outcomeRef])
  @@unique([tenantId, reservationId, deliveryId, outcomeRef], map: "cg_attempts_binding_key")
  @@index([tenantId, contactId, occurredAt])
  @@index([tenantId, reservationId, occurredAt])
  @@index([tenantId, deliveryId, occurredAt])
  @@map("cg_attempts")
}

/// Successful Touch แบบ immutable ที่ตัดสินจาก policy ของ Contact Governance
model CgTouch {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  attemptId     String        @map("attempt_id") @db.Uuid
  reservationId String        @map("reservation_id") @db.Uuid
  deliveryId    String        @map("delivery_id")
  outcomeRef    String        @map("outcome_ref")
  contactId     String        @map("contact_id") @db.Uuid
  identityId    String?       @map("identity_id") @db.Uuid
  channel       ChannelType
  purpose       String
  source        String
  outcome       CgFactOutcome
  occurredAt    DateTime      @map("occurred_at")
  correlationId String        @map("correlation_id")
  causationId   String?       @map("causation_id")
  createdAt     DateTime      @default(now()) @map("created_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  attempt     CgAttempt        @relation(fields: [tenantId, attemptId], references: [tenantId, id])
  reservation CgReservation    @relation(fields: [tenantId, reservationId], references: [tenantId, id])
  contact     Contact          @relation(fields: [tenantId, contactId], references: [tenantId, id])
  identity    ContactIdentity? @relation(fields: [tenantId, identityId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, attemptId])
  @@unique([tenantId, outcomeRef])
  @@unique([tenantId, reservationId, deliveryId, outcomeRef], map: "cg_touches_binding_key")
  @@index([tenantId, contactId, occurredAt])
  @@index([tenantId, reservationId, occurredAt])
  @@index([tenantId, deliveryId, occurredAt])
  @@map("cg_touches")
}

model CgDecisionLog {
  id              String      @id @default(uuid()) @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  contactId       String?     @map("contact_id") @db.Uuid
  identityId      String?     @map("identity_id") @db.Uuid
  channel         ChannelType
  purpose         String
  source          String
  sourceId        String      @map("source_id")
  teamId          String?     @map("team_id") @db.Uuid
  segmentSnapshot Json?       @map("segment_snapshot")
  scopeVersion    Int?        @map("scope_version")
  actionKey       String      @map("action_key")
  inputHash       String?     @map("input_hash")
  decision        CgDecision
  reasonCode      String      @map("reason_code")
  policyVersion   Int         @map("policy_version")
  gate            String
  trace           Json
  reservationId   String?     @map("reservation_id") @db.Uuid
  decidedAt       DateTime    @default(now()) @map("decided_at")

  tenant             Tenant           @relation(fields: [tenantId], references: [id])
  contact            Contact?         @relation(fields: [contactId], references: [id])
  identity           ContactIdentity? @relation(fields: [identityId], references: [id])
  reservation        CgReservation?   @relation(fields: [reservationId], references: [id])
  journeyEnrollments JrEnrollment[]
  journeyActions     JrAction[]

  @@index([tenantId, actionKey, decidedAt])
  @@index([tenantId, contactId, decidedAt])
  @@map("cg_decision_logs")
}

model JrEventInbox {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  source          String
  eventId         String            @map("event_id")
  eventType       String            @map("event_type")
  occurredAt      DateTime          @map("occurred_at")
  payload         Json
  payloadHash     String            @map("payload_hash")
  state           JrEventInboxState @default(PENDING)
  publishAttempts Int               @default(0) @map("publish_attempts")
  lastError       String?           @map("last_error")
  publishedAt     DateTime?         @map("published_at")
  processedAt     DateTime?         @map("processed_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  enrollments JrEnrollment[]

  @@unique([tenantId, source, eventId])
  @@index([tenantId, state, createdAt])
  @@map("jr_event_inbox")
}

/// Journey-owned durable completion record for its Kafka consumer boundary.
