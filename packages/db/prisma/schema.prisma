  @@unique([tenantId, id])
  @@unique([tenantId, sourceTable, sourceKey])
  @@map("cg4_backfill_ledger")
}

/// CG4.10 (#193): development rollout ของ #178 ทุก stage ไม่มี provider traffic
enum Cg4RolloutStage {
  DISABLED
  SHADOW_EVALUATION
  SCOPED_SYNTHETIC
  INTERNAL_ENABLED
}

/// CG4.10 (#193): ไม่มีแถว = DISABLED. switchedAt ตั้งครั้งเดียวเมื่อเข้า SCOPED_SYNTHETIC และหลังจากนั้น
/// trigger cg4_rollout_state_guard ห้ามกลับไป DISABLED/SHADOW_EVALUATION (#179 §6 ห้ามย้อน writer)
model Cg4RolloutState {
  id                 String          @id @default(uuid()) @db.Uuid
  tenantId           String          @map("tenant_id") @db.Uuid
  stage              Cg4RolloutStage @default(DISABLED)
  syntheticScopeKeys String[]        @default([]) @map("synthetic_scope_keys")
  shadowStartedAt    DateTime?       @map("shadow_started_at")
  switchedAt         DateTime?       @map("switched_at")
  mutationFrozen     Boolean         @default(false) @map("mutation_frozen")
  version            Int
  updatedByRef       String          @map("updated_by_ref")
  evidenceRef        String          @map("evidence_ref")
  updatedAt          DateTime        @map("updated_at")

  @@unique([tenantId, id])
  @@unique([tenantId])
  @@map("cg4_rollout_state")
}

/// CG4.10 (#193): ประวัติ transition/freeze แบบ append-only
model Cg4RolloutTransition {
  id                 String          @id @default(uuid()) @db.Uuid
  tenantId           String          @map("tenant_id") @db.Uuid
  action             String
  fromStage          Cg4RolloutStage @map("from_stage")
  toStage            Cg4RolloutStage @map("to_stage")
  fromVersion        Int             @map("from_version")
  toVersion          Int             @map("to_version")
  mutationFrozen     Boolean         @map("mutation_frozen")
  syntheticScopeKeys String[]        @map("synthetic_scope_keys")
  reasonCode         String          @map("reason_code")
  actorRef           String          @map("actor_ref")
  evidenceRef        String          @map("evidence_ref")
  stateDigest        String          @map("state_digest") @db.Char(64)
  occurredAt         DateTime        @map("occurred_at")
  createdAt          DateTime        @default(now()) @map("created_at")

  @@unique([tenantId, id])
  @@unique([tenantId, toVersion])
  @@map("cg4_rollout_transition")
}

/// CG4.10 (#193): shadow evaluation ที่ผลของ CG3 loader กับ head-based evaluator ต่างกัน เก็บเฉพาะ digest
model Cg4ShadowMismatch {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  decisionId         String   @map("decision_id") @db.Uuid
  requestScopeKey    String   @map("request_scope_key")
  pilot              Boolean
  cg3Digest          String   @map("cg3_digest") @db.Char(64)
  cg4Digest          String   @map("cg4_digest") @db.Char(64)
  cg3PolicyVersion   Int?     @map("cg3_policy_version")
  cg4PolicyVersionId String?  @map("cg4_policy_version_id") @db.Uuid
  cg4Outcome         String   @map("cg4_outcome")
  detectedAt         DateTime @map("detected_at")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([tenantId, id])
  @@unique([tenantId, decisionId])
  @@index([tenantId, detectedAt])
  @@map("cg4_shadow_mismatch")
}

model JrEventInbox {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  source          String
  eventId         String            @map("event_id")
  eventType       String            @map("event_type")
  occurredAt      DateTime          @map("occurred_at")
  payload         Json
  payloadHash     String            @map("payload_hash")
  state           JrEventInboxState @default(PENDING)
  publishAttempts Int               @default(0) @map("publish_attempts")
  lastError       String?           @map("last_error")
  publishedAt     DateTime?         @map("published_at")
  processedAt     DateTime?         @map("processed_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  enrollments JrEnrollment[]

  @@unique([tenantId, source, eventId])
  @@index([tenantId, state, createdAt])
  @@map("jr_event_inbox")
}

/// Journey-owned durable completion record for its Kafka consumer boundary.
model JrKafkaConsumerInbox {
  consumerGroup String   @map("consumer_group")
  tenantId      String   @map("tenant_id") @db.Uuid
  eventId       String   @map("event_id")
  completedAt   DateTime @default(now()) @map("completed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([consumerGroup, tenantId, eventId])
  @@index([tenantId, completedAt])
  @@map("jr_kafka_consumer_inbox")
}

/// C1.5 ขยาย enrollment ให้เป็น durable execution cursor: `event_inbox_id` ถูกผ่อนเป็น
/// nullable เพราะ Schedule trigger ไม่มี event ตั้งต้น และ `(current_step_id, step_sequence)`
/// เป็นตำแหน่งเดียวที่บอกว่า enrollment เดินไปถึงไหน — worker ทุกตัวต้อง CAS ที่ step_sequence
model JrEnrollment {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  eventInboxId     String?           @map("event_inbox_id") @db.Uuid
  occurrenceId     String?           @map("occurrence_id") @db.Uuid
  /// J2.7: enrollment ที่เกิดจาก INTERACTION_OUTCOME trigger — nullable เหมือน
  /// eventInboxId/occurrenceId เพราะ trigger source ของ enrollment มีได้แบบเดียวเท่านั้น
  ///
  /// ชี้ receipt revision แรกของ logical outcome ที่ทำให้ journey นี้ match — correction
  /// revision ถัดไปของ outcome เดิม re-evaluate enrollment ใบนี้ ไม่สร้างใบใหม่ (#123) และ
  /// receipt หนึ่งใบ fan-out ได้หลาย published journey จึง unique ระดับ (receipt, journey)
  outcomeReceiptId String?           @map("outcome_receipt_id") @db.Uuid
  /// J3.7 (#218): enrollment ที่เกิดจาก SEGMENT_ENTRY trigger
  ///
  /// ผูกกับ "intent" ไม่ใช่ receipt เหมือน outcomeReceiptId เพราะ segment หนึ่ง revision
  /// fan-out ไปได้หลาย journey พร้อมกัน ส่วน intent เป็นหนึ่งใบต่อ (journey, version, entry)
  /// อยู่แล้ว ความสัมพันธ์จึงเป็น 1:1 จริง และ unique ด้านล่างบังคับได้ตรงไปตรงมา
  segmentIntentId  String?           @map("segment_intent_id") @db.Uuid
  journeyId        String?           @map("journey_id") @db.Uuid
  journeyVersion   Int               @map("journey_version")
  contactId        String?           @map("contact_id") @db.Uuid
  decisionId       String?           @map("decision_id") @db.Uuid
  state            JrEnrollmentState @default(PENDING)
  runState         JrRunState        @default(RUNNING) @map("run_state")
  currentStepId    String?           @map("current_step_id")
  stepSequence     Int               @default(0) @map("step_sequence")
  waitUntil        DateTime?         @map("wait_until")
  maxAgeAt         DateTime?         @map("max_age_at")
  terminalReason   JrTerminalReason? @map("terminal_reason")
  terminalStepId   String?           @map("terminal_step_id")
  terminalAt       DateTime?         @map("terminal_at")
  claimedBy        String?           @map("claimed_by")
  claimExpiresAt   DateTime?         @map("claim_expires_at")
  correlationId    String?           @map("correlation_id")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  tenant         Tenant                @relation(fields: [tenantId], references: [id])
  eventInbox     JrEventInbox?         @relation(fields: [eventInboxId], references: [id])
  occurrence     JrScheduleOccurrence? @relation(fields: [occurrenceId], references: [id])
  outcomeReceipt JrOutcomeReceipt?     @relation(fields: [outcomeReceiptId], references: [id])
  segmentIntent  JrSegmentEnrollmentIntent? @relation(fields: [tenantId, segmentIntentId], references: [tenantId, id])
  contact        Contact?              @relation(fields: [contactId], references: [id])
  decision       CgDecisionLog?        @relation(fields: [decisionId], references: [id])
  actions        JrAction[]
  stepRuns       JrStepRun[]

  @@unique([tenantId, id])
  @@unique([tenantId, eventInboxId])
  @@unique([tenantId, occurrenceId], map: "jr_enrollments_tenant_occurrence_key")
  @@unique([tenantId, outcomeReceiptId, journeyId], map: "jr_enrollments_tenant_outcome_receipt_journey_key")
  @@unique([tenantId, segmentIntentId], map: "jr_enrollments_tenant_segment_intent_key")
  @@index([tenantId, contactId, state])
  @@index([tenantId, runState, waitUntil], map: "jr_enrollments_tenant_run_state_wait_until_idx")
  @@index([tenantId, runState, maxAgeAt], map: "jr_enrollments_tenant_run_state_max_age_idx")
  @@map("jr_enrollments")
}

/// หนึ่งแถวต่อหนึ่ง occurrence ของ Schedule trigger — unique key กัน cron ที่ยิงซ้ำ
/// (ตัว scheduler เอง, worker หลายตัว หรือ restart) ไม่ให้ enroll ซ้ำใน tenant เดียวกัน
model JrScheduleOccurrence {
  id             String                    @id @default(uuid()) @db.Uuid
  tenantId       String                    @map("tenant_id") @db.Uuid
  journeyId      String                    @map("journey_id") @db.Uuid
  journeyVersion Int                       @map("journey_version")
  occurrenceAt   DateTime                  @map("occurrence_at")
  state          JrScheduleOccurrenceState @default(CLAIMED)
  correlationId  String                    @map("correlation_id")
  createdAt      DateTime                  @default(now()) @map("created_at")

  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  enrollments JrEnrollment[]

  @@unique([tenantId, id])
  @@unique([tenantId, journeyId, journeyVersion, occurrenceAt], map: "jr_schedule_occurrences_tenant_occurrence_key")
  @@index([tenantId, state, occurrenceAt], map: "jr_schedule_occurrences_tenant_state_occurrence_idx")
  @@map("jr_schedule_occurrences")
}

/// Ledger ของทุก node ที่ enrollment เดินผ่าน `(enrollment_id, step_sequence)` เป็น unique
