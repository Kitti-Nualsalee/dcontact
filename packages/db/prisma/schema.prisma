  APPROVED
  PUBLISHED
  SCHEDULED
  ACTIVE
  SUPERSEDED
  REJECTED
  WITHDRAWN
}

enum Cg4ApprovalDecision {
  APPROVED
  REJECTED
}

// CG4.5 (#188): semantic diff class of a policy version; decides the required quorum per #173 §2
enum Cg4PolicyDiffClass {
  TIGHTENING
  NEUTRAL
  RELAXATION
}

enum Cg4PolicyTestOutcome {
  PASS
  FAIL
}

enum Cg4ActivationJobState {
  PENDING
  CLAIMED
  COMPLETE
  FAILED
  CANCELLED
}

enum Cg4ExceptionScopeKind {
  IDENTITY
  CONTACT_WIDE
}

// Workflow state per #177. `Cg4ExceptionHead.status` is the authority; a revision row
// keeps whatever status it was inserted with (always PENDING) because `cg_exception` is
// insert-only. EXPIRED is an *effective* state computed from database time at evaluation
// and is never persisted here — persisting it would make the expiry scheduler a
// correctness authority, which #177 forbids.
enum Cg4ExceptionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REVOKED
  EXPIRED
  SUPERSEDED
}

enum Cg4ExceptionTier {
  STANDARD
  HIGH
  EMERGENCY
}

enum Cg4KillSwitchState {
  ACTIVE
  CLEARED
}

enum Cg4CapabilitySource {
  DIRECT
  DELEGATED
  // CG4.10 (#193): an original CG3 approval carried over as baseline evidence, usable only for a LEGACY_CG3 version
  LEGACY_MIGRATED
}

/// CG4.10 (#193): origin of a policy version — the CG4 writer or a backfill from cg_policies of CG3
enum Cg4PolicyOrigin {
  CG4
  LEGACY_CG3
}

enum Cg4AuthenticationStrength {
  STANDARD
  STRONG
}

enum JrEventInboxState {
  PENDING
  PUBLISHED
  PROCESSED
  FAILED
}

enum JrEnrollmentState {
  PENDING
  REVIEW
  BLOCKED
  DEFERRED
  AUTHORIZED
}

/// C1.5: progress state of an enrollment, separate from `JrEnrollmentState`, which records the authorize result
enum JrRunState {
  RUNNING
  WAITING
  TERMINAL
}

/// The single reason an enrollment ended — recorded once, first time only, never overwritten
enum JrTerminalReason {
  GRAPH_EXIT
  GOAL_REACHED
  EXIT_RULE
  MAX_AGE
  CANCELLED
}

enum JrStepRunState {
  COMPLETED
  AWAITING_SEND
}

enum JrScheduleOccurrenceState {
  CLAIMED
  ENROLLED
}

/// S1.5: Journey owns the lifecycle of an action after receiving a CG3 mutation. This value tells
/// the boundary that can be cancelled; it is not the state of a reservation or provider delivery.
enum JrRealtimeActionState {
  QUEUED
  RESERVED
  PRE_BARRIER
  POST_BARRIER
  ACCEPTED
  CANCELLED
  DEFERRED
  PARKED
  HELD
  CANCEL_REQUESTED
  SETTLED
}

/// Durable result of a CG3 event in the Journey consumer. GAP/QUARANTINED must fail closed
/// and must not let an action go back to dispatch until replay/reconcile succeeds.
enum JrGovernanceConsumerState {
  APPLIED
  NO_OP
  GAP
  QUARANTINED
  // CG4.8 (#191): version+digest repeats one already applied but with a different eventId; the cursor does not move
  DUPLICATE
}

enum JrGovernanceAcknowledgementState {
  PENDING
  PUBLISHED
  FAILED
}

/// External work of Journey that must happen only after the owner-local inbox/action commit
enum JrGovernanceEffectState {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum JrGovernanceEffectKind {
  RELEASE_BEFORE_BARRIER
  REQUEST_RECONCILE
}

enum JrActionLifecycleState {
  PRE_BARRIER
  POST_BARRIER
  ACCEPTED
}

/// S1.7: Dialer keeps its own raw outbound attempt and uses this state for
/// CG3 invalidation only; it is not the source of truth for a reservation or policy.
enum ObAttemptRealtimeState {
  QUEUED
  RESERVED
  PRE_BARRIER
  POST_BARRIER
  ACCEPTED
  IN_PROGRESS
  CANCELLED
  DEFERRED
  PARKED
  HELD
  CANCEL_REQUESTED
  SETTLED
}

enum ObGovernanceConsumerState {
  APPLIED
  NO_OP
  GAP
  QUARANTINED
  // CG4.8 (#191): version+digest repeats one already applied but with a different eventId; the cursor does not move
  DUPLICATE
}

enum ObGovernanceAcknowledgementState {
  PENDING
  PUBLISHED
  FAILED
}

enum ObGovernanceEffectState {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum ObGovernanceEffectKind {
  RELEASE_BEFORE_BARRIER
  REQUEST_RECONCILE
}

model CgRestriction {
