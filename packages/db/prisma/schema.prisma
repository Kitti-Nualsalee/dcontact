  invalidationReason       String?   @map("invalidation_reason")
  updatedAt                DateTime  @default(dbgenerated("clock_timestamp()")) @map("updated_at") @db.Timestamptz(6)

  @@id([tenantId, userId, leaseId])
  @@map("c360_work_mutation_auth")
}

