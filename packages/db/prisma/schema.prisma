  availableAt        DateTime                @default(now()) @map("available_at")
  completedAt        DateTime?               @map("completed_at")
  lastError          String?                 @map("last_error")
  createdAt          DateTime                @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, eventId, attemptId, kind])
  @@index([tenantId, state, availableAt])
  @@map("ob_governance_effect_outbox")
}

// ──────────────────────── J2.5: Dialer ADMIT_CAMPAIGN_TARGET owner ────────────────────────
// Dialer is the full canonical writer of ob_campaign_* — Journey cannot create/start/pause/edit
// a Campaign and does not originate/send here (see #133 scope J2.5); admission applies only to an
// existing campaign

enum ObCampaignStatus {
  ACTIVE
  SCHEDULED
  PAUSED
  STOPPED
  COMPLETED
}

/// ADMITTED = originate normally when the campaign is active; DEFERRED = admission succeeded but the
/// campaign is still scheduled/paused — both report the result as J2OwnerResultStatus 'ADMITTED'
/// because Journey only cares whether admission succeeded, not the internal pacing/schedule
enum ObCampaignTargetState {
  ADMITTED
  DEFERRED
  /// J2.9: originate barrier claimed a governance reservation, TEST_ADAPTER pending
  ORIGINATING
  /// J2.9: TEST_ADAPTER accepted — simulated call in progress
  ACTIVE
  /// J2.9: simulated call settled (terminal, no further origination for this target)
  CONSUMED
  /// J2.9 follow-up: the originate lease expired while stuck in ORIGINATING (e.g. the process died midway)
  /// — needs the CG3 primitive/a human to decide; never originate again and never release the reservation itself
  RECONCILING
  /// J2.8: CANCEL_CAMPAIGN_TARGET before reaching the originate barrier (terminal)
  CANCELLED
  /// J2.8: SUPERSEDE_CAMPAIGN_TARGET before reaching the originate barrier (terminal)
  SUPERSEDED
}

/// J2.9 (#137): rollout of the Dialer originate barrier — moves forward one step at a time and no state has provider I/O
enum ObOriginateRolloutState {
  DISABLED
  /// checks the current scope and stops, without touching Governance/owner state
  SHADOW_RECEIPT
  /// checks all owner-side conditions (campaign/callback/scope) and stops before reserving a Governance reservation
  OWNER_CONFORMANCE
  /// reserves a reservation + TEST_ADAPTER originate only for scopes in ob_originate_rollout_scopes
  SCOPED_INTERNAL_ENABLED
}

enum ObOriginateRolloutScopeKind {
  CAMPAIGN
  CALLBACK_QUEUE
}

/// J2.9 (#137): per-tenant gate that every Dialer instance reads together — kill wins over every state and cannot be undone
model ObOriginateRollout {
  id           String                   @id @default(uuid()) @db.Uuid
  tenantId     String                   @map("tenant_id") @db.Uuid
  state        ObOriginateRolloutState  @default(DISABLED)
  pendingState ObOriginateRolloutState? @map("pending_state")
  pendingByRef String?                  @map("pending_by_ref")
  killed       Boolean                  @default(false)
  killTrigger  String?                  @map("kill_trigger")
  killedAt     DateTime?                @map("killed_at")
  version      Int                      @default(1)
  updatedByRef String                   @map("updated_by_ref")
  updatedAt    DateTime                 @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId])
  @@map("ob_originate_rollout_state")
}

/// J2.9 (#137): allowlist of SCOPED_INTERNAL_ENABLED — outside the list nothing originates even when the gate is open to the last stage
model ObOriginateRolloutScope {
  id         String                      @id @default(uuid()) @db.Uuid
  tenantId   String                      @map("tenant_id") @db.Uuid
  scopeKind  ObOriginateRolloutScopeKind @map("scope_kind")
  scopeRef   String                      @map("scope_ref") @db.Uuid
  addedByRef String                      @map("added_by_ref")
  createdAt  DateTime                    @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, scopeKind, scopeRef])
  @@map("ob_originate_rollout_scopes")
}

/// J2.9 (#137): append-only audit of the gate
model ObOriginateRolloutAudit {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  action     String
  actorRole  String   @map("actor_role")
  actorRef   String   @map("actor_ref")
  detail     String
  occurredAt DateTime @default(now()) @map("occurred_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, occurredAt])
  @@map("ob_originate_rollout_audit")
}

/// fixture of a campaign that "already exists" — no Campaign CRUD/UI in J2.5 (out of scope)
model ObCampaign {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  key       String
  status    ObCampaignStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@map("ob_campaigns")
}

/// versioned policy per campaign — decides only duplicate contacts across campaigns;
/// a duplicate within one campaign is always enforced by the unique constraint of ob_campaign_targets
model ObCampaignAdmissionPolicy {
  id                          String   @id @default(uuid()) @db.Uuid
  tenantId                    String   @map("tenant_id") @db.Uuid
  campaignId                  String   @map("campaign_id") @db.Uuid
  version                     Int      @default(1)
  allowCrossCampaignDuplicate Boolean  @default(false) @map("allow_cross_campaign_duplicate")
  createdAt                   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, campaignId])
  @@map("ob_campaign_admission_policies")
}

/// one canonical target record per (campaign, contact) — the recordId/version that the J2
/// ownerAggregate refers to; no Governance reservation, Attempt or provider I/O here
model ObCampaignTarget {
  id                        String                @id @default(uuid()) @db.Uuid
  tenantId                  String                @map("tenant_id") @db.Uuid
  campaignId                String                @map("campaign_id") @db.Uuid
  contactId                 String                @map("contact_id") @db.Uuid
  version                   Int                   @default(1)
  state                     ObCampaignTargetState @default(ADMITTED)
  sourceOwnerTeamId         String                @map("source_owner_team_id") @db.Uuid
  targetOwnerTeamId         String                @map("target_owner_team_id") @db.Uuid
  admissionPolicyVersion    Int                   @map("admission_policy_version")
  /// J2.9 follow-up: set on entering ORIGINATING and cleared on leaving — the sweeper uses it to tell
  /// "really originating right now" from "stuck because the process died"
  originateLeaseExpiresAt   DateTime?             @map("originate_lease_expires_at")
  cancelledAt               DateTime?             @map("cancelled_at")
  cancelReasonCode          String?               @map("cancel_reason_code")
  supersededAt              DateTime?             @map("superseded_at")
  supersedingOutcomeType    String?               @map("superseding_outcome_type")
  supersedingOutcomeId      String?               @map("superseding_outcome_id") @db.Uuid
  supersedingOutcomeVersion Int?                  @map("superseding_outcome_version")
  createdAt                 DateTime              @default(now()) @map("created_at")
  updatedAt                 DateTime              @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  contact Contact @relation(fields: [tenantId, contactId], references: [tenantId, id])

  @@unique([tenantId, campaignId, contactId])
  @@index([tenantId, contactId])
  @@index([tenantId, state, originateLeaseExpiresAt], map: "ob_campaign_targets_originate_lease_idx")
  @@map("ob_campaign_targets")
}

/// one durable command+result per actionKey — a pull model like cs_command_inbox
/// of J2.4; commandType is kept for SCHEDULE_CALLBACK, CANCEL_x and SUPERSEDE_x of
/// a later ticket, even though J2.5 populates only ADMIT_CAMPAIGN_TARGET
model ObDialerCommandInbox {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  commandId        String   @map("command_id")
  actionKey        String   @map("action_key")
  commandType      String   @map("command_type")
  requestHash      String   @map("request_hash") @db.Char(64)
  status           String
  code             String
  category         String
  reasonCode       String   @map("reason_code")
  failureClass     String   @map("failure_class")
  retryDisposition String   @map("retry_disposition")
  recordId         String?  @map("record_id") @db.Uuid
  recordVersion    Int?     @map("record_version")
  correlationId    String   @map("correlation_id")
  observedAt       DateTime @map("observed_at")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  /// J2.8: cancel/supersede reuse the actionKey of the positive effect but with a new commandId (J2.1
  /// contract) — one receipt per command, so it is unique on commandId, not actionKey
  @@unique([tenantId, commandId], map: "ob_dialer_command_inbox_tenant_command_key")
  @@index([tenantId, actionKey, commandType], map: "ob_dialer_command_inbox_tenant_action_idx")
  @@map("ob_dialer_command_inbox")
}

// ─────────────────── J2.6: Dialer SCHEDULE_CALLBACK/CANCEL/SUPERSEDE owner ───────────────────
// reuses the existing ob_dialer_command_inbox of J2.5 (commandType was kept in reserve) — only
// the canonical ob_callbacks is added here; no actual originate/telephony command in J2.6 (out of scope)

/// Only SCHEDULED is reversible; ORIGINATING/ACTIVE/CONSUMED are fixture-only states
/// that simulate progress from the real originate mechanism, which is not built in J2.6 — used only to test the
/// irreversible boundary (answers TOO_LATE)
enum ObCallbackState {
  SCHEDULED
  ORIGINATING
  ACTIVE
  CONSUMED
  CANCELLED
  SUPERSEDED
  /// J2.9 follow-up: same meaning as ObCampaignTargetState.RECONCILING
  RECONCILING
}

/// one canonical Callback record per successful SCHEDULE_CALLBACK — no Governance
/// reservation or telephony command here; the real originate is a later ticket
model ObCallback {
  id                        String          @id @default(uuid()) @db.Uuid
  tenantId                  String          @map("tenant_id") @db.Uuid
  contactId                 String          @map("contact_id") @db.Uuid
  queueId                   String          @map("queue_id") @db.Uuid
  agentId                   String?         @map("agent_id") @db.Uuid
  requestedFor              DateTime        @map("requested_for")
  expiresAt                 DateTime        @map("expires_at")
  state                     ObCallbackState @default(SCHEDULED)
  version                   Int             @default(1)
  sourceOwnerTeamId         String          @map("source_owner_team_id") @db.Uuid
  targetOwnerTeamId         String          @map("target_owner_team_id") @db.Uuid
  cancelledAt               DateTime?       @map("cancelled_at")
  cancelReasonCode          String?         @map("cancel_reason_code")
  supersededAt              DateTime?       @map("superseded_at")
  supersedingOutcomeType    String?         @map("superseding_outcome_type")
  supersedingOutcomeId      String?         @map("superseding_outcome_id") @db.Uuid
  supersedingOutcomeVersion Int?            @map("superseding_outcome_version")
  /// J2.9 follow-up: same meaning as ObCampaignTarget.originateLeaseExpiresAt
  originateLeaseExpiresAt   DateTime?       @map("originate_lease_expires_at")
  /// #1061: JOURNEY (J2) or AGENT (scheduled by an Agent from their work)
  origin                    String          @default("JOURNEY")
  sourceInteractionId       String?         @map("source_interaction_id") @db.Uuid
  /// #1061: the PHONE identity to dial (an internal number in round one)
  identityId                String?         @map("identity_id") @db.Uuid
  note                      String?
  createdByUserId           String?         @map("created_by_user_id") @db.Uuid
  /// #1061: moved to the team because the Agent was not online 15 minutes after the time
  escalatedAt               DateTime?       @map("escalated_at") @db.Timestamptz
  lastReasonCode            String?         @map("last_reason_code")
  attemptInteractionId      String?         @map("attempt_interaction_id") @db.Uuid
  attemptCount              Int             @default(0) @map("attempt_count")
  /// #1061: Governance reservation of the dial attempt in progress (confirmed or released when it settles)
  attemptReservationId      String?         @map("attempt_reservation_id") @db.Uuid
  createdAt                 DateTime        @default(now()) @map("created_at")
  updatedAt                 DateTime        @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  contact Contact @relation(fields: [tenantId, contactId], references: [tenantId, id])

  @@unique([tenantId, id], map: "ob_callbacks_tenant_id_key")
  @@index([tenantId, contactId, state])
  @@index([tenantId, state, originateLeaseExpiresAt], map: "ob_callbacks_originate_lease_idx")
  @@map("ob_callbacks")
}

/// #1061: timeline of an agent callback (no phone number, no note text); append-only
model ObCallbackEvent {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  callbackId    String    @map("callback_id") @db.Uuid
  kind          String
  actorUserId   String?   @map("actor_user_id") @db.Uuid
  reasonCode    String?   @map("reason_code")
  requestedFor  DateTime? @map("requested_for") @db.Timestamptz
  interactionId String?   @map("interaction_id") @db.Uuid
  decisionId    String?   @map("decision_id")
  occurredAt    DateTime  @default(dbgenerated("clock_timestamp()")) @map("occurred_at") @db.Timestamptz

  @@index([tenantId, callbackId, occurredAt, id], map: "ob_callback_events_callback_idx")
  @@map("ob_callback_events")
}

// ─────────────────────── J2.3: outcome/action durable foundation ───────────────────────
// Journey owns these receipts/actions/commands/results only — they are not the canonical
// Case/Campaign/Callback state of the owner per #121; there is no trigger matching, owner
// implementation or real relay transport here yet (J2.3 is schema/primitive only)

/// Processing result of each receipt — matches the diagram confirmed in #123
/// (RETRYABLE_FAILURE is transient during retry only and is not persisted as a separate state;
/// a retryable row is sent back to READY with a backoff on `availableAt`)
enum JrOutcomeReceiptState {
  RECEIVED
  WAITING_FOR_GAP
  READY
  PROCESSING
  APPLIED
  IGNORED_SUPERSEDED
  REVIEW
  QUARANTINED
}

enum JrOwnerActionKind {
  ENSURE_CASE
  ADMIT_CAMPAIGN_TARGET
  SCHEDULE_CALLBACK
}

/// Matches every state of the business action lifecycle confirmed in #123
enum JrOwnerActionState {
  PENDING
  DISPATCHED
  ACKNOWLEDGED
  REJECTED
  ACK_UNKNOWN
  CANCEL_REQUESTED
  CANCELLED
  /// J2.8: the real result of SUPERSEDE_CALLBACK/SUPERSEDE_CAMPAIGN_TARGET
  SUPERSEDED
  TOO_LATE
  RECONCILING
}

enum JrOwnerCommandState {
  PENDING
  /// J2.8: claimed while calling the owner port — prevents different workers from claiming twice
  PROCESSING
  SENT
  FAILED
  /// J2.8: the action was cancelled before the command left Journey — must never be dispatched
  CANCELLED
}

/// Results the owner can send back — separate from JrOwnerActionState because PENDING/DISPATCHED/
/// CANCEL_REQUESTED are not a "result" the owner sends back
enum JrOwnerResultKind {
  ACKNOWLEDGED
  REJECTED
  ACK_UNKNOWN
  CANCELLED
  SUPERSEDED
  TOO_LATE
  RECONCILING
}

enum JrOwnerResultOutcome {
  APPLIED
  DUPLICATE
  CONFLICT
}

/// J5.0 — an owner result that affects only the Journey cursor
enum JrOwnerContinuationOutcome {
  ADVANCED
  TERMINAL_IGNORED
}

enum JrRecoveryOperation {
  REPLAY
  RECONCILE
  CANCEL
  SKIP_QUARANTINE
  /// J3.5 (#216): orders membership to be re-evaluated through the re-filter cursor, not by editing the receipt/head directly
  REVALIDATE
}

enum JrRecoveryTargetKind {
  RECEIPT
  ACTION
  /// J3.5 (#216): added additively — the two original values still mean J2 receipt/action as before
  SEGMENT_RECEIPT
  SEGMENT_REFILTER
}

/// J2.3 — durable receipt of one canonical interaction outcome revision; transport
/// identity `(source, eventId)` is separate from the logical stream identity
/// `(outcomeType, outcomeId, outcomeVersion)` as confirmed in #123; no raw contact
/// data — only internal IDs, hashes and metadata
model JrOutcomeReceipt {
  id               String                @id @default(uuid()) @db.Uuid
  tenantId         String                @map("tenant_id") @db.Uuid
  source           String
  eventId          String                @map("event_id")
  outcomeType      String                @map("outcome_type")
  outcomeId        String                @map("outcome_id") @db.Uuid
  outcomeVersion   Int                   @map("outcome_version")
  payloadHash      String                @map("payload_hash") @db.Char(64)
  /// J2.7: the `InteractionOutcomePayloadV1` that has passed `assertInteractionOutcomeEnvelope` —
  /// internal IDs/codes only, no raw PII; needed for trigger matching and for creating the owner
  /// command in the apply phase, separate from ingest (`JourneyOutcomeReceiptRepository.ingest`, which itself
  /// is still only a hash-based dedup/ordering ledger per J2.3)
  payload          Json
  state            JrOutcomeReceiptState @default(RECEIVED)
  attempts         Int                   @default(0)
  leaseOwner       String?               @map("lease_owner")
  leaseExpiresAt   DateTime?             @map("lease_expires_at")
  availableAt      DateTime              @default(now()) @map("available_at")
  reviewReasonCode String?               @map("review_reason_code")
  lastError        String?               @map("last_error")
  correlationId    String                @map("correlation_id")
  causationId      String?               @map("causation_id")
  receivedAt       DateTime              @default(now()) @map("received_at")
  appliedAt        DateTime?             @map("applied_at")

  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  enrollments JrEnrollment[]

  @@unique([tenantId, source, eventId])
  @@unique([tenantId, outcomeType, outcomeId, outcomeVersion])
  @@index([tenantId, state, availableAt])
  @@map("jr_outcome_receipts")
}

/// head of one logical outcome stream — equivalent to `CgContactStateHead` of CG3
/// but scoped to J2's own `(outcomeType, outcomeId)`, not a contact aggregate
model JrOutcomeHead {
  tenantId             String   @map("tenant_id") @db.Uuid
  outcomeType          String   @map("outcome_type")
  outcomeId            String   @map("outcome_id") @db.Uuid
  lastAppliedVersion   Int      @default(0) @map("last_applied_version")
  lastAppliedReceiptId String?  @map("last_applied_receipt_id") @db.Uuid
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, outcomeType, outcomeId])
  @@map("jr_outcome_heads")
}

/// J2.3 — a Journey-owned record of one owner action intent, tied to the stable
/// `actionKey = enrollmentId:journeyVersion:stepId` per #123; keeps only the owner
/// aggregate reference/version as an audit snapshot, not canonical owner state
model JrOwnerAction {
  id                    String             @id @default(uuid()) @db.Uuid
  tenantId              String             @map("tenant_id") @db.Uuid
  actionKey             String             @map("action_key")
  enrollmentId          String             @map("enrollment_id") @db.Uuid
  /// J5.0: the cursor position that created this action. A null value means a legacy action that
  /// cannot prove its binding deterministically and therefore must not advance the enrollment
  stepId                String?            @map("step_id")
  stepSequence          Int?               @map("step_sequence")
  outcomeReceiptId      String?            @map("outcome_receipt_id") @db.Uuid
  kind                  JrOwnerActionKind
  requestHash           String             @map("request_hash") @db.Char(64)
  state                 JrOwnerActionState @default(PENDING)
  ownerAggregateRef     String?            @map("owner_aggregate_ref")
  ownerAggregateVersion Int?               @map("owner_aggregate_version")
  /// J2.8 follow-up: optimistic-concurrency token of the action itself — advances every time the state
  /// changes so the admin recovery API can enforce expectedVersion (attempts cannot be used instead
  /// because it counts only dispatches and does not advance on cancel)
  version               Int                @default(1)
  attempts              Int                @default(0)
  dispatchedAt          DateTime?          @map("dispatched_at")
  acknowledgedAt        DateTime?          @map("acknowledged_at")
  cancelRequestedAt     DateTime?          @map("cancel_requested_at")
  lastError             String?            @map("last_error")
  correlationId         String             @map("correlation_id")
  createdAt             DateTime           @default(now()) @map("created_at")

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  continuation JrOwnerContinuation?

  @@unique([tenantId, id])
  @@unique([tenantId, actionKey])
  @@index([tenantId, enrollmentId])
  @@index([tenantId, state])
  @@map("jr_owner_actions")
}

/// transactional outbox of commands to relay to the owner — J2.3 has only the table/primitive;
/// the real relay transport is in the scope of a later ticket
model JrOwnerCommandOutbox {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  commandId     String              @map("command_id")
  actionId      String              @map("action_id") @db.Uuid
  actionKey     String              @map("action_key")
  kind          JrOwnerActionKind
  requestHash   String              @map("request_hash") @db.Char(64)
  /// J2.8: the full J2OwnerCommandPayloadV1 envelope ready for relay — null for commands from before
  /// J2.8 whose payload cannot be reconstructed from the old fragments
  payload       Json?
  correlationId String              @map("correlation_id")
  state         JrOwnerCommandState @default(PENDING)
  attempts      Int                 @default(0)
  availableAt   DateTime            @default(now()) @map("available_at")
  sentAt        DateTime?           @map("sent_at")
  lastError     String?             @map("last_error")
  createdAt     DateTime            @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, commandId])
  @@index([tenantId, state, availableAt])
  @@map("jr_owner_command_outbox")
}

/// inbox of results the owner sends back per command — an idempotent apply per
/// `(tenantId, commandId)`; a repeated/conflicting result does not move the action's state again
model JrOwnerResultInbox {
  id                    String               @id @default(uuid()) @db.Uuid
  tenantId              String               @map("tenant_id") @db.Uuid
  commandId             String               @map("command_id")
  actionKey             String               @map("action_key")
  resultKind            JrOwnerResultKind    @map("result_kind")
  ownerAggregateRef     String?              @map("owner_aggregate_ref")
  ownerAggregateVersion Int?                 @map("owner_aggregate_version")
  resultHash            String               @map("result_hash") @db.Char(64)
  outcome               JrOwnerResultOutcome @default(APPLIED)
  correlationId         String               @map("correlation_id")
  receivedAt            DateTime             @default(now()) @map("received_at")

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  continuation JrOwnerContinuation?

  @@unique([tenantId, commandId])
  @@index([tenantId, actionKey])
  @@map("jr_owner_result_inbox")
}

/// J5.0 — one ledger row per owner action that has decided the cursor
///
/// this row, the step run and the enrollment CAS are committed in the same transaction as the owner result;
/// the unique action/command lets push, pull reconcile and retry advance the cursor at most once
model JrOwnerContinuation {
  id               String                     @id @default(uuid()) @db.Uuid
  tenantId         String                     @map("tenant_id") @db.Uuid
  actionId         String                     @map("action_id") @db.Uuid
  actionKey        String                     @map("action_key")
  commandId        String                     @map("command_id")
  enrollmentId     String                     @map("enrollment_id") @db.Uuid
  fromStepId       String                     @map("from_step_id")
  fromStepSequence Int                        @map("from_step_sequence")
  resultKind       JrOwnerResultKind          @map("result_kind")
  nextStepId       String?                    @map("next_step_id")
  outcome          JrOwnerContinuationOutcome
  resultHash       String                     @map("result_hash") @db.Char(64)
  correlationId    String                     @map("correlation_id")
  createdAt        DateTime                   @default(now()) @map("created_at")

  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  action     JrOwnerAction      @relation(fields: [tenantId, actionId], references: [tenantId, id])
  result     JrOwnerResultInbox @relation(fields: [tenantId, commandId], references: [tenantId, commandId])
  enrollment JrEnrollment       @relation(fields: [tenantId, enrollmentId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, actionId])
  @@unique([tenantId, commandId])
  @@index([tenantId, enrollmentId, fromStepSequence])
  @@map("jr_owner_continuations")
}

/// append-only audit of manual recovery (replay/reconcile/cancel/skip-quarantine)
/// only — the table reuses the original identity; never edit a canonical row/offset/receipt directly
model JrRecoveryAudit {
  id          String               @id @default(uuid()) @db.Uuid
  tenantId    String               @map("tenant_id") @db.Uuid
  operation   JrRecoveryOperation
  targetKind  JrRecoveryTargetKind @map("target_kind")
  /// the original opaque reference that can be reused (eventId/outcomeId or actionKey), not raw PII
  targetRef   String               @map("target_ref")
  reasonCode  String               @map("reason_code")
  actorId     String               @map("actor_id") @db.Uuid
  evidenceRef String?              @map("evidence_ref")
  occurredAt  DateTime             @default(now()) @map("occurred_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, targetKind, targetRef, occurredAt])
  @@map("jr_recovery_audit")
}

// ───────────────────── J3.5: Journey segment receipt/head/intent/re-filter ─────────────────────
// J3 owns this whole set of tables itself, completely separate from jr_event_inbox of J1 and jr_outcome_* of J2
// (stop condition #216 forbids repurposing the existing tables) and has no shared write to any c360_*

enum JrSegmentReceiptState {
  RECEIVED
  WAITING_FOR_GAP
  READY
  PROCESSING
  APPLIED
  IGNORED_SUPERSEDED
  REVIEW
  QUARANTINED
}

/// lifecycle of one re-filter job — HELD means it is set aside because an owner action is pending,
/// and DEFERRED means the scope/context is not ready and evaluation must restart, not wait and pass by itself
enum JrSegmentRefilterState {
  PENDING
  REVALIDATING
  NO_OP
  CANCELLED
  DEFERRED
  HELD
  RECONCILING
}

enum JrSegmentOutboxState {
  PENDING
  PROCESSING
  SENT
  FAILED
}

/// durable receipt of one revision of a membership change
///
/// transport identity `(source, eventId)` is separate from the logical identity
/// `(contactId, segmentId, membershipRevision)` — a broker redelivery collides on transport while
/// the same revision arriving as a different event collides on logical; both cases must not create a second row
///
/// the payload is not stored as Json but broken into fully known fields, because the acceptance of #216
/// requires that raw attributes/identity/PII must not be in J3 rows — storing a blob makes it impossible to prove that
/// nobody will one day stuff a raw attribute in; the only values really needed are a reference and a digest
model JrSegmentReceipt {
  id                       String                @id @default(uuid()) @db.Uuid
  tenantId                 String                @map("tenant_id") @db.Uuid
  source                   String
  eventId                  String                @map("event_id")
  contactId                String                @map("contact_id") @db.Uuid
  segmentId                String                @map("segment_id")
  membershipRevision       Int                   @map("membership_revision")
  changeKind               String                @map("change_kind")
  /// entry of that segment entry — null when the change did not create an entry (LEFT/invalidation)
  entryId                  String?               @map("entry_id")
  supersedesRevision       Int?                  @map("supersedes_revision")
  segmentDefinitionVersion Int                   @map("segment_definition_version")
  payloadHash              String                @map("payload_hash") @db.Char(64)
  /// a reference to Customer 360 evidence, not the evidence itself
  evidenceRef              String?               @map("evidence_ref")
  state                    JrSegmentReceiptState @default(RECEIVED)
  attempts                 Int                   @default(0)
  leaseOwner               String?               @map("lease_owner")
  leaseExpiresAt           DateTime?             @map("lease_expires_at")
  availableAt              DateTime              @default(now()) @map("available_at")
  reviewReasonCode         String?               @map("review_reason_code")
  lastError                String?               @map("last_error")
  correlationId            String                @map("correlation_id")
  causationId              String?               @map("causation_id")
  receivedAt               DateTime              @default(now()) @map("received_at")
  appliedAt                DateTime?             @map("applied_at")
  /// J3.8 (#219): optimistic-concurrency token — advances every time the state changes
  ///
  /// deliberately separate from `attempts`: attempts advances only on retry and not when the state changes for
  /// other reasons; using it as the token would make an operator see the old value although things changed, which is exactly the blind
  /// retry the acceptance says must be rejected
  version                  Int                   @default(1)

  tenant    Tenant                      @relation(fields: [tenantId], references: [id])
  contact   Contact                     @relation(fields: [tenantId, contactId], references: [tenantId, id])
  intents   JrSegmentEnrollmentIntent[]
  refilters JrSegmentRefilterCursor[]
  outbox    JrSegmentOutbox[]

  @@unique([tenantId, id])
  @@unique([tenantId, source, eventId])
  @@unique([tenantId, contactId, segmentId, membershipRevision])
  @@index([tenantId, state, availableAt])
  @@index([tenantId, contactId, segmentId, membershipRevision])
  @@map("jr_segment_receipts")
}

/// head of one membership stream from J3's point of view
///
/// `lastAppliedRevision` only moves forward (enforced by CHECK + CAS) and terminal* is
/// first-terminal protection: once an entry has ended, a later revision must not resurrect it
model JrSegmentHead {
  tenantId             String   @map("tenant_id") @db.Uuid
  contactId            String   @map("contact_id") @db.Uuid
  segmentId            String   @map("segment_id")
  lastAppliedRevision  Int      @default(0) @map("last_applied_revision")
  lastAppliedReceiptId String?  @map("last_applied_receipt_id") @db.Uuid
  terminalEntryId      String?  @map("terminal_entry_id")
  terminalRevision     Int?     @map("terminal_revision")
  terminalReasonCode   String?  @map("terminal_reason_code")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  contact Contact @relation(fields: [tenantId, contactId], references: [tenantId, id])

  @@id([tenantId, contactId, segmentId])
  @@index([tenantId, segmentId])
  @@map("jr_segment_heads")
}

/// one enrollment intent created by entering a segment
///
/// keeps a "reason" only as a reference/version/digest and is immutable (enforced by a trigger)
/// — if attribute values or the segment definition JSON were stored, the reason would become a copy that drifts from
/// Customer 360 as soon as the definition is edited, and Journey would own data it does not own
model JrSegmentEnrollmentIntent {
  id                       String   @id @default(uuid()) @db.Uuid
  tenantId                 String   @map("tenant_id") @db.Uuid
  journeyId                String   @map("journey_id")
  journeyVersion           Int      @map("journey_version")
  contactId                String   @map("contact_id") @db.Uuid
  segmentId                String   @map("segment_id")
  entryId                  String   @map("entry_id")
  receiptId                String   @map("receipt_id") @db.Uuid
  reasonMembershipRevision Int      @map("reason_membership_revision")
  reasonDefinitionVersion  Int      @map("reason_definition_version")
  reasonEvidenceRef        String?  @map("reason_evidence_ref")
  reasonDigest             String   @map("reason_digest") @db.Char(64)
  correlationId            String   @map("correlation_id")
  createdAt                DateTime @default(now()) @map("created_at")

  tenant  Tenant           @relation(fields: [tenantId], references: [id])
  contact Contact          @relation(fields: [tenantId, contactId], references: [tenantId, id])
  receipt JrSegmentReceipt @relation(fields: [tenantId, receiptId], references: [tenantId, id])

  enrollment JrEnrollment?

  @@unique([tenantId, id])
  @@unique([tenantId, journeyId, journeyVersion, contactId, segmentId, entryId])
  @@index([tenantId, receiptId])
  @@map("jr_segment_enrollment_intents")
}

/// a re-filter job caused by a membership change that did not bring in a new enrollment
model JrSegmentRefilterCursor {
  id                 String                 @id @default(uuid()) @db.Uuid
  tenantId           String                 @map("tenant_id") @db.Uuid
  contactId          String                 @map("contact_id") @db.Uuid
  segmentId          String                 @map("segment_id")
  membershipRevision Int                    @map("membership_revision")
  receiptId          String                 @map("receipt_id") @db.Uuid
  state              JrSegmentRefilterState @default(PENDING)
  attempts           Int                    @default(0)
  leaseOwner         String?                @map("lease_owner")
  leaseExpiresAt     DateTime?              @map("lease_expires_at")
  availableAt        DateTime               @default(now()) @map("available_at")
  reasonCode         String?                @map("reason_code")
  correlationId      String                 @map("correlation_id")
  /// populated only for restrictive IAM invalidation; prevents cancelling another team's work
  scopeTeamId        String?                @map("scope_team_id") @db.Uuid
  createdAt          DateTime               @default(now()) @map("created_at")
  settledAt          DateTime?              @map("settled_at")
  /// J3.8 (#219): optimistic-concurrency token like jr_segment_receipts.version
  version            Int                    @default(1)

  tenant  Tenant           @relation(fields: [tenantId], references: [id])
  contact Contact          @relation(fields: [tenantId, contactId], references: [tenantId, id])
  receipt JrSegmentReceipt @relation(fields: [tenantId, receiptId], references: [tenantId, id])

  /// a normal membership re-filter uses scopeTeamId = null; an IAM revoke is one job per team so that
  /// revoking one team must not cancel the Journey of another team in the same entry
  @@unique([tenantId, contactId, segmentId, membershipRevision, scopeTeamId])
  @@index([tenantId, state, availableAt])
  @@index([tenantId, scopeTeamId])
  @@map("jr_segment_refilter_cursors")
}

/// Durable dedup boundary for IAM scope invalidations consumed by Journey.
model JrIamScopeInvalidationInbox {
  consumer     String   @map("consumer")
  tenantId     String   @map("tenant_id") @db.Uuid
  eventId      String   @map("event_id")
  scopeVersion Int      @map("scope_version")
  completedAt  DateTime @default(now()) @map("completed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([consumer, tenantId, eventId])
  @@index([tenantId, scopeVersion])
  @@map("jr_iam_scope_invalidation_inbox")
}

/// local outbox of J3 — committed together with the receipt/head/intent in a single transaction
model JrSegmentOutbox {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @map("tenant_id") @db.Uuid
  receiptId     String               @map("receipt_id") @db.Uuid
  eventId       String               @map("event_id") @db.Uuid
  eventType     String               @map("event_type")
  orderingKey   String               @map("ordering_key")
  payloadHash   String               @map("payload_hash") @db.Char(64)
  payload       Json
  state         JrSegmentOutboxState @default(PENDING)
  attempts      Int                  @default(0)
  availableAt   DateTime             @default(now()) @map("available_at")
  lastError     String?              @map("last_error")
  correlationId String               @map("correlation_id")
  causationId   String?              @map("causation_id")
  createdAt     DateTime             @default(now()) @map("created_at")
  publishedAt   DateTime?            @map("published_at")

  tenant  Tenant           @relation(fields: [tenantId], references: [id])
  receipt JrSegmentReceipt @relation(fields: [tenantId, receiptId], references: [tenantId, id])

  @@unique([tenantId, eventId])
  @@index([tenantId, state, availableAt])
  @@map("jr_segment_outbox")
}

// ───────────────────── J3.10: Segment rollout stage and shadow evaluation ─────────────────────

/// order in which J3 is enabled per tenant — moves forward only; cannot go back across a switch point
enum JrSegmentRolloutStage {
  DISABLED
  /// the baseline membership exists but no event is accepted yet
  OWNER_BACKFILL
  /// accepts events and compares the digest with Customer 360 but still creates no effect
  SHADOW_MEMBERSHIP
  /// runs the real receipt/re-filter but still creates no enrollment
  SHADOW_RECEIPT_REFILTER
  /// fully enabled — enrollments can really be created
  SCOPED_INTERNAL_ENABLED
}

/// no row = DISABLED. switchedAt is set once on entering SCOPED_INTERNAL_ENABLED and afterwards
/// trigger jr_segment_rollout_guard forbids going back to an earlier stage
model JrSegmentRolloutState {
  id              String                @id @default(uuid()) @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  stage           JrSegmentRolloutStage @default(DISABLED)
  shadowStartedAt DateTime?             @map("shadow_started_at")
  switchedAt      DateTime?             @map("switched_at")
  /// rollback = stop new effects, not go back a stage or delete what already happened
  mutationFrozen  Boolean               @default(false) @map("mutation_frozen")
  version         Int                   @default(1)
  updatedByRef    String                @map("updated_by_ref")
  evidenceRef     String?               @map("evidence_ref")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId])
  @@map("jr_segment_rollout_state")
}

/// result of comparing what J3 computes with the canonical of Customer 360 during shadow
///
/// keeps only digests and revisions — no attribute values and no free-text reasons, because a mismatch
/// report is something people open during an incident and must not become a PII leak
model JrSegmentShadowMismatch {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  contactId          String   @map("contact_id") @db.Uuid
  segmentId          String   @map("segment_id")
  membershipRevision Int      @map("membership_revision")
  mismatchKind       String   @map("mismatch_kind")
  expectedDigest     String?  @map("expected_digest") @db.Char(64)
  observedDigest     String?  @map("observed_digest") @db.Char(64)
  detectedAt         DateTime @default(now()) @map("detected_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  contact Contact @relation(fields: [tenantId, contactId], references: [tenantId, id])

  @@unique([tenantId, contactId, segmentId, membershipRevision, mismatchKind])
  @@index([tenantId, detectedAt])
  @@map("jr_segment_shadow_mismatches")
}

// ─────────────────────────────── J2.4: Cases ENSURE_CASE owner ───────────────────────────────
// Cases is the full canonical writer of all cs_* — Journey has no direct database
// access and does not choose a caseId itself (per #121); this is a minimal slice for ENSURE_CASE
// only, not the full task/SLA product (see #132 scope J2.4)

enum CsCaseStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum CsActivityKind {
  CREATED
  LINKED
  REOPENED
  NOTE
  ASSIGNED
  STATUS_CHANGED
}

/// tenant-scoped fixture: caseTypePolicyRef (from a J2 intent) maps to the real case type
/// and reopen policy — not the fully metadata-driven type of C2 in the product spec
model CsCaseTypePolicy {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  policyRef     String   @map("policy_ref")
  caseTypeKey   String   @map("case_type_key")
  reopenAllowed Boolean  @default(false) @map("reopen_allowed")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, policyRef])
  @@map("cs_case_type_policies")
}

/// tenant-scoped fixture: routingPolicyRef maps to a queue — no real router assignment
/// at runtime in J2.4 (out of scope)
model CsRoutingPolicy {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  policyRef String   @map("policy_ref")
  queueRef  String   @map("queue_ref")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, policyRef])
  @@map("cs_routing_policies")
}

/// minimal canonical Case — version increases on every mutation to serve as ownerAggregate.version
/// in J2OwnerResultPayloadV1; no full type metadata/SLA/queue per the C1-C3 product spec
model CsCase {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  contactId   String       @map("contact_id") @db.Uuid
  caseTypeKey String       @map("case_type_key")
  routingRef  String?      @map("routing_ref")
  status      CsCaseStatus @default(OPEN)
  version     Int          @default(1)
  reopenCount Int          @default(0) @map("reopen_count")
  resolvedAt  DateTime?    @map("resolved_at")
  closedAt    DateTime?    @map("closed_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  /// #956 a case an Agent opens from work: has a subject, the team that sees the case, an owner and the source work. A
  /// case from J2 ENSURE_CASE has none of these values. FKs to teams/users are declared in the migration
  subject             String? @map("subject")
  teamId              String? @map("team_id") @db.Uuid
  assigneeUserId      String? @map("assignee_user_id") @db.Uuid
  createdByUserId     String? @map("created_by_user_id") @db.Uuid
  sourceInteractionId String? @map("source_interaction_id") @db.Uuid

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  contact Contact @relation(fields: [tenantId, contactId], references: [tenantId, id])

  @@index([tenantId, contactId, caseTypeKey, status])
  @@index([tenantId, teamId, status, updatedAt(sort: Desc)], map: "cs_cases_tenant_team_status_updated_idx")
  @@map("cs_cases")
}

/// closed-case correction: never reopen silently — open a new case and link it RELATED to the original case
model CsCaseLink {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  caseId        String   @map("case_id") @db.Uuid
  relatedCaseId String   @map("related_case_id") @db.Uuid
  kind          String   @default("RELATED")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, caseId, relatedCaseId, kind])
  @@map("cs_case_links")
}

/// the single timeline of a case; a row from J2 ENSURE_CASE holds only an opaque outcome reference
/// a row made by an Agent (#956) has an actor, and the note is free text the Agent wrote
model CsCaseActivity {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  caseId         String         @map("case_id") @db.Uuid
  kind           CsActivityKind
  interactionId  String?        @map("interaction_id")
  outcomeType    String?        @map("outcome_type")
  outcomeId      String?        @map("outcome_id") @db.Uuid
  outcomeVersion Int?           @map("outcome_version")
  correlationId  String?        @map("correlation_id")
  occurredAt     DateTime       @default(now()) @map("occurred_at")
  actorUserId    String?        @map("actor_user_id") @db.Uuid
  body           String?
  fromStatus     CsCaseStatus?  @map("from_status")
  toStatus       CsCaseStatus?  @map("to_status")
  assigneeUserId String?        @map("assignee_user_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, caseId, occurredAt])
  @@map("cs_case_activities")
}

/// one durable command+result per actionKey — J2OwnerPort is a pull model
/// (queryAction reads from here), so no separate outbox/relay is needed for the ENSURE_CASE result
model CsCommandInbox {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  commandId        String   @map("command_id")
  actionKey        String   @map("action_key")
  requestHash      String   @map("request_hash") @db.Char(64)
  status           String
  code             String
  category         String
  reasonCode       String   @map("reason_code")
  failureClass     String   @map("failure_class")
  retryDisposition String   @map("retry_disposition")
  caseId           String?  @map("case_id") @db.Uuid
  caseVersion      Int?     @map("case_version")
  correlationId    String   @map("correlation_id")
  observedAt       DateTime @map("observed_at")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, actionKey])
  @@index([tenantId, commandId])
  @@map("cs_command_inbox")
}

enum JrJourneyDefinitionStatus {
  DRAFT
  PUBLISHED
}

/// C1.4: one row per immutable version of a Journey definition — the content
/// (trigger/graph/goal/exitRules/maxDurationDays) is not edited after creation; publish is only a
/// DRAFT -> PUBLISHED state transition, idempotent per (tenantId, journeyId, version)
model JrJourneyDefinition {
  id               String                    @id @default(uuid()) @db.Uuid
  tenantId         String                    @map("tenant_id") @db.Uuid
  journeyId        String                    @map("journey_id") @db.Uuid
  version          Int
  name             String
  ownerTeamId      String                    @map("owner_team_id") @db.Uuid
  /// consent/policy purpose (e.g. MARKETING, SERVICE) that every SEND node in this version uses to call
  /// authorizeAndReserve — C1.6 reads this value instead of letting each SEND step declare it itself
  purpose          String
  /// sender identity bound to the delivery binding — C1 is TEST_ADAPTER only
  senderIdentityId String                    @map("sender_identity_id")
  status           JrJourneyDefinitionStatus @default(DRAFT)
  trigger          Json
  graph            Json
  goal             Json
  exitRules        Json                      @map("exit_rules")
  maxDurationDays  Int                       @map("max_duration_days")
  inputHash        String                    @map("input_hash")
  correlationId    String                    @map("correlation_id")
  publishedAt      DateTime?                 @map("published_at")
  createdAt        DateTime                  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, id])
  @@unique([tenantId, journeyId, version])
  @@index([tenantId, journeyId, status])
  @@map("jr_journey_definitions")
}

// ─────────────────────────── Delivery outbox (Channels/Dialer) ───────────────────────────

enum DlDeliveryState {
  QUEUED
  SUBMITTING
  SUBMITTED
  RECONCILING
  SETTLED
}

/// C1 enables only TEST_ADAPTER; S2 (#365) adds LINE_MESSAGING_API for the capped pilot
/// each worker claims only its own adapter (mixed-version guard in OutboxRepository)
enum DlDeliveryAdapter {
  TEST_ADAPTER
  LINE_MESSAGING_API
  FREESWITCH_ORIGINATE
}

/// C1.3: durable outbox of Channels/Dialer — one row per delivery that has been claimed successfully
/// the row is always persisted before answering QUEUED and `(tenant_id, action_key)` is the single idempotency identity
/// of the adapter: the same input replays the same delivery, a different input is a conflict
/// only opaque ids/refs may be stored — no message body, phone, email or external contact reference
model DlOutboxEntry {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  actionKey          String            @map("action_key")
  reservationId      String            @map("reservation_id") @db.Uuid
  deliveryId         String            @map("delivery_id")
  providerRequestKey String            @map("provider_request_key")
  adapter            DlDeliveryAdapter @default(TEST_ADAPTER)
  channel            ChannelType
  contactId          String            @map("contact_id") @db.Uuid
  identityId         String?           @map("identity_id") @db.Uuid
  purpose            String
  source             String
  senderIdentityId   String            @map("sender_identity_id")
  /// a reference that the channel owner resolves into content — not the content itself
  contentRef         String            @map("content_ref")
  inputHash          String            @map("input_hash")
  state              DlDeliveryState   @default(QUEUED)
  /// the lease returned by the claim, used as the expected version of beginProviderSubmission
  leaseVersion       Int               @map("lease_version")
  leaseExpiresAt     DateTime          @map("lease_expires_at")
  submittedAt        DateTime?         @map("submitted_at")
  outcome            CgFactOutcome?
  outcomeRef         String?           @map("outcome_ref")
  settledAt          DateTime?         @map("settled_at")
  correlationId      String            @map("correlation_id")
  causationId        String?           @map("causation_id")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  reservation CgReservation @relation(fields: [tenantId, reservationId], references: [tenantId, id], map: "dl_outbox_entries_tenant_reservation_fkey")

  @@unique([tenantId, actionKey], map: "dl_outbox_entries_tenant_action_key")
  @@unique([tenantId, deliveryId], map: "dl_outbox_entries_tenant_delivery_key")
  @@unique([tenantId, providerRequestKey], map: "dl_outbox_entries_tenant_provider_request_key")
  @@unique([tenantId, outcomeRef], map: "dl_outbox_entries_tenant_outcome_ref_key")
  @@unique([tenantId, deliveryId, providerRequestKey, adapter], map: "dl_outbox_entries_tenant_delivery_request_adapter_key")
  @@unique([tenantId, deliveryId, adapter], map: "dl_outbox_entries_tenant_delivery_adapter_key")
  @@index([tenantId, state, leaseExpiresAt], map: "dl_outbox_entries_tenant_state_lease_expiry_idx")
  @@map("dl_outbox_entries")
}

/// E1.18 (#520): state the Delivery owner uses before/after ordering a server originate;
/// settlement of a reservation always remains the authority of Contact Governance.
enum DlVoiceOriginateState {
  QUEUED
  CANCEL_REQUESTED
  RECONCILING
