  eventId        String                 @map("event_id")
  eventType      String                 @map("event_type")
  orderingKey    String                 @map("ordering_key")
  payload        Json
  payloadHash    String                 @map("payload_hash") @db.Char(64)
  occurredAt     DateTime               @map("occurred_at")
  state          DlLineEventOutboxState @default(PENDING)
  attempts       Int                    @default(0)
  availableAt    DateTime               @default(now()) @map("available_at")
  leaseOwner     String?                @map("lease_owner")
  leaseExpiresAt DateTime?              @map("lease_expires_at")
  publishedAt    DateTime?              @map("published_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  @@unique([tenantId, id], map: "dl_line_event_outbox_tenant_id_key")
  @@unique([tenantId, eventId], map: "dl_line_event_outbox_event_key")
  @@index([tenantId, state, availableAt, leaseExpiresAt], map: "dl_line_event_outbox_claim_idx")
  @@map("dl_line_event_outbox")
}

enum DlLineEventOutboxState {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
}

/// append-only audit of gate/kill/allowlist/run/cap/credential/provider/webhook — machine codes only
model DlLineAuditEvent {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  eventId        String              @map("event_id")
  category       DlLineAuditCategory
  code           String
  actorKind      DlLineActorKind     @map("actor_kind")
  actorRef       String              @map("actor_ref")
  subjectId      String?             @map("subject_id") @db.Uuid
  deliveryId     String?             @map("delivery_id")
