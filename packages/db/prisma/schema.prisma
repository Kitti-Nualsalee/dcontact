  @@map("cg_exception_approval")
}

// CG4.3 (#186): a maker-checker delegation grant per #173 §3 — exact capability, exact
// scope, a maximum risk tier and a hard <=8h window. Append-only: a delegation is never
// edited, only allowed to expire. `capability` is constrained at the DB layer (see
// migration) to the delegable set (cg.exception.request, cg.exception.approve.standard)
// so a stray write can never grant a HIGH/EMERGENCY or policy-publish/rollback capability
// by delegation.
model Cg4Delegation {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  delegatorSubjectId String   @map("delegator_subject_id")
  delegateSubjectId  String   @map("delegate_subject_id")
  capability         String
  scopeKey           String   @map("scope_key")
  grantVersion       Int      @map("grant_version")
  startsAt           DateTime @map("starts_at")
  expiresAt          DateTime @map("expires_at")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([tenantId, id])
  @@index([tenantId, delegateSubjectId, capability, scopeKey, expiresAt])
  @@map("cg_delegation")
}

model Cg4ScopeKillSwitch {
