  graph           Json
  goal            Json
  exitRules       Json                      @map("exit_rules")
  maxDurationDays Int                       @map("max_duration_days")
  inputHash       String                    @map("input_hash")
  correlationId   String                    @map("correlation_id")
  publishedAt     DateTime?                 @map("published_at")
