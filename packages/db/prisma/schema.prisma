  createdAt      DateTime              @default(now()) @map("created_at")

  @@unique([tenantId, id])
  @@unique([tenantId, policyId, policyVersion])
  @@index([tenantId, state, scheduledFor])
  @@map("cg_policy_activation_job")
}

model Cg4Exception {
  id                  String                @id @default(uuid()) @db.Uuid
