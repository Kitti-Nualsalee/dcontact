  grantedByRef String    @map("granted_by_ref")
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, id])
  @@unique([tenantId, subjectId, capability, scopeKey])
  @@index([tenantId, subjectId, expiresAt])
  @@map("cg_capability_grant")
}

// ─────────────────────────── CG4.6 events, inbox และ recovery ───────────────────────────
// Projection ฝั่งรับของ canonical event (#179 §4). ไม่ใช่ truth: cursor ของ consumer
// group คือแถว APPLIED ที่ version สูงสุด และทุก decision ที่ไม่ใช่ APPLY/DUPLICATE
// จะเปิด CgScopePause ค้างไว้จนกว่าจะ reload canonical state.
model CgConsumerInbox {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  consumerGroup    String          @map("consumer_group")
  eventId          String          @map("event_id") @db.Uuid
  aggregateType    CgAggregateType @map("aggregate_type")
  aggregateId      String          @map("aggregate_id") @db.Uuid
  aggregateVersion Int             @map("aggregate_version")
  eventType        String          @map("event_type")
  payloadHash      String          @map("payload_hash") @db.Char(64)
  state            CgInboxState
  detail           String?
  receivedAt       DateTime        @map("received_at")
  createdAt        DateTime        @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, id])
  @@unique([tenantId, consumerGroup, eventId])
  @@index([tenantId, consumerGroup, aggregateType, aggregateId, aggregateVersion])
  @@index([tenantId, consumerGroup, state])
  @@map("cg_consumer_inbox")
}

// Scope ที่ถูกกักไว้เพราะ stream ไม่ต่อเนื่องหรือขัดแย้งกัน readerต้อง fail closed
// สำหรับ scope นี้จนกว่าจะ reload canonical แล้ว clear (#176 §5, #179 §4).
model CgScopePause {
  id               String             @id @default(uuid()) @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  consumerGroup    String             @map("consumer_group")
  scopeKind        CgScopePauseKind   @map("scope_kind")
  /// contactId หรือ policy scopeKey แล้วแต่ scopeKind
  scopeRef         String             @map("scope_ref")
  state            CgScopePauseState  @default(ACTIVE)
  reason           CgScopePauseReason
  detail           String?
  eventId          String?            @map("event_id") @db.Uuid
  observedVersion  Int?               @map("observed_version")
  expectedVersion  Int?               @map("expected_version")
  pausedAt         DateTime           @map("paused_at")
  clearedAt        DateTime?          @map("cleared_at")
  clearedToVersion Int?               @map("cleared_to_version")
  createdAt        DateTime           @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, id])
  @@index([tenantId, consumerGroup, scopeKind, scopeRef, state])
  @@index([tenantId, state, pausedAt])
  @@map("cg_scope_pause")
}

// ─────────────────────────── CG4 canonical foundation ───────────────────────────
// ตารางกลุ่มนี้เป็น additive foundation ตาม #185. FK tenant-bound และ lifecycle
// orchestration จริงจะเริ่มใน CG4.3+; CG4.2 ไม่ย้าย writer จาก CG3.

model Cg4Policy {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  policyId        String          @map("policy_id") @db.Uuid
  version         Int
  scopeKey        String          @map("scope_key")
  content         Json
  contentDigest   String          @map("content_digest") @db.Char(64)
  registryVersion String          @map("registry_version")
  status          Cg4PolicyStatus @default(DRAFT)
  effectiveFrom   DateTime        @map("effective_from")
  effectiveTo     DateTime?       @map("effective_to")
  makerActorRef   String          @map("maker_actor_ref")
  submittedAt     DateTime?       @map("submitted_at")
  approvedAt      DateTime?       @map("approved_at")
  publishedAt     DateTime?       @map("published_at")
  supersedesId    String?         @map("supersedes_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")

  // CG4.5 (#188). draftRevision เป็น CAS token ของ draft ที่ยังแก้ได้; หลัง submit
  // content ถูก freeze และการแก้ต่อต้องสร้าง version ใหม่ (#176 §1). กลุ่ม
  // diffClass/testArtifactDigest/approvalDigest/baseHead* คือ binding ที่ approval
  // ผูกไว้ ใช้ตรวจ staleness ตอน publish โดยไม่ต้องเชื่อ payload จาก caller.
  schemaVersion      Int                 @default(1) @map("schema_version")
  evaluatorVersion   String              @default("CG4_EVALUATOR_V1") @map("evaluator_version")
  draftRevision      Int                 @default(1) @map("draft_revision")
  diffClass          Cg4PolicyDiffClass? @map("diff_class")
  testArtifactDigest String?             @map("test_artifact_digest") @db.Char(64)
  approvalDigest     String?             @map("approval_digest") @db.Char(64)
  baseHeadVersion    Int?                @map("base_head_version")
  baseHeadDigest     String?             @map("base_head_digest") @db.Char(64)
  activateAt         DateTime?           @map("activate_at")
  /// rollback สร้าง version ใหม่จาก content ของ version เป้าหมายเสมอ ห้าม pointer flip (#176 §6)
  rollbackOfId       String?             @map("rollback_of_id") @db.Uuid
  /// CG4.10 (#193): เปลี่ยนไม่ได้หลังสร้าง (trigger cg4_policy_origin_immutable); LEGACY_CG3 ต้องมี
  /// legacySourceRowId ชี้ cg_policies ต้นทาง และ map ได้ครั้งเดียวต่อ row (partial unique index)
  origin             Cg4PolicyOrigin     @default(CG4)
  legacySourceRowId  String?             @map("legacy_source_row_id") @db.Uuid

  @@unique([tenantId, id])
  @@unique([tenantId, policyId, version])
  @@index([tenantId, scopeKey, status])
  @@index([tenantId, rollbackOfId])
  @@map("cg_policy")
}

model Cg4PolicyScopeHead {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  scopeKey             String   @map("scope_key")
  headPolicyId         String   @map("head_policy_id") @db.Uuid
  headPolicyVersion    Int      @map("head_policy_version")
  headPolicyRevisionId String   @map("head_policy_revision_id") @db.Uuid
  updatedAt            DateTime @updatedAt @map("updated_at")

  // CG4.5 (#188): headVersion เป็น monotonic aggregate version สำหรับ CAS ตอน publish
  // (#176 §3) ส่วน nextActivationAt คือ `validUntil` bound ของ mutable head cache (#176 §5)
  headVersion      Int       @default(0) @map("head_version")
  headDigest       String    @map("head_digest") @db.Char(64)
  latestMutationId String?   @map("latest_mutation_id") @db.Uuid
  nextActivationAt DateTime? @map("next_activation_at")

  @@unique([tenantId, id])
  @@unique([tenantId, scopeKey])
  @@index([tenantId, headPolicyId, headPolicyVersion])
  @@map("cg_policy_scope_head")
}

model Cg4PolicyTestArtifact {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  policyId       String   @map("policy_id") @db.Uuid
  policyVersion  Int      @map("policy_version")
  suiteVersion   String   @map("suite_version")
  artifactDigest String   @map("artifact_digest") @db.Char(64)
  result         Json
  createdAt      DateTime @default(now()) @map("created_at")

  // CG4.5 (#188): artifact ผูกกับ content/fixture/head ที่ใช้รันจริง ไม่ใช่แค่ผลลัพธ์
  // อย่างเดียว — approval ที่ผูก artifact นี้จึงตรวจ staleness ได้ตอน publish (#176 §2)
  contentDigest         String               @map("content_digest") @db.Char(64)
  platformFixtureDigest String               @map("platform_fixture_digest") @db.Char(64)
  tenantFixtureDigest   String               @map("tenant_fixture_digest") @db.Char(64)
  baseHeadVersion       Int                  @map("base_head_version")
  baseHeadDigest        String               @map("base_head_digest") @db.Char(64)
  diffClass             Cg4PolicyDiffClass   @map("diff_class")
  outcome               Cg4PolicyTestOutcome
  passed                Int
  failed                Int

  @@unique([tenantId, id])
  // draft ยังแก้ได้ก่อน submit จึงมี artifact ได้หลายใบต่อ version — แยกกันด้วย content digest
  @@unique([tenantId, policyId, policyVersion, suiteVersion, contentDigest])
  @@index([tenantId, policyId, policyVersion, artifactDigest])
  @@map("cg_policy_test_artifact")
}

// CG4.3 (#186): columns from `capability` onward are the maker-checker authorization
// snapshot pinned at vote time — capability actually used, whether it came direct or
// via delegation, whether this checker held direct-Compliance/emergency authority,
// and the IAM epoch/scope version at evaluation. Re-validation compares the current
// subject snapshot's epoch/scopeVersion against these to detect a stale approval.
model Cg4PolicyApproval {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  policyId           String              @map("policy_id") @db.Uuid
  policyVersion      Int                 @map("policy_version")
  decision           Cg4ApprovalDecision
  approverRef        String              @map("approver_ref")
  evidenceRef        String              @map("evidence_ref")
  decidedAt          DateTime            @map("decided_at")
  capability         String
  capabilitySource   Cg4CapabilitySource @map("capability_source")
  delegationId       String?             @map("delegation_id") @db.Uuid
  directCompliance   Boolean             @map("direct_compliance")
  emergencyAuthority Boolean             @map("emergency_authority")
  authorizationEpoch Int                 @map("authorization_epoch")
  scopeVersion       Int                 @map("scope_version")
  createdAt          DateTime            @default(now()) @map("created_at")

  @@unique([tenantId, id])
  @@unique([tenantId, policyId, policyVersion, approverRef])
  @@index([tenantId, policyId, policyVersion, decidedAt])
  @@map("cg_policy_approval")
}

model Cg4PolicyActivationJob {
