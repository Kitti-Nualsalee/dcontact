  exceptionId         String                @map("exception_id") @db.Uuid
  revision            Int
  contactId           String                @map("contact_id") @db.Uuid
  identityId          String?               @map("identity_id") @db.Uuid
  scopeKind           Cg4ExceptionScopeKind @map("scope_kind")
  channel             ChannelType
  purpose             String
  sourceType          String                @map("source_type")
  sourceId            String                @map("source_id")
  allowedRuleCodes    String[]              @map("allowed_rule_codes")
  policyId            String                @map("policy_id") @db.Uuid
  policyVersion       Int                   @map("policy_version")
  policyContentDigest String                @map("policy_content_digest") @db.Char(64)
  registryVersion     String                @map("registry_version")
