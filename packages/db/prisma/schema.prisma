  updatedAt DateTime            @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@map("business_hours")
}

/// E1.9 (#483): work-session lease — a single work intake point per agent per tenant across every surface
/// only one unreleased lease can exist (partial unique index in the migration); does not expire while there is work
model AgentWorkSessionLease {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  /// workspace | dphone | embedded
  surface       String
  /// embedded only: the https origin of the system that embeds dphone
  hostOrigin    String?   @map("host_origin")
  acquiredAt    DateTime  @map("acquired_at")
  heartbeatAt   DateTime  @map("heartbeat_at")
  expiresAt     DateTime  @map("expires_at")
  releasedAt    DateTime? @map("released_at")
  /// released | takeover | expired | auth_revoked
  releaseReason String?   @map("release_reason")

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user          User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  sipCredential AgentSipCredential?

  @@map("agent_work_session_leases")
}

/// E1.10 (#484): SIP credential returned in plaintext once, storing only Digest A1 and bound to the work-session lease
model AgentSipCredential {
  workSessionLeaseId String    @id @map("work_session_lease_id") @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
