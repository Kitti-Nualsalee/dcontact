  @@id([planCode, version])
  @@unique([planCode, version, snapshotDigest], map: "pf_plan_versions_pin_key")
  @@map("pf_plan_versions")
}

/// A1.5 (#410) append-only: editing a non-identity field after submit, with a new digest of the payload
model PfRequestPayloadRevision {
