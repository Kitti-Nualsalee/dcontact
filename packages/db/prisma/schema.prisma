  admittedAt                   DateTime @default(dbgenerated("clock_timestamp()")) @map("admitted_at") @db.Timestamptz(6)
  isTombstone                  Boolean  @default(false) @map("is_tombstone")

  @@id([tenantId, actorIdentityKey, commandId])
  @@map("c360_profile_commands")
}

