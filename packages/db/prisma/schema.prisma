/// Immutable Contact Governance fact: one canonical attempt per outcomeRef in a tenant
model CgAttempt {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  reservationId String        @map("reservation_id") @db.Uuid
  deliveryId    String        @map("delivery_id")
  outcomeRef    String        @map("outcome_ref")
  contactId     String        @map("contact_id") @db.Uuid
  identityId    String?       @map("identity_id") @db.Uuid
  channel       ChannelType
  purpose       String
  source        String
  outcome       CgFactOutcome
  occurredAt    DateTime      @map("occurred_at")
  correlationId String        @map("correlation_id")
  causationId   String?       @map("causation_id")
  createdAt     DateTime      @default(now()) @map("created_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  reservation CgReservation    @relation(fields: [tenantId, reservationId], references: [tenantId, id])
  contact     Contact          @relation(fields: [tenantId, contactId], references: [tenantId, id])
  identity    ContactIdentity? @relation(fields: [tenantId, identityId], references: [tenantId, id])
  touch       CgTouch?

  @@unique([tenantId, id])
  @@unique([tenantId, outcomeRef])
  @@unique([tenantId, reservationId, deliveryId, outcomeRef], map: "cg_attempts_binding_key")
  @@index([tenantId, contactId, occurredAt])
  @@index([tenantId, reservationId, occurredAt])
  @@index([tenantId, deliveryId, occurredAt])
  @@map("cg_attempts")
}

/// Immutable successful Touch decided from a Contact Governance policy
model CgTouch {
  id                  String               @id @default(uuid()) @db.Uuid
  tenantId            String               @map("tenant_id") @db.Uuid
  attemptId           String               @map("attempt_id") @db.Uuid
  reservationId       String               @map("reservation_id") @db.Uuid
  deliveryId          String               @map("delivery_id")
  outcomeRef          String               @map("outcome_ref")
  contactId           String               @map("contact_id") @db.Uuid
  identityId          String?              @map("identity_id") @db.Uuid
  channel             ChannelType
  purpose             String
  source              String
  outcome             CgFactOutcome
  occurredAt          DateTime             @map("occurred_at")
  correlationId       String               @map("correlation_id")
  causationId         String?              @map("causation_id")
  /// S2: correlated Touch response evidence — both present or both absent (CHECK in the migration)
  /// unique `(tenant_id, response_evidence_ref)` is a partial index that Prisma cannot declare
  /// S2.2: `cg_touches_provider_accepted_evidence_check` enforces that a Touch on an accepted Attempt
  /// must always have evidence, and trigger `cg_touches_evidence_guard` enforces that the outcome must match
  /// the linked Attempt — both live in the migration because Prisma cannot declare CHECK/trigger
  evidenceKind        CgTouchEvidenceKind? @map("evidence_kind")
  responseEvidenceRef String?              @map("response_evidence_ref")
  createdAt           DateTime             @default(now()) @map("created_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  attempt     CgAttempt        @relation(fields: [tenantId, attemptId], references: [tenantId, id])
  reservation CgReservation    @relation(fields: [tenantId, reservationId], references: [tenantId, id])
  contact     Contact          @relation(fields: [tenantId, contactId], references: [tenantId, id])
  identity    ContactIdentity? @relation(fields: [tenantId, identityId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, attemptId])
  @@unique([tenantId, outcomeRef])
  @@unique([tenantId, reservationId, deliveryId, outcomeRef], map: "cg_touches_binding_key")
  @@index([tenantId, contactId, occurredAt])
  @@index([tenantId, reservationId, occurredAt])
  @@index([tenantId, deliveryId, occurredAt])
  @@map("cg_touches")
}

