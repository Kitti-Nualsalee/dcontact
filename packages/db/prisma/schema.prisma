/// CG4.10 (#193): development rollout of #178; no stage has provider traffic
enum Cg4RolloutStage {
  DISABLED
  SHADOW_EVALUATION
  SCOPED_SYNTHETIC
  INTERNAL_ENABLED
}

/// CG4.10 (#193): no row = DISABLED. switchedAt is set once on entering SCOPED_SYNTHETIC and afterwards
/// trigger cg4_rollout_state_guard forbids going back to DISABLED/SHADOW_EVALUATION (#179 §6 forbids moving the writer back)
model Cg4RolloutState {
  id                 String          @id @default(uuid()) @db.Uuid
  tenantId           String          @map("tenant_id") @db.Uuid
  stage              Cg4RolloutStage @default(DISABLED)
  syntheticScopeKeys String[]        @default([]) @map("synthetic_scope_keys")
  shadowStartedAt    DateTime?       @map("shadow_started_at")
  switchedAt         DateTime?       @map("switched_at")
  mutationFrozen     Boolean         @default(false) @map("mutation_frozen")
  version            Int
  updatedByRef       String          @map("updated_by_ref")
  evidenceRef        String          @map("evidence_ref")
  updatedAt          DateTime        @map("updated_at")

  @@unique([tenantId, id])
  @@unique([tenantId])
  @@map("cg4_rollout_state")
}

/// CG4.10 (#193): append-only history of transitions/freezes
model Cg4RolloutTransition {
  id                 String          @id @default(uuid()) @db.Uuid
  tenantId           String          @map("tenant_id") @db.Uuid
  action             String
  fromStage          Cg4RolloutStage @map("from_stage")
  toStage            Cg4RolloutStage @map("to_stage")
  fromVersion        Int             @map("from_version")
  toVersion          Int             @map("to_version")
  mutationFrozen     Boolean         @map("mutation_frozen")
  syntheticScopeKeys String[]        @map("synthetic_scope_keys")
  reasonCode         String          @map("reason_code")
  actorRef           String          @map("actor_ref")
  evidenceRef        String          @map("evidence_ref")
  stateDigest        String          @map("state_digest") @db.Char(64)
  occurredAt         DateTime        @map("occurred_at")
  createdAt          DateTime        @default(now()) @map("created_at")

  @@unique([tenantId, id])
  @@unique([tenantId, toVersion])
  @@map("cg4_rollout_transition")
}

/// CG4.10 (#193): shadow evaluation where the CG3 loader result and the head-based evaluator differ; keeps only the digest
model Cg4ShadowMismatch {
  id                 String   @id @default(uuid()) @db.Uuid
