// ── U1.1 (#429): UAT fixture pack and run record ───────────────────────────────
// Authority: Phase Contract #374, fixture/reset #376, evidence #379 — present only on the UAT stack

enum UatRunLifecycle {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum UatStepOutcome {
  PASS
  FAIL
  BLOCKED
}

enum UatSeverity {
  S1
  S2
  S3
  S4
}

enum UatStateLabel {
  REAL_STATE
  SIMULATION_ONLY
}

/// versioned fixture pack — rows cannot be edited/deleted (trigger); the same pack version with a different digest = fail closed
model UatFixturePack {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  environment String
  packVersion String   @map("pack_version")
  digest      String   @db.Char(64)
  buildSha    String   @map("build_sha")
  /// purely synthetic manifest: opaque refs, baseline document, SimulationFixtureV1 — no secret/PII
  manifest    Json
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([tenantId, id], map: "uat_fixture_packs_tenant_id_id_key")
  @@unique([tenantId, environment, packVersion], map: "uat_fixture_packs_version_key")
  @@map("uat_fixture_packs")
}

/// one UAT run — one ACTIVE row per tenant; cannot be edited once closed (trigger)
model UatRun {
  id            String          @id @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  fixturePackId String          @map("fixture_pack_id") @db.Uuid
  sequence      Int
  /// Journey draft of this run — null during an unfinished `start a new run` (resume with the same key)
  journeyId     String?         @map("journey_id") @db.Uuid
  lifecycle     UatRunLifecycle @default(ACTIVE)
  revision      Int             @default(1)
  openedByRef   String          @map("opened_by_ref")
  closedByRef   String?         @map("closed_by_ref")
  openedAt      DateTime        @map("opened_at")
  closedAt      DateTime?       @map("closed_at")

  @@unique([tenantId, id], map: "uat_runs_tenant_id_id_key")
  @@unique([tenantId, sequence], map: "uat_runs_sequence_key")
  @@index([tenantId, journeyId], map: "uat_runs_journey_idx")
  @@map("uat_runs")
}

/// append-only per-step result (#379) — can be recorded only for an ACTIVE run
model UatRunStepResult {
  id            String         @id @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  runId         String         @map("run_id") @db.Uuid
  stepId        String         @map("step_id")
  outcome       UatStepOutcome
  expected      String
  actual        String
  severity      UatSeverity?
  correlationId String?        @map("correlation_id")
  stateLabel    UatStateLabel  @map("state_label")
  recordedByRef String         @map("recorded_by_ref")
  recordedAt    DateTime       @map("recorded_at")

  @@unique([tenantId, id], map: "uat_run_step_results_tenant_id_id_key")
  @@index([tenantId, runId, recordedAt], map: "uat_run_step_results_run_idx")
  @@map("uat_run_step_results")
}

/// idempotency of UAT run commands — metadata-safe response only
model UatCommandReceipt {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  idempotencyKey String    @map("idempotency_key")
  commandName    String    @map("command_name")
  requestHash    String    @map("request_hash") @db.Char(64)
  /// the run this command created — used to resume a `start a new run` left pending after a crash
  runId          String?   @map("run_id") @db.Uuid
  response       Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")

  @@unique([tenantId, id], map: "uat_command_receipts_tenant_id_id_key")
  @@unique([tenantId, idempotencyKey], map: "uat_command_receipts_idempotency_key")
  @@map("uat_command_receipts")
}

enum UatScanStatus {
  PASSED
  FAILED
}

/// U1.5 (#433): metadata of the screenshot evidence — the bytes are in the private object storage of the UAT stack
/// (key = uat-evidence/<tenant>/<run>/<id>, retention 90 days) append-only and can be added only to an ACTIVE run
model UatRunEvidence {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  runId         String   @map("run_id") @db.Uuid
  stepId        String   @map("step_id")
  /// image/png or image/jpeg only (magic bytes checked)
  contentType   String   @map("content_type")
  sizeBytes     Int      @map("size_bytes")
  sha256        String   @db.Char(64)
  storageKey    String   @map("storage_key")
  recordedByRef String   @map("recorded_by_ref")
  recordedAt    DateTime @map("recorded_at")

  @@unique([tenantId, id], map: "uat_run_evidence_tenant_id_id_key")
  @@index([tenantId, runId, recordedAt], map: "uat_run_evidence_run_idx")
  @@map("uat_run_evidence")
}

/// U1.5 (#433): negative scan result of a run, append-only — one row per input digest;
/// findings hold only the kind + position, not the matched text
model UatRunScan {
  id             String        @id @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  runId          String        @map("run_id") @db.Uuid
  scannerVersion String        @map("scanner_version")
  inputDigest    String        @map("input_digest") @db.Char(64)
  status         UatScanStatus
  severity       UatSeverity?
  findings       Json
  scannedByRef   String        @map("scanned_by_ref")
  scannedAt      DateTime      @map("scanned_at")

  @@unique([tenantId, id], map: "uat_run_scans_tenant_id_id_key")
  @@unique([tenantId, runId, inputDigest], map: "uat_run_scans_input_key")
  @@map("uat_run_scans")
}

// ─────────────────────────── A1.5 (#410) tenant operational baseline ───────────────────────────

enum BusinessHoursStatus {
  DRAFT
  ACTIVE
}

/// tenant defaults from provisioning — locale/timezone and the bootstrap manifest used for seeding
model TenantSettings {
