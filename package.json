{
  "name": "d-contact",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "git ls-files -z | xargs -0 prettier --check --ignore-unknown",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @d-contact/db generate",
    "db:migrate": "pnpm --filter @d-contact/db migrate:deploy",
    "db:rls": "pnpm --filter @d-contact/db apply-rls",
    "db:seed": "pnpm --filter @d-contact/db seed",
    "infra:up": "pnpm infra:keycloak:extensions && docker compose -f infra/docker/docker-compose.dev.yml up -d --wait postgres redis minio redpanda freeswitch keycloak mailpit && docker compose -f infra/docker/docker-compose.dev.yml run --rm --no-deps minio-init && docker compose -f infra/docker/docker-compose.dev.yml run --rm --no-deps redpanda-init",
    "infra:identity:link": "node scripts/link-keycloak-dev-identity.mjs",
    "infra:identity:native-check": "node scripts/keycloak-dev-readiness.mjs",
    "infra:identity:fallback-check": "node scripts/link-keycloak-dev-identity.mjs --fallback-only && node scripts/keycloak-dev-readiness.mjs --fallback-only",
    "infra:identity:check": "node scripts/keycloak-dev-readiness.mjs --auto-fallback",
    "infra:keycloak:extensions": "bash scripts/keycloak-extensions-build.sh",
    "infra:identity:locale": "node scripts/keycloak-locale-setup.mjs",
    "infra:identity:platform": "node scripts/keycloak-platform-setup.mjs && node scripts/keycloak-provisioning-setup.mjs",
    "infra:bootstrap": "pnpm db:migrate && pnpm db:rls && pnpm db:seed && pnpm infra:identity:link && pnpm infra:identity:platform",
    "infra:check": "node scripts/dev-infra-readiness.mjs && pnpm infra:identity:check",
    "infra:ready": "node scripts/phase-zero-readiness.mjs",
    "test:d1-i18n": "node --test scripts/keycloak-locale-setup.test.mjs && pnpm --filter @d-contact/i18n test && pnpm --filter @d-contact/console i18n:check && pnpm --filter @d-contact/workspace i18n:check && node packages/i18n/scripts/check-catalogs.mjs packages/ui-react/src/locales packages/ui-react/preview/locales",
    "test:readiness": "node --test scripts/phase-zero-readiness.test.mjs scripts/prisma-platform-targets.test.mjs scripts/pnpm-platform-targets.test.mjs",
    "test:phase-one-readiness": "node --test scripts/phase-one-readiness.test.mjs scripts/phase-one-tenants.test.mjs scripts/child-process-lifecycle.test.mjs",
    "voice:demo": "node scripts/inbound-voice-demo.mjs",
    "voice:ivr:demo": "INBOUND_DEMO_DTMF=2 node scripts/inbound-voice-demo.mjs",
    "voice:acceptance": "node scripts/phase-one-readiness.mjs",
    "voice:phase2:acceptance": "node scripts/phase-two-readiness.mjs",
    "cxa:phase1:acceptance": "node scripts/cxa-phase-one-readiness.mjs",
    "test:cxa-phase-one-readiness": "node --test scripts/cxa-phase-one-readiness.test.mjs scripts/cxa-schema-readiness.test.mjs",
    "cxa:e0:acceptance": "node scripts/cxa-e0-readiness.mjs",
    "test:cxa-e0-readiness": "node --test scripts/cxa-e0-readiness.test.mjs",
    "cxa:c1:acceptance": "node scripts/cxa-c1-readiness.mjs",
    "test:cxa-c1-readiness": "node --test scripts/cxa-c1-readiness.test.mjs",
    "s1:acceptance": "node scripts/s1-readiness.mjs",
    "test:s1-readiness": "node --test scripts/s1-readiness.test.mjs",
    "cxa:j2:acceptance": "node scripts/cxa-j2-readiness.mjs",
    "test:integration:j2:fast": "pnpm --parallel --filter @d-contact/journey --filter @d-contact/dialer --filter @d-contact/cases --filter @d-contact/api exec sh -c 'tsx --test --test-concurrency=4 src/*.integration.ts'",
    "test:cxa-j2-readiness": "node --test scripts/cxa-j2-readiness.test.mjs",
    "cxa:j3:schema": "node scripts/cxa-j3-schema-readiness.mjs",
    "test:cxa-j3-schema-readiness": "node --test scripts/cxa-j3-schema-readiness.test.mjs",
    "cxa:j3:focused": "node scripts/cxa-j3-focused-readiness.mjs",
    "cxa:j3:acceptance": "node scripts/cxa-j3-readiness.mjs",
    "test:cxa-j3-readiness": "node --test scripts/cxa-j3-readiness.test.mjs scripts/cxa-j3-focused-readiness.test.mjs",
    "cxa:cg4:acceptance": "node scripts/cxa-cg4-readiness.mjs",
    "test:cxa-cg4-readiness": "node --test scripts/cxa-cg4-readiness.test.mjs",
    "cxa:j5:schema": "node scripts/cxa-j5-schema-readiness.mjs",
    "test:cxa-j5-schema-readiness": "node --test scripts/cxa-j5-schema-readiness.test.mjs",
    "cxa:s2:schema": "node scripts/cxa-s2-schema-readiness.mjs",
    "test:cxa-s2-schema-readiness": "node --test scripts/cxa-s2-schema-readiness.test.mjs",
    "cxa:s2:focused": "node scripts/cxa-s2-readiness.mjs --focused",
    "cxa:s2:acceptance": "node scripts/cxa-s2-readiness.mjs",
    "cxa:s2:provider-bundle": "node scripts/cxa-s2-provider-bundle.mjs",
    "test:cxa-s2-readiness": "node --test scripts/cxa-s2-readiness.test.mjs",
    "a1:schema": "node scripts/a1-schema-readiness.mjs",
    "test:a1-schema-readiness": "node --test scripts/a1-schema-readiness.test.mjs",
    "a1:auth:boundary": "pnpm --filter @d-contact/platform-api test:boundary",
    "a1:provisioning:boundary": "pnpm --filter @d-contact/platform-control test:boundary",
    "d1:shell-flag": "pnpm --filter @d-contact/platform-control build && pnpm --filter @d-contact/platform-control ui-flag",
    "a1:dev-catalog": "pnpm --filter @d-contact/platform-control dev-catalog",
    "a1:console:uat": "pnpm --filter @d-contact/platform-console test:uat",
    "a1:acceptance": "node scripts/a1-acceptance.mjs --profile fast",
    "a1:acceptance:boundary": "node scripts/a1-acceptance.mjs --profile real-boundary",
    "test:a1-acceptance": "node --test scripts/a1-acceptance.test.mjs scripts/a1-rc-bundle.test.mjs",
    "a1:uat:gate": "node scripts/a1-rc-bundle.mjs gate",
    "a1:alerts:test": "docker run --rm -v \"$PWD/infra/observability/prometheus:/rules:ro\" --entrypoint promtool prom/prometheus:v2.54.1 test rules /rules/platform-provisioning.rules.test.yml",
    "cxa:j5:focused": "node scripts/cxa-j5-readiness.mjs --focused",
    "cxa:j5:acceptance": "node scripts/cxa-j5-readiness.mjs",
    "test:cxa-j5-readiness": "node --test scripts/cxa-j5-readiness.test.mjs",
    "test:j5:focused": "pnpm cxa:j5:focused",
    "test:j5:full": "pnpm cxa:j5:acceptance",
    "test:j5:acceptance": "pnpm cxa:j5:acceptance",
    "cxa:cg5:acceptance": "node scripts/cxa-cg5-readiness.mjs",
    "test:cxa-cg5-readiness": "node --test scripts/cxa-cg5-readiness.test.mjs",
    "infra:console": "docker compose -f infra/docker/docker-compose.dev.yml --profile tools up -d redpanda-console",
    "infra:down": "docker compose -f infra/docker/docker-compose.dev.yml down"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.0",
    "typescript": "^5.5.4"
  }
}
