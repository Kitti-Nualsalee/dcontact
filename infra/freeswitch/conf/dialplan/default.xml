<include>
  <context name="default">

    <!-- Phase 1: สายเข้า DID 2000 ถูก park ให้ Router เลือก agent ผ่าน Kafka ก่อน bridge -->
    <extension name="dcontact-inbound-voice">
      <condition field="destination_number" expression="^2000$">
        <action application="set" data="domain_name=$${domain}"/>
        <action application="park"/>
      </condition>
    </extension>

    <!-- 9196: echo test — ใช้ตรวจว่า media path ทำงาน (ได้ยินเสียงตัวเองสะท้อนกลับ) -->
    <extension name="echo-test">
      <condition field="destination_number" expression="^9196$">
        <action application="answer"/>
        <action application="echo"/>
      </condition>
    </extension>

    <!-- โทรหากันระหว่าง extension 1000-1999 (spike Phase 0)
         Phase 1: inbound จาก trunk จะ park แล้วให้ router ตัดสินใจผ่าน ESL แทน -->
    <extension name="local-extensions">
      <condition field="destination_number" expression="^(1[0-9]{3})$">
        <action application="export" data="dialed_extension=$1"/>
        <action application="set" data="ringback=$${us-ring}"/>
        <action application="set" data="hangup_after_bridge=true"/>
        <action application="bridge" data="user/${dialed_extension}@$${domain}"/>
      </condition>
    </extension>

  </context>
</include>
