<include>
  <context name="default">

    <!-- Phase 1: inbound calls to DID 2000 (direct queue) or 2001 (IVR) are parked for the Router to decide via Kafka -->
    <extension name="dcontact-inbound-voice">
      <condition field="destination_number" expression="^200[01]$">
        <action application="set" data="domain_name=$${domain}"/>
        <action application="park"/>
      </condition>
    </extension>

    <!-- 9196: echo test — checks that the media path works (you hear your own voice echoed back) -->
    <extension name="echo-test">
      <condition field="destination_number" expression="^9196$">
        <action application="answer"/>
        <action application="echo"/>
      </condition>
    </extension>

    <!-- An agent extension must not dial external numbers itself; outbound must go through the Delivery Gate + ESL only -->
    <extension name="deny-agent-direct-outbound">
      <condition field="caller_id_number" expression="^1[0-9]{3}$"/>
      <condition field="destination_number" expression="^(?!1[0-9]{3}$|200[01]$|9196$).+$">
        <action application="hangup" data="CALL_REJECTED"/>
      </condition>
    </extension>

    <!-- Calls between extensions 1000-1999 (Phase 0 spike)
         Phase 1: inbound from a trunk will be parked and the router decides via ESL instead -->
    <extension name="local-extensions">
      <condition field="destination_number" expression="^(1[0-9]{3})$">
        <action application="export" data="dialed_extension=$1"/>
        <action application="set" data="ringback=$${us-ring}"/>
        <action application="set" data="hangup_after_bridge=true"/>
        <action application="bridge" data="user/${dialed_extension}@$${domain}"/>
      </condition>
    </extension>

  </context>
</include>
