<include>
  <!-- #562: context of trunk `pstn-sim` — customer calls may reach only DID 2000 (direct queue) and 2001 (IVR)
       which are parked for the Router to decide via Kafka like the default context; bridging to an agent extension is forbidden -->
  <context name="pstn">
    <!-- ADR-038: a call that passed Kamailio carries X-DContact-Domain = the SIP domain of the tenant that Kamailio identified from the trunk/number
         Kamailio strips this header from outside before setting it itself, and this profile must accept only the Kamailio IP in a real deployment
         remove the header from the variables before parking so it does not follow the bridge leg to the agent
         #977: a call whose tenant Kamailio identified accepts numbers 2000–2009 so a tenant can have a managed queue number (e.g. 2002)
         separate from the legacy queue. Kamailio controls which numbers may come in from the number table, while calls without the header still accept only 2000/2001 -->
    <extension name="dcontact-inbound-voice-edge">
      <condition field="${sip_h_X-DContact-Domain}" expression="^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$"/>
      <condition field="destination_number" expression="^200[0-9]$">
        <action application="set" data="domain_name=${sip_h_X-DContact-Domain}"/>
        <action application="unset" data="sip_h_X-DContact-Domain"/>
        <action application="park"/>
      </condition>
    </extension>
    <extension name="dcontact-inbound-voice">
      <condition field="destination_number" expression="^200[01]$">
        <action application="set" data="domain_name=$${domain}"/>
        <action application="park"/>
      </condition>
    </extension>
  </context>
</include>
