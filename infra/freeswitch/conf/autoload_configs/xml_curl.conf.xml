<configuration name="xml_curl.conf" description="D-Contact active work-session SIP directory">
  <bindings>
    <binding name="dcontact-agent-directory">
      <!-- Dev stack เท่านั้น; production สร้าง URL/credential ต่อ telephony node จาก secret store -->
      <param name="gateway-url"
             value="http://host.docker.internal:3000/internal/v1/freeswitch/directory"
             bindings="directory"/>
      <param name="gateway-credentials" value="fs-local:dcontact-xml-curl-dev-only"/>
      <param name="auth-scheme" value="basic"/>
      <param name="timeout" value="3"/>
      <param name="response-max-bytes" value="16384"/>
    </binding>
  </bindings>
</configuration>
