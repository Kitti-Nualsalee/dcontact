<configuration name="acl.conf" description="Network Lists">
  <network-lists>
    <list name="localnet.auto" default="allow"/>
    <!-- D1.16 (#455): networks treated as local for media (profile internal `local-network-acl`)
         FreeSWITCH uses ext-rtp-ip (127.0.0.1) for peers that are not in this list — a browser on the host machine
         arrives through the docker network gateway (172.x.0.1), so it gets the published ICE candidate 127.0.0.1
         while SIPp/other containers on the same network keep talking media over internal IPs as before -->
    <list name="dcontact_media_local" default="deny">
      <node type="deny" cidr="172.16.0.1/32"/>
      <node type="deny" cidr="172.17.0.1/32"/>
      <node type="deny" cidr="172.18.0.1/32"/>
      <node type="deny" cidr="172.19.0.1/32"/>
      <node type="deny" cidr="172.20.0.1/32"/>
      <node type="deny" cidr="172.21.0.1/32"/>
      <node type="deny" cidr="172.22.0.1/32"/>
      <node type="deny" cidr="172.23.0.1/32"/>
      <node type="deny" cidr="172.24.0.1/32"/>
      <node type="deny" cidr="172.25.0.1/32"/>
      <node type="deny" cidr="172.26.0.1/32"/>
      <node type="deny" cidr="172.27.0.1/32"/>
      <node type="deny" cidr="172.28.0.1/32"/>
      <node type="deny" cidr="172.29.0.1/32"/>
      <node type="deny" cidr="172.30.0.1/32"/>
      <node type="deny" cidr="172.31.0.1/32"/>
      <node type="allow" cidr="10.0.0.0/8"/>
      <node type="allow" cidr="172.16.0.0/12"/>
      <node type="allow" cidr="192.168.0.0/16"/>
    </list>
    <!-- D1.16 (#455): browser ICE candidates that are accepted (profile internal `apply-candidate-acl`)
         the FreeSWITCH default is wan.auto, which drops all internal candidates (192.168.x / 10.x / 127.x)
         a browser on dev only has internal candidates, so WebRTC calls fail with INCOMPATIBLE_DESTINATION
         DEV ONLY: production must restrict by the real network + TURN -->
    <list name="dcontact_webrtc_candidates" default="deny">
      <node type="allow" cidr="10.0.0.0/8"/>
      <node type="allow" cidr="127.0.0.0/8"/>
      <node type="allow" cidr="172.16.0.0/12"/>
      <node type="allow" cidr="192.168.0.0/16"/>
    </list>
    <!-- #562: IPs that profile `pstn-sim` (5080) accepts calls from without a challenge — containers in the dev/CI docker network
         reject the docker gateway (172.x.0.1) so the host machine cannot send calls in without authentication
         DEV ONLY: production sets an ACL per carrier by real IP -->
    <list name="dcontact_pstn_sim" default="deny">
      <node type="deny" cidr="172.16.0.1/32"/>
      <node type="deny" cidr="172.17.0.1/32"/>
      <node type="deny" cidr="172.18.0.1/32"/>
      <node type="deny" cidr="172.19.0.1/32"/>
      <node type="deny" cidr="172.20.0.1/32"/>
      <node type="deny" cidr="172.21.0.1/32"/>
      <node type="deny" cidr="172.22.0.1/32"/>
      <node type="deny" cidr="172.23.0.1/32"/>
      <node type="deny" cidr="172.24.0.1/32"/>
      <node type="deny" cidr="172.25.0.1/32"/>
      <node type="deny" cidr="172.26.0.1/32"/>
      <node type="deny" cidr="172.27.0.1/32"/>
      <node type="deny" cidr="172.28.0.1/32"/>
      <node type="deny" cidr="172.29.0.1/32"/>
      <node type="deny" cidr="172.30.0.1/32"/>
      <node type="deny" cidr="172.31.0.1/32"/>
      <node type="allow" cidr="172.16.0.0/12"/>
    </list>
    <!-- DEV ONLY: allow ESL from anywhere (the host arrives through the docker bridge)
         Production: restrict to the subnet of the backend services -->
    <list name="esl_allow" default="allow"/>
  </network-lists>
</configuration>
