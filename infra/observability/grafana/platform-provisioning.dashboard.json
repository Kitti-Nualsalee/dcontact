{
  "title": "D-Contact Platform Provisioning",
  "uid": "dcontact-platform-provisioning",
  "schemaVersion": 39,
  "tags": ["dcontact", "a1"],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Backlog ตามสถานะ",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (dcontact_platform_requests)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "อายุคิวที่เก่าที่สุด (วินาที)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (queue) (dcontact_platform_oldest_age_seconds)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Invariant violations (ต้องเป็น 0)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (invariant) (dcontact_platform_invariant_violations)"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "เวลา end-to-end p50/p95",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "B",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(dcontact_platform_provisioning_duration_seconds_bucket[1h])))"
        },
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(dcontact_platform_provisioning_duration_seconds_bucket[1h])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "เวลาต่อหน่วยงานของ worker p95",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, source, kind) (rate(dcontact_platform_worker_unit_duration_seconds_bucket[15m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Step failures / retry",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (step, code) (increase(dcontact_platform_worker_results_total{source=\"saga\",kind=~\"ACTION_REQUIRED|RETRY_SCHEDULED|LEASE_LOST\"}[15m]))"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Recovery / command outcomes",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind, code) (increase(dcontact_platform_worker_results_total{source=\"command\"}[15m]))"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Invitation delivery",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (dcontact_platform_invitations)"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Audit / security events ของ Platform API",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (decision, reason) (increase(dcontact_platform_api_auth_decisions_total[15m]))"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Worker รับงาน (rollout)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(dcontact_platform_worker_claims_enabled)"
        }
      ]
    }
  ]
}
