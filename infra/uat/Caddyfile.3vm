# #537 / ADR-030: TLS จบที่ nginx VM1; Caddy รับ HTTP จาก VM1 เท่านั้น
{
	admin off
	persist_config off
	auto_https off
	servers {
		trusted_proxies static 192.168.102.114/32
		client_ip_headers X-Forwarded-For
	}
}

:8080 {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# ADR033: ใช้ framing policy ของ Keycloak เฉพาะ protocol iframe นี้
	@frameProtected not path /auth/realms/dcontact/dc-account/login-status-iframe.html
	header @frameProtected >X-Frame-Options DENY

	route {
		@notEdge not remote_ip 192.168.102.114/32
		respond @notEdge 403
		@outside not client_ip {$UAT_ALLOWED_CIDRS}
		respond @outside 403

		@keycloakAdmin path /auth/admin /auth/admin/* /auth/realms/master /auth/realms/master/* /auth/metrics /auth/health /auth/health/*
		respond @keycloakAdmin 404

		handle /auth/* {
			reverse_proxy keycloak:8080 {
				# TLS terminates on VM1 nginx. Preserve the original scheme so
				# Keycloak issues Secure session cookies for browser sign-in.
				header_up X-Forwarded-Proto https
			}
		}
		# #868: admission fence ของ People — มีไฟล์ people-mutations ใน directory ที่ mount แบบอ่านอย่างเดียว
		# = ปฏิเสธคำขอแก้ไข People ใหม่ก่อนถึง API ทุกรุ่น; GET และ worker ใน API ยังทำงานต่อ
		# ตอบ code เดียวกับ API เมื่อยังไม่รับงาน เพื่อให้ Console ทุกรุ่นรู้ว่าคำขอไม่ถูกรับ
		@peopleAdmissionFence {
			not method GET HEAD OPTIONS
			path_regexp (?i)^/api/+v1/+tenant-voice/+people(/|$)
			file {
				root /run/dcontact-admission-fence
				try_files /people-mutations
			}
		}
		header @peopleAdmissionFence {
			Content-Type application/json
			Cache-Control no-store
			Retry-After 300
			X-DContact-Admission-Fence people
		}
		respond @peopleAdmissionFence `{"code":"CAPABILITY_NOT_READY","reason":"ADMISSION_FENCED"}` 503
		handle /api/* {
			reverse_proxy api:3000
		}
		handle /dphone/* {
			header -X-Frame-Options
			reverse_proxy api:3000
		}
		handle /embed/* {
			reverse_proxy api:3000
		}
		handle_path /workspace/* {
			root * /srv/workspace
			file_server
		}
		handle_path /examples/* {
			root * /srv/examples
			file_server
		}
		handle {
			root * /srv/console
			try_files {path} /index.html
			file_server
		}
	}
}
