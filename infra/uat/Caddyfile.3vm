# #537 / ADR-030: TLS จบที่ nginx VM1; Caddy รับ HTTP จาก VM1 เท่านั้น
{
	admin off
	persist_config off
	auto_https off
	servers {
		trusted_proxies static 192.168.102.114/32
		client_ip_headers X-Forwarded-For
	}
}

:8080 {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}

	route {
		@notEdge not remote_ip 192.168.102.114/32
		respond @notEdge 403
		@outside not client_ip {$UAT_ALLOWED_CIDRS}
		respond @outside 403

		@keycloakAdmin path /auth/admin /auth/admin/* /auth/realms/master /auth/realms/master/* /auth/metrics /auth/health /auth/health/*
		respond @keycloakAdmin 404

		handle /auth/* {
			reverse_proxy keycloak:8080
		}
		handle /api/* {
			reverse_proxy api:3000
		}
		handle {
			root * /srv/console
			try_files {path} /index.html
			file_server
		}
	}
}
