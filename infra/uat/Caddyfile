# U1.6 (#434): reverse proxy ของ UAT first slice — จุดเดียวที่เปิดพอร์ตสู่ host
#
# - Console (static) และ API อยู่ origin เดียว: `/api/v1/*` → api (UAT profile)
# - `/auth/*` → Keycloak (production mode, http ภายใน network ของ compose เท่านั้น)
# - admin console/REST ของ Keycloak และ realm master ไม่เปิดผ่าน proxy (ตอบ 404)
# - เข้าได้เฉพาะ CIDR ของ identity-aware gateway/allowlist (`UAT_ALLOWED_CIDRS`, provisioning gate)
# - TLS จากไฟล์ cert/key ที่ operator วางบน VM (ไม่มี ACME อัตโนมัติ; แหล่ง cert เป็น provisioning gate)
#
# ค่า `{$VAR}` มาจาก env ของ container (docker-compose.uat.yml บังคับ `:?` ทุกตัว)
{
	admin off
	persist_config off
	http_port 8080
	https_port 8443
	# cert มาจากไฟล์เท่านั้น — ไม่ขอ ACME; ไม่ตั้ง trusted_proxies จึงไม่เชื่อ X-Forwarded-* จากภายนอก
	auto_https off
}

http://{$UAT_HOST} {
	redir https://{$UAT_HOST}{uri} permanent
}

https://{$UAT_HOST} {
	tls /run/secrets/uat_tls_cert /run/secrets/uat_tls_key

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# `route` คงลำดับตามที่เขียน — ไม่งั้น Caddy เรียง `handle` ก่อน `respond` และ allowlist/การปิด admin
	# จะถูกข้ามสำหรับ /auth และ /api (readiness UAT-L05 จับได้)
	# ADR033: ใช้ framing policy ของ Keycloak เฉพาะ protocol iframe นี้
	@frameProtected not path /auth/realms/dcontact/dc-account/login-status-iframe.html
	header @frameProtected >X-Frame-Options DENY

	route {
		@outside not remote_ip {$UAT_ALLOWED_CIDRS}
		respond @outside 403

		# admin console/REST ของ Keycloak และ realm master (บัญชี bootstrap admin) — ภายใน VM เท่านั้น
		@keycloakAdmin path /auth/admin /auth/admin/* /auth/realms/master /auth/realms/master/* /auth/metrics /auth/health /auth/health/*
		respond @keycloakAdmin 404

		handle /auth/* {
			reverse_proxy keycloak:8080 {
				# TLS terminates at Caddy; pass the external scheme to Keycloak so
				# browser session cookies retain the Secure attribute.
				header_up X-Forwarded-Proto https
			}
		}

		# ทั้ง `/api/*` ไปที่ API — route นอก allowlist ของ profile ถูกตอบ 404 ROUTE_NOT_AVAILABLE_IN_PROFILE
		# #868: admission fence ของ People — มีไฟล์ people-mutations ใน directory ที่ mount แบบอ่านอย่างเดียว
		# = ปฏิเสธคำขอแก้ไข People ใหม่ก่อนถึง API ทุกรุ่น; GET และ worker ใน API ยังทำงานต่อ
		# ตอบ code เดียวกับ API เมื่อยังไม่รับงาน เพื่อให้ Console ทุกรุ่นรู้ว่าคำขอไม่ถูกรับ
		@peopleAdmissionFence {
			not method GET HEAD OPTIONS
			path_regexp (?i)^/api/+v1/+tenant-voice/+people(/|$)
			file {
				root /run/dcontact-admission-fence
				try_files /people-mutations
			}
		}
		header @peopleAdmissionFence {
			Content-Type application/json
			Cache-Control no-store
			Retry-After 300
			X-DContact-Admission-Fence people
		}
		respond @peopleAdmissionFence `{"code":"CAPABILITY_NOT_READY","reason":"ADMISSION_FENCED"}` 503
		handle /api/* {
			reverse_proxy api:3000
		}
		handle /dphone/* {
			header -X-Frame-Options
			reverse_proxy api:3000
		}
		handle /embed/* {
			reverse_proxy api:3000
		}
		handle_path /workspace/* {
			root * /srv/workspace
			file_server
		}
		handle_path /examples/* {
			root * /srv/examples
			file_server
		}

		handle {
			root * /srv/console
			try_files {path} /index.html
			file_server
		}
	}
}
