# U1.6 (#434): reverse proxy for the UAT first slice; the only place that opens a port to the host
#
# - Console (static) and API share one origin: `/api/v1/*` → api (UAT profile)
# - `/auth/*` → Keycloak (production mode, plain http inside the compose network only)
# - the Keycloak admin console/REST and the master realm are not exposed through the proxy (answered with 404)
# - reachable only from the CIDRs of the identity-aware gateway/allowlist (`UAT_ALLOWED_CIDRS`, provisioning gate)
# - TLS from cert/key files the operator places on the VM (no automatic ACME; the cert source is a provisioning gate)
#
# `{$VAR}` values come from the container env (docker-compose.uat.yml enforces every one with `:?`)
{
	admin off
	persist_config off
	http_port 8080
	https_port 8443
	# the cert comes from files only; no ACME request; trusted_proxies is not set, so external X-Forwarded-* is not trusted
	auto_https off
}

http://{$UAT_HOST} {
	redir https://{$UAT_HOST}{uri} permanent
}

https://{$UAT_HOST} {
	tls /run/secrets/uat_tls_cert /run/secrets/uat_tls_key

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# `route` keeps the written order; otherwise Caddy sorts `handle` before `respond` and the allowlist/admin lockout
	# would be skipped for /auth and /api (caught by readiness UAT-L05)
	# ADR033: use the Keycloak framing policy for this protocol iframe only
	@frameProtected not path /auth/realms/dcontact/dc-account/login-status-iframe.html
	header @frameProtected >X-Frame-Options DENY

	route {
		@outside not remote_ip {$UAT_ALLOWED_CIDRS}
		respond @outside 403

		# Keycloak admin console/REST and the master realm (bootstrap admin account); inside the VM only
		@keycloakAdmin path /auth/admin /auth/admin/* /auth/realms/master /auth/realms/master/* /auth/metrics /auth/health /auth/health/*
		respond @keycloakAdmin 404

		handle /auth/* {
			reverse_proxy keycloak:8080 {
				# TLS terminates at Caddy; pass the external scheme to Keycloak so
				# browser session cookies retain the Secure attribute.
				header_up X-Forwarded-Proto https
			}
		}

		# all of `/api/*` goes to the API; routes outside the profile allowlist are answered 404 ROUTE_NOT_AVAILABLE_IN_PROFILE
		# #868: People admission fence; a people-mutations file in the read-only mounted directory
		# = reject new People edit requests before they reach any API release; GET and the worker inside the API keep running
		# answers with the same code as the API when it is not accepting work, so every Console release knows the request was not accepted
		@peopleAdmissionFence {
			not method GET HEAD OPTIONS
			path_regexp (?i)^/api/+v1/+tenant-voice/+people(/|$)
			file {
				root /run/dcontact-admission-fence
				try_files /people-mutations
			}
		}
		header @peopleAdmissionFence {
			Content-Type application/json
			Cache-Control no-store
			Retry-After 300
			X-DContact-Admission-Fence people
		}
		respond @peopleAdmissionFence `{"code":"CAPABILITY_NOT_READY","reason":"ADMISSION_FENCED"}` 503
		handle /api/* {
			reverse_proxy api:3000
		}
		handle /dphone/* {
			header -X-Frame-Options
			reverse_proxy api:3000
		}
		handle /embed/* {
			reverse_proxy api:3000
		}
		handle_path /workspace/* {
			root * /srv/workspace
			file_server
		}
		handle_path /examples/* {
			root * /srv/examples
			file_server
		}

		handle {
			root * /srv/console
			try_files {path} /index.html
			file_server
		}
	}
}
