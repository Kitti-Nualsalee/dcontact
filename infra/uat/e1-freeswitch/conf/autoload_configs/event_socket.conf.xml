<configuration name="event_socket.conf" description="E1 sandbox event socket">
  <settings>
    <param name="nat-map" value="false"/>
    <param name="listen-ip" value="0.0.0.0"/>
    <param name="listen-port" value="8021"/>
    <param name="password" value="__E1_ESL_PASSWORD__"/>
    <param name="apply-inbound-acl" value="esl_allow"/>
  </settings>
</configuration>
