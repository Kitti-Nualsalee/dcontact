<include>
  <context name="default">
    <extension name="e1-synthetic-router-inbound">
      <condition field="caller_id_number" expression="^1102$"/>
      <condition field="destination_number" expression="^1101$">
        <action application="set" data="domain_name=$${domain}"/>
        <action application="set" data="park_timeout=30:NORMAL_TEMPORARY_FAILURE"/>
        <action application="park"/>
      </condition>
    </extension>
    <extension name="e1-local-extensions">
      <condition field="destination_number" expression="^(1[0-9]{3})$">
        <action application="export" data="dialed_extension=$1"/>
        <action application="set" data="ringback=$${us-ring}"/>
        <action application="set" data="hangup_after_bridge=true"/>
        <action application="bridge" data="user/${dialed_extension}@$${domain}"/>
      </condition>
    </extension>
    <extension name="e1-deny-external-outbound">
      <condition field="destination_number" expression=".+">
        <action application="hangup" data="CALL_REJECTED"/>
      </condition>
    </extension>
  </context>
</include>
