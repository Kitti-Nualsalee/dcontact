# A1.9 (#574): the Platform origin is separate from the tenant origin; accepts from nginx on VM1 only
{
    admin off
    persist_config off
    auto_https off
    servers {
        trusted_proxies static 192.168.102.114/32
        client_ip_headers X-Forwarded-For
    }
}

:8081 {
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        -Server
    }
    route {
        @notEdge not remote_ip 192.168.102.114/32
        respond @notEdge 403
        @outside not client_ip {$PLATFORM_ALLOWED_CIDRS}
        respond @outside 403

        @private path /auth/* /metrics /health/*
        respond @private 404

        redir /mail /mail/ 308
        handle /mail/* {
            reverse_proxy mailpit:8025
        }
        handle /api/* {
            reverse_proxy platform-api:3010
        }
        # Vite puts a hash in file names under /assets/, so they can be cached long; index.html and SPA routes must revalidate
        # every time, otherwise after an update the browser uses a stale index.html that points at assets that no longer exist (blank page, #901)
        handle /assets/* {
            root * /srv/platform-console
            @hashedAsset file
            header @hashedAsset Cache-Control "public, max-age=31536000, immutable"
            file_server
        }
        handle {
            header Cache-Control "no-cache"
            root * /srv/platform-console
            try_files {path} /index.html
            file_server
        }
    }
}
