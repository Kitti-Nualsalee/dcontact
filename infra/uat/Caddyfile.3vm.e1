# #490: used only by the E1 acceptance overlay; TLS still terminates at nginx on VM1
{
	admin off
	persist_config off
	auto_https off
	servers {
		trusted_proxies static 192.168.102.114/32
		client_ip_headers X-Forwarded-For
	}
}

:8080 {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# ADR033: use the Keycloak framing policy for this protocol iframe only
	@frameProtected not path /auth/realms/dcontact/dc-account/login-status-iframe.html
	header @frameProtected >X-Frame-Options DENY

	route {
		@notEdge not remote_ip 192.168.102.114/32
		respond @notEdge 403
		@outside not client_ip {$UAT_ALLOWED_CIDRS}
		respond @outside 403

		@keycloakAdmin path /auth/admin /auth/admin/* /auth/realms/master /auth/realms/master/* /auth/metrics /auth/health /auth/health/*
		respond @keycloakAdmin 404

		@embedBootstrapAssets path /workspace/embed/dphone-embed.js /workspace/embed/dphone-embed.css
		header @embedBootstrapAssets Cache-Control "no-cache"

		# the browser and FreeSWITCH both use WSS so that Sofia answers Via: SIP/2.0/WSS
		handle /sip-ws {
			reverse_proxy https://freeswitch:7443 {
				# SIP responses must be sent immediately, with no buffering inside the WebSocket tunnel
				flush_interval -1
				transport http {
					tls_insecure_skip_verify
				}
			}
		}
		handle /auth/* {
			reverse_proxy keycloak:8080 {
				# TLS terminates on VM1 nginx. Preserve the original scheme so
				# Keycloak issues Secure session cookies for browser sign-in.
				header_up X-Forwarded-Proto https
			}
		}
		# #868: People admission fence; a people-mutations file in the read-only mounted directory
		# = reject new People edit requests before they reach any API release; GET and the worker inside the API keep running
		# answers with the same code as the API when it is not accepting work, so every Console release knows the request was not accepted
		@peopleAdmissionFence {
			not method GET HEAD OPTIONS
			path_regexp (?i)^/api/+v1/+tenant-voice/+people(/|$)
			file {
				root /run/dcontact-admission-fence
				try_files /people-mutations
			}
		}
		header @peopleAdmissionFence {
			Content-Type application/json
			Cache-Control no-store
			Retry-After 300
			X-DContact-Admission-Fence people
		}
		respond @peopleAdmissionFence `{"code":"CAPABILITY_NOT_READY","reason":"ADMISSION_FENCED"}` 503
		handle /api/* {
			reverse_proxy api:3000
		}
		handle /dphone/* {
			header -X-Frame-Options
			reverse_proxy api:3000
		}
		handle /embed/* {
			reverse_proxy api:3000
		}
		handle_path /workspace/* {
			root * /srv/workspace
			file_server
		}
		handle_path /examples/* {
			root * /srv/examples
			file_server
		}
		@fullWorkspace host {$UAT_WORKSPACE_HOST:workspace-disabled.invalid}
		handle @fullWorkspace {
			root * /srv/workspace
			try_files {path} /index.html
			file_server
		}
		handle {
			root * /srv/console
			try_files {path} /index.html
			file_server
		}
	}
}
