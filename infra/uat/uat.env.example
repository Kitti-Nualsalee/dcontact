# U1.6 (#434): รายชื่อค่าที่ต้องมีใน /opt/dcontact-uat/uat.env บน VM (chmod 600, owner = deploy user)
# ไฟล์นี้มีแต่ชื่อ — ค่าจริงมาจาก secret store/provisioning gate และห้าม commit ลง Git
# ห้ามใช้ค่าร่วมกับ dev หรือ production (stop condition ของ #434)
# รหัสผ่านที่อยู่ใน URL (UAT_APP_DB_PASSWORD, UAT_POSTGRES_PASSWORD) ใช้ได้เฉพาะ [A-Za-z0-9]
# credential ของ object storage (UAT_S3_*) ใช้ได้เฉพาะ [A-Za-z0-9_-] ยาว ≥ 8 (เขียนลง s3.json โดยตรง, #540)

# ── provisioning gate: host/domain/TLS/allowlist ──
UAT_HOST=
UAT_ALLOWED_CIDRS=
UAT_TLS_CERT_FILE=
UAT_TLS_KEY_FILE=

# ── tenant ที่ provision ไว้ล่วงหน้า (UUID/slug จาก tenant bootstrap ของ UAT) ──
UAT_TENANT_ID=
UAT_TENANT_SLUG=
# Alias ของ tenant ที่ operator อนุญาตเข้า UAT Console คั่นด้วย comma (สูงสุด 50 รายการ)
UAT_ADDITIONAL_TENANT_SLUGS=
UAT_TENANT_NAME=
UAT_ORGANIZATION_DOMAIN=

# ── secrets ──
UAT_POSTGRES_USER=
UAT_POSTGRES_PASSWORD=
UAT_APP_DB_PASSWORD=
UAT_KEYCLOAK_DB_PASSWORD=
UAT_KEYCLOAK_ADMIN_USERNAME=
UAT_KEYCLOAK_ADMIN_PASSWORD=
# #540 (ADR-029): object storage (SeaweedFS) — root ใช้ bootstrap/lifecycle เท่านั้น
UAT_S3_ROOT_ACCESS_KEY=
UAT_S3_ROOT_SECRET_KEY=
# U1.5 (#433): user เฉพาะของ API (policy uat-evidence-api) — ต้องต่างจาก root; API บูตไม่ผ่านถ้าไม่มี
UAT_S3_API_ACCESS_KEY=
UAT_S3_API_SECRET_KEY=
# #490: internal-only FreeSWITCH sandbox สำหรับ E1 acceptance เท่านั้น
# ห้ามใช้ค่า dev/production, ห้ามส่งออกผ่าน GitHub/command line และลบหรือ rotate หลัง e1-disable
UAT_E1_FREESWITCH_DIRECTORY_PASSWORD=
UAT_E1_FREESWITCH_ESL_PASSWORD=
UAT_E1_VOICE_COMMAND_SECRET=
UAT_E1_OUTBOUND_VOICE_ENABLED=
# #565 (ADR-031): overlay `uat-line` — ใช้เมื่อมี $UAT_ROOT/line-pilot.enabled เท่านั้น (ค่าเป็น reference ไม่มี secret;
# secret อยู่ใน /opt/dcontact-uat/secrets/line/ จาก operator/vm2-line-secrets.sh); tenant ของ pilot = UAT_TENANT_ID
# UAT_LINE_CHANNEL_ACCOUNT_ID=
# UAT_LINE_DESTINATION=
# UAT_LINE_PAYLOAD_KEY_REF=
# UAT_LINE_SENDER_IDENTITY_ID=
# UAT_LINE_CREDENTIAL_REF_ID=

# ── AC3 (#596): SMTP ของ email บัญชี D-Contact — Keycloak (email เชิญ) ใช้ชุดเดียวกัน ──
# ว่าง SMTP_HOST = Keycloak ส่งเข้า mailpit ภายใน stack และ API ไม่เปิดตัวส่ง
# UAT ใช้ Microsoft 365 direct send (port 25, ไม่มี auth) ซึ่งส่งได้เฉพาะผู้รับในองค์กร
# gate ก่อน production: ต้องตั้ง M365 SMTP relay connector + SPF หรือใช้ SMTP ที่ส่งออกนอกองค์กรได้
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_HELO=
CONSOLE_PUBLIC_URL=

# B7: Workspace People แยก worker/tenant service client; default-off จนผ่าน preflight
UAT_TENANT_PEOPLE_BINDINGS_JSON=
UAT_TENANT_PEOPLE_WORKER_DATABASE_URL=
UAT_TENANT_PEOPLE_SECRET_UAT=
UAT_TENANT_PEOPLE_INVITATIONS_ENABLED=
UAT_TENANT_PEOPLE_DISABLE_ENABLED=
