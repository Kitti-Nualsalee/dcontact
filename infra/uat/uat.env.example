# U1.6 (#434): รายชื่อค่าที่ต้องมีใน /opt/dcontact-uat/uat.env บน VM (chmod 600, owner = deploy user)
# ไฟล์นี้มีแต่ชื่อ — ค่าจริงมาจาก secret store/provisioning gate และห้าม commit ลง Git
# ห้ามใช้ค่าร่วมกับ dev หรือ production (stop condition ของ #434)
# รหัสผ่านที่อยู่ใน URL (UAT_APP_DB_PASSWORD, UAT_POSTGRES_PASSWORD) ใช้ได้เฉพาะ [A-Za-z0-9]
# credential ของ object storage (UAT_S3_*) ใช้ได้เฉพาะ [A-Za-z0-9_-] ยาว ≥ 8 (เขียนลง s3.json โดยตรง, #540)

# ── provisioning gate: host/domain/TLS/allowlist ──
UAT_HOST=
UAT_ALLOWED_CIDRS=
UAT_TLS_CERT_FILE=
UAT_TLS_KEY_FILE=

# ── tenant ที่ provision ไว้ล่วงหน้า (UUID/slug จาก tenant bootstrap ของ UAT) ──
UAT_TENANT_ID=
UAT_TENANT_SLUG=
UAT_TENANT_NAME=
UAT_ORGANIZATION_DOMAIN=

# ── secrets ──
UAT_POSTGRES_USER=
UAT_POSTGRES_PASSWORD=
UAT_APP_DB_PASSWORD=
UAT_KEYCLOAK_DB_PASSWORD=
UAT_KEYCLOAK_ADMIN_USERNAME=
UAT_KEYCLOAK_ADMIN_PASSWORD=
# #540 (ADR-029): object storage (SeaweedFS) — root ใช้ bootstrap/lifecycle/ย้ายข้อมูลเท่านั้น
UAT_S3_ROOT_ACCESS_KEY=
UAT_S3_ROOT_SECRET_KEY=
# U1.5 (#433): user เฉพาะของ API (policy uat-evidence-api) — ต้องต่างจาก root; API บูตไม่ผ่านถ้าไม่มี
UAT_S3_API_ACCESS_KEY=
UAT_S3_API_SECRET_KEY=
# เฉพาะช่วงย้ายข้อมูลจาก MinIO เดิม (#540 runbook) — ค่าเดิมของ root MinIO; ลบออกหลัง #541
# UAT_MINIO_ROOT_USER=
# UAT_MINIO_ROOT_PASSWORD=
# #565 (ADR-031): overlay `uat-line` — ใช้เมื่อมี $UAT_ROOT/line-pilot.enabled เท่านั้น (ค่าเป็น reference ไม่มี secret;
# secret อยู่ใน /opt/dcontact-uat/secrets/line/ จาก operator/vm2-line-secrets.sh); tenant ของ pilot = UAT_TENANT_ID
# UAT_LINE_CHANNEL_ACCOUNT_ID=
# UAT_LINE_DESTINATION=
# UAT_LINE_PAYLOAD_KEY_REF=
# UAT_LINE_SENDER_IDENTITY_ID=
# UAT_LINE_CREDENTIAL_REF_ID=
