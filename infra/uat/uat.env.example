# U1.6 (#434): names of the values that must be in /opt/dcontact-uat/uat.env on the VM (chmod 600, owner = deploy user)
# this file has names only; real values come from the secret store/provisioning gate and must never be committed to Git
# never share values with dev or production (stop condition of #434)
# passwords that appear in a URL (UAT_APP_DB_PASSWORD, UAT_POSTGRES_PASSWORD) may use only [A-Za-z0-9]
# object storage credentials (UAT_S3_*) may use only [A-Za-z0-9_-], length ≥ 8 (written straight into s3.json, #540)

# ── provisioning gate: host/domain/TLS/allowlist ──
UAT_HOST=
UAT_ALLOWED_CIDRS=
UAT_TLS_CERT_FILE=
UAT_TLS_KEY_FILE=

# ── pre-provisioned tenant (UUID/slug from the UAT tenant bootstrap) ──
UAT_TENANT_ID=
UAT_TENANT_SLUG=
# Aliases of tenants the operator allows into the UAT Console, comma-separated (up to 50 entries)
UAT_ADDITIONAL_TENANT_SLUGS=
UAT_TENANT_NAME=
UAT_ORGANIZATION_DOMAIN=

# ── secrets ──
UAT_POSTGRES_USER=
UAT_POSTGRES_PASSWORD=
UAT_APP_DB_PASSWORD=
UAT_KEYCLOAK_DB_PASSWORD=
UAT_KEYCLOAK_ADMIN_USERNAME=
UAT_KEYCLOAK_ADMIN_PASSWORD=
# #540 (ADR-029): object storage (SeaweedFS); the root is used for bootstrap/lifecycle only
UAT_S3_ROOT_ACCESS_KEY=
UAT_S3_ROOT_SECRET_KEY=
# U1.5 (#433): the API's own user (policy uat-evidence-api); must differ from root; the API fails to boot without it
UAT_S3_API_ACCESS_KEY=
UAT_S3_API_SECRET_KEY=
# #490: an internal-only FreeSWITCH sandbox for E1 acceptance only
# never use dev/production values, never export through GitHub/the command line, and delete or rotate after e1-disable
UAT_E1_FREESWITCH_DIRECTORY_PASSWORD=
UAT_E1_FREESWITCH_ESL_PASSWORD=
UAT_E1_VOICE_COMMAND_SECRET=
UAT_E1_OUTBOUND_VOICE_ENABLED=
# #565 (ADR-031): the `uat-line` overlay; used only when $UAT_ROOT/line-pilot.enabled exists (values are references with no secret;
# secrets live in /opt/dcontact-uat/secrets/line/ from operator/vm2-line-secrets.sh); the pilot's tenant = UAT_TENANT_ID
# UAT_LINE_CHANNEL_ACCOUNT_ID=
# UAT_LINE_DESTINATION=
# UAT_LINE_PAYLOAD_KEY_REF=
# UAT_LINE_SENDER_IDENTITY_ID=
# UAT_LINE_CREDENTIAL_REF_ID=

# ── AC3 (#596): SMTP for D-Contact account email; Keycloak (invitation email) uses the same set ──
# empty SMTP_HOST = Keycloak sends into the in-stack mailpit and the API does not enable a sender
# UAT uses Microsoft 365 direct send (port 25, no auth), which can reach only recipients inside the organization
# gate before production: set up an M365 SMTP relay connector + SPF, or use SMTP that can send outside the organization
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_HELO=
CONSOLE_PUBLIC_URL=

# B7: Workspace People separate worker/tenant service client; default-off until it passes preflight
UAT_TENANT_PEOPLE_BINDINGS_JSON=
UAT_TENANT_PEOPLE_WORKER_DATABASE_URL=
UAT_TENANT_PEOPLE_SECRET_UAT=
UAT_TENANT_PEOPLE_INVITATIONS_ENABLED=
UAT_TENANT_PEOPLE_DISABLE_ENABLED=
UAT_TENANT_PEOPLE_ACCOUNT_CHANGES_ENABLED=
