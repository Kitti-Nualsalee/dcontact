# #923: web on the app VM in UAT Solo. TLS ends at nginx on the voice VM, which forwards here over HTTP.
# Only the voice VM IP is accepted; the real client comes from the X-Forwarded-For that nginx sets.
{
	admin off
	persist_config off
	auto_https off
	servers {
		trusted_proxies static {$SOLO_VOICE_IP}/32
		client_ip_headers X-Forwarded-For
	}
}

:8080 {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	route {
		@notVoice not remote_ip {$SOLO_VOICE_IP}/32
		respond @notVoice 403

		# The FreeSWITCH directory (xml_curl) answers only requests coming straight from the voice VM, not through nginx
		@internal path /internal/*
		@internalFromBrowser {
			path /internal/*
			not client_ip {$SOLO_VOICE_IP}/32
		}
		respond @internalFromBrowser 404
		handle @internal {
			reverse_proxy api:3000
		}

		# QM: the media and ASR hosts come before the path routes so they can never reach the API or Console
		# nginx on the voice VM accepts both hosts from the app VM only
		# media: signed URLs of the recordings bucket, forwarded with the original Host (the signature covers it), read-only
		@media host {$SOLO_MEDIA_HOST}
		handle @media {
			@signedRecording {
				method GET HEAD
				path /recordings/*
				query X-Amz-Signature=*
			}
			handle @signedRecording {
				reverse_proxy object-storage:9000
			}
			handle {
				respond 404
			}
		}
		# ASR provider per protocol v1 (the simulator for now): only the protocol paths are open
		@asr host {$SOLO_ASR_HOST}
		handle @asr {
			@asrProtocol path /v1/transcriptions /v1/health
			handle @asrProtocol {
				reverse_proxy qm-asr-simulator:8090
			}
			handle {
				respond 404
			}
		}

		@keycloakAdmin path /auth/admin /auth/admin/* /auth/realms/master /auth/realms/master/* /auth/metrics /auth/health /auth/health/*
		respond @keycloakAdmin 404
		handle /auth/* {
			reverse_proxy keycloak:8080 {
				header_up X-Forwarded-Proto https
			}
		}

		handle /api/* {
			reverse_proxy api:3000
		}
		handle /dphone/* {
			header -X-Frame-Options
			reverse_proxy api:3000
		}
		handle /embed/* {
			reverse_proxy api:3000
		}
		handle_path /workspace/* {
			root * /srv/workspace
			file_server
		}

		@workspace host {$SOLO_WORKSPACE_HOST}
		handle @workspace {
			header Content-Security-Policy "frame-ancestors 'none'"
			root * /srv/workspace
			try_files {path} /index.html
			file_server
		}
		handle {
			root * /srv/console
			try_files {path} /index.html
			file_server
		}
	}
}
