<configuration name="acl.conf" description="Network Lists">
  <network-lists>
    <list name="localnet.auto" default="allow"/>
    <!-- #923 Solo: every machine in the LAN sends media straight to the voice VM, so private ranges count as local -->
    <list name="dcontact_media_local" default="deny">
      <node type="allow" cidr="10.0.0.0/8"/>
      <node type="allow" cidr="172.16.0.0/12"/>
      <node type="allow" cidr="192.168.0.0/16"/>
    </list>
    <!-- browser ICE candidates in the LAN; there is no TURN in Solo -->
    <list name="dcontact_webrtc_candidates" default="deny">
      <node type="allow" cidr="10.0.0.0/8"/>
      <node type="allow" cidr="172.16.0.0/12"/>
      <node type="allow" cidr="192.168.0.0/16"/>
    </list>
    <!-- profile pstn-sim (5080) accepts calls only from Kamailio, which is on the same VM (ADR-038) -->
    <list name="dcontact_pstn_sim" default="deny">
      <node type="allow" cidr="__SOLO_VOICE_IP__/32"/>
    </list>
    <!-- ESL accepts only Telephony on the app VM and fs_cli on the machine itself -->
    <list name="esl_allow" default="deny">
      <node type="allow" cidr="__SOLO_APP_IP__/32"/>
      <node type="allow" cidr="127.0.0.1/32"/>
    </list>
  </network-lists>
</configuration>
