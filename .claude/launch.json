{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mockups",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "mockups/serve.py",
        "8090"
      ],
      "port": 8090
    },
    {
      "name": "ui-tokens",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8095",
        "--directory",
        "packages/ui"
      ],
      "port": 8095
    },
    {
      "name": "ui-react",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@d-contact/ui-react",
        "dev"
      ],
      "port": 5190
    }
  ]
}
