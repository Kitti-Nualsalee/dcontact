{
  "name": "@d-contact/dialer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "tsx --test src/*.test.ts",
    "test:integration": "node scripts/run-integration.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@d-contact/contact-governance": "workspace:*",
    "@d-contact/cxa-contracts": "workspace:*",
    "@d-contact/db": "workspace:*",
    "@d-contact/dialer-composition": "workspace:*",
    "@d-contact/kafka": "workspace:*",
    "@d-contact/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4"
  }
}
