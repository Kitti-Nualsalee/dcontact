{
  "name": "@d-contact/workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "dev": "vite",
    "i18n:check": "dc-i18n-check src/i18n/locales",
    "i18n:literals": "dc-i18n-literals src/workspace-app.tsx src/dphone src/shell",
    "lint:css": "stylelint --config ../../packages/ui-react/.stylelintrc.json \"src/agent-workspace.css\" \"src/dphone/*.css\"",
    "test": "tsx --test src/*.test.ts src/dphone/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@d-contact/i18n": "workspace:*",
    "@d-contact/ui": "workspace:*",
    "@d-contact/ui-react": "workspace:*",
    "i18next": "26.4.2",
    "oidc-client-ts": "3.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.15",
    "react-oidc-context": "3.3.1",
    "sip.js": "0.21.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.63.0",
    "@types/node": "^20.14.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "stylelint": "17.15.0",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4",
    "vite": "6.4.3"
  }
}
