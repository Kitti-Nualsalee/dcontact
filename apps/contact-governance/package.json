{
  "name": "@d-contact/contact-governance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "tsx --test src/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 src/*.integration.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cg4:backfill": "tsx src/cg4-legacy-backfill-main.ts",
    "cg4:rollout": "tsx src/cg4-rollout-main.ts"
  },
  "dependencies": {
    "@d-contact/db": "workspace:*",
    "@d-contact/cxa-contracts": "workspace:*",
    "@d-contact/kafka": "workspace:*",
    "@d-contact/shared": "workspace:*",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4"
  }
}
