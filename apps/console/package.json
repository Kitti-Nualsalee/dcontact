{
  "name": "@d-contact/console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "dev": "vite",
    "i18n:check": "dc-i18n-check src/i18n/locales",
    "i18n:literals": "dc-i18n-literals src/journey-authoring src/shell",
    "lint:css": "stylelint --config ../../packages/ui-react/.stylelintrc.json \"src/journey-authoring/*.css\"",
    "test": "tsx --test src/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@d-contact/i18n": "workspace:*",
    "@d-contact/ui": "workspace:*",
    "@d-contact/ui-react": "workspace:*",
    "i18next": "26.4.2",
    "oidc-client-ts": "3.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.15",
    "react-oidc-context": "3.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@d-contact/cxa-contracts": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "^20.14.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "stylelint": "17.15.0",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4",
    "vite": "6.4.3"
  }
}
