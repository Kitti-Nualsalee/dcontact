{
  "name": "@d-contact/platform-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test src/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 src/*.integration.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:boundary": "tsx --test --test-concurrency=1 src/keycloak-provisioning.boundary.ts src/invitation-stale-generation.boundary.ts",
    "worker": "node dist/platform-worker-main.js",
    "dev-catalog": "node dist/dev-catalog-main.js",
    "ui-flag": "node dist/ui-flag-main.js"
  },
  "dependencies": {
    "@d-contact/db": "workspace:*",
    "@d-contact/shared": "workspace:*"
  },
  "devDependencies": {
    "@d-contact/workspace-session": "workspace:*",
    "@types/node": "^20.14.0",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4"
  }
}
