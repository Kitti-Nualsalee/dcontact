{
  "name": "@d-contact/platform-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test src/*.test.ts",
    "test:boundary": "tsx --test --test-concurrency=1 src/*.boundary.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "test:integration": "tsx --test --test-concurrency=1 src/*.integration.ts"
  },
  "dependencies": {
    "@d-contact/db": "workspace:*",
    "@d-contact/platform-control": "workspace:*",
    "@d-contact/shared": "workspace:*",
    "@d-contact/workspace-session": "workspace:*",
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "jose": "^5.9.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4"
  }
}
