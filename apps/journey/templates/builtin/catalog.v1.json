{
  "catalogVersion": 1,
  "templates": [
    {
      "templateId": "5b0c7a4e-8f1d-4c3a-9b2e-1a7d3c5e9f01",
      "version": 1,
      "name": "payment-reminder",
      "lifecycle": "ACTIVE",
      "publishedAt": "2026-09-22T00:00:00.000Z",
      "content": {
        "templateSchemaVersion": "J5_TEMPLATE_V1",
        "authoringSchemaVersion": "J5_AUTHORING_V1",
        "registryVersion": "J5_PALETTE_V1",
        "requiredCapabilities": [],
        "document": {
          "schemaVersion": "J5_AUTHORING_V1",
          "registryVersion": "J5_PALETTE_V1",
          "trigger": {
            "nodeId": "trigger",
            "type": "EVENT_TRIGGER",
            "config": {
              "eventType": "payment.failed"
            }
          },
          "nodes": [
            {
              "nodeId": "send",
              "type": "SEND",
              "templateNodeKey": "send-reminder",
              "config": {
                "channel": "LINE",
                "contentRef": "placeholder-content"
              }
            },
            {
              "nodeId": "wait",
              "type": "WAIT",
              "templateNodeKey": "wait",
              "config": {
                "waitSeconds": 86400
              }
            },
            {
              "nodeId": "done",
              "type": "EXIT",
              "templateNodeKey": "done",
              "config": {
                "reason": "REMINDED"
              }
            }
          ],
          "edges": [
            {
              "edgeId": "start",
              "source": {
                "nodeId": "trigger",
                "portId": "start"
              },
              "target": {
                "nodeId": "send"
              }
            },
            {
              "edgeId": "send-next",
              "source": {
                "nodeId": "send",
                "portId": "next"
              },
              "target": {
                "nodeId": "wait"
              }
            },
            {
              "edgeId": "wait-next",
              "source": {
                "nodeId": "wait",
                "portId": "next"
              },
              "target": {
                "nodeId": "done"
              }
            }
          ],
          "settings": {
            "name": "payment-reminder",
            "purpose": "SERVICE",
            "senderIdentityId": "placeholder-sender",
            "goal": {
              "kind": "EVENT",
              "eventType": "payment.received"
            },
            "exitRules": [
              {
                "kind": "GOAL"
              }
            ],
            "maxDurationDays": 14
          },
          "layout": {
            "nodes": {
              "trigger": {
                "x": 0,
                "y": 0
              },
              "send": {
                "x": 240,
                "y": 0
              },
              "wait": {
                "x": 480,
                "y": 0
              },
              "done": {
                "x": 720,
                "y": 0
              }
            }
          }
        },
        "parameterSchema": [
          {
            "parameterKey": "triggerEvent",
            "labelKey": "template.param.triggerEvent",
            "type": "CANONICAL_EVENT_TYPE",
            "required": false,
            "default": "payment.failed",
            "bindTargets": [
              {
                "templateNodeKey": "@trigger",
                "pointer": "/config/eventType"
              }
            ]
          },
          {
            "parameterKey": "reminderContent",
            "labelKey": "template.param.reminderContent",
            "type": "OPAQUE_RESOURCE_REF",
            "resourceKind": "CONTENT",
            "required": true,
            "bindTargets": [
              {
                "templateNodeKey": "send-reminder",
                "pointer": "/config/contentRef"
              }
            ]
          },
          {
            "parameterKey": "waitSeconds",
            "labelKey": "template.param.waitSeconds",
            "type": "DURATION_SECONDS",
            "min": 3600,
            "max": 1209600,
            "required": false,
            "default": 86400,
            "bindTargets": [
              {
                "templateNodeKey": "wait",
                "pointer": "/config/waitSeconds"
              }
            ]
          },
          {
            "parameterKey": "senderIdentity",
            "labelKey": "template.param.senderIdentity",
            "type": "OPAQUE_RESOURCE_REF",
            "resourceKind": "SENDER_IDENTITY",
            "required": true,
            "bindTargets": [
              {
                "templateNodeKey": "@settings",
                "pointer": "/config/senderIdentityId"
              }
            ]
          }
        ]
      }
    },
    {
      "templateId": "5b0c7a4e-8f1d-4c3a-9b2e-1a7d3c5e9f02",
      "version": 1,
      "name": "abandoned-call-case",
