              "edgeId": "start",
              "source": {
                "nodeId": "trigger",
                "portId": "start"
              },
              "target": {
                "nodeId": "case"
              }
            },
            {
              "edgeId": "accepted",
              "source": {
                "nodeId": "case",
                "portId": "accepted"
              },
              "target": {
                "nodeId": "ok"
              }
            },
            {
              "edgeId": "rejected",
              "source": {
                "nodeId": "case",
                "portId": "rejected"
              },
              "target": {
                "nodeId": "no"
              }
            }
          ],
          "settings": {
            "name": "abandoned-call-case",
            "purpose": "SERVICE",
            "senderIdentityId": "placeholder-sender",
            "goal": {
              "kind": "EVENT",
              "eventType": "case.resolved"
            },
            "exitRules": [
              {
                "kind": "GOAL"
              }
            ],
            "maxDurationDays": 14
          },
          "layout": {
            "nodes": {
              "trigger": {
                "x": 0,
                "y": 0
              },
              "case": {
                "x": 240,
                "y": 0
              },
              "ok": {
                "x": 480,
                "y": 0
              },
              "no": {
                "x": 720,
                "y": 0
              }
            }
          }
        },
        "parameterSchema": [
          {
            "parameterKey": "caseType",
            "labelKey": "template.param.caseType",
            "type": "OPAQUE_RESOURCE_REF",
            "resourceKind": "CASE_TYPE",
            "required": true,
            "bindTargets": [
              {
                "templateNodeKey": "ensure-case",
                "pointer": "/config/caseTypeId"
              }
            ]
          },
          {
            "parameterKey": "routingIntent",
            "labelKey": "template.param.routingIntent",
            "type": "OPAQUE_RESOURCE_REF",
            "resourceKind": "ROUTING_INTENT",
            "required": true,
            "bindTargets": [
              {
                "templateNodeKey": "ensure-case",
                "pointer": "/config/routingIntentRef"
              }
            ]
          },
          {
            "parameterKey": "targetTeam",
            "labelKey": "template.param.targetTeam",
            "type": "OPAQUE_RESOURCE_REF",
            "resourceKind": "TARGET_TEAM",
            "required": true,
            "bindTargets": [
              {
                "templateNodeKey": "ensure-case",
                "pointer": "/config/targetOwnerTeamId"
              }
            ]
          },
          {
            "parameterKey": "senderIdentity",
            "labelKey": "template.param.senderIdentity",
            "type": "OPAQUE_RESOURCE_REF",
            "resourceKind": "SENDER_IDENTITY",
            "required": true,
            "bindTargets": [
              {
                "templateNodeKey": "@settings",
                "pointer": "/config/senderIdentityId"
              }
            ]
          }
        ]
      }
    }
