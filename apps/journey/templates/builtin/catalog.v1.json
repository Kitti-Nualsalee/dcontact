        "authoringSchemaVersion": "J5_AUTHORING_V1",
        "registryVersion": "J5_PALETTE_V1",
        "requiredCapabilities": ["OWNER_RESULT_CURSOR_CONTINUATION"],
        "document": {
          "schemaVersion": "J5_AUTHORING_V1",
