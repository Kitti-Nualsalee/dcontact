{
  "name": "@d-contact/router",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/main.ts",
    "demo:wrapup": "tsx src/demo-complete-wrapup.ts",
    "test": "tsx --test --test-concurrency=1 src/*.integration.ts",
    "test:integration": "tsx --test --test-concurrency=1 src/*.integration.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@d-contact/db": "workspace:*",
    "@d-contact/kafka": "workspace:*",
    "@d-contact/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4"
  }
}
