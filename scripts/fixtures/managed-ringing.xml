<?xml version="1.0"?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">
<scenario name="managed unanswered agent observes CANCEL">
  <recv request="INVITE"><action>
    <ereg regexp="[0-9]+" search_in="hdr" header="CSeq:" assign_to="1"/>
  </action></recv>
  <send><![CDATA[
SIP/2.0 180 Ringing
[last_Via:]
[last_From:]
[last_To:];tag=managed-[call_number]
[last_Call-ID:]
[last_CSeq:]
Contact: <sip:agent@[local_ip]:[local_port]>
Content-Length: 0

]]></send>
  <recv request="CANCEL" timeout="150000"/>
  <send><![CDATA[
SIP/2.0 200 OK
[last_Via:]
[last_From:]
[last_To:]
[last_Call-ID:]
[last_CSeq:]
Content-Length: 0

]]></send>
  <send><![CDATA[
SIP/2.0 487 Request Terminated
[last_Via:]
[last_From:]
[last_To:];tag=managed-[call_number]
[last_Call-ID:]
CSeq: [$1] INVITE
Content-Length: 0

]]></send>
  <recv request="ACK"/>
</scenario>
