<document type="freeswitch/xml">
  <section name="configuration">
    <configuration name="modules.conf"><modules>
      <load module="mod_console"/><load module="mod_event_socket"/>
      <load module="mod_sofia"/><load module="mod_commands"/>
      <load module="mod_dptools"/><load module="mod_dialplan_xml"/>
    </modules></configuration>
    <configuration name="switch.conf"><settings>
      <param name="max-sessions" value="20"/><param name="sessions-per-second" value="20"/>
      <param name="rtp-start-port" value="18000"/><param name="rtp-end-port" value="18040"/>
    </settings></configuration>
    <configuration name="acl.conf"><network-lists>
      <list name="acceptance" default="allow"/>
    </network-lists></configuration>
    <configuration name="event_socket.conf"><settings>
      <param name="listen-ip" value="0.0.0.0"/><param name="listen-port" value="8021"/>
      <param name="password" value="managed-local-only"/>
      <param name="apply-inbound-acl" value="acceptance"/><param name="nat-map" value="false"/>
    </settings></configuration>
    <configuration name="sofia.conf"><profiles><profile name="managed"><settings>
      <param name="sip-ip" value="$${local_ip_v4}"/><param name="rtp-ip" value="$${local_ip_v4}"/>
      <param name="sip-port" value="5060"/><param name="context" value="managed"/>
      <param name="dialplan" value="XML"/><param name="auth-calls" value="false"/>
      <param name="inbound-codec-prefs" value="PCMU"/><param name="outbound-codec-prefs" value="PCMU"/>
      <param name="rtp-timeout-sec" value="180"/><param name="manage-presence" value="false"/>
    </settings></profile></profiles></configuration>
  </section>
  <section name="dialplan"><context name="managed"><extension name="caller">
    <condition field="destination_number" expression="^200[0-9]$">
      <action application="answer"/><action application="park"/>
    </condition>
  </extension></context></section>
  <section name="directory"><domain name="managed.test"><groups><group name="default"><users>
    <user id="1001"><params><param name="dial-string" value="sofia/managed/1001@agent1:5060"/></params></user>
    <user id="1002"><params><param name="dial-string" value="sofia/managed/1002@agent2:5060"/></params></user>
    <user id="1003"><params><param name="dial-string" value="sofia/managed/1003@agent3:5060"/></params></user>
  </users></group></groups></domain></section>
</document>
